/* ───────────────────────── LOGIN ATTEMPT LOCK ─────────────────────────
   No IP blocking. Lock is email/browser based only:
   5 wrong passwords => locked for 5 minutes, then user can try again.
────────────────────────────────────────────────────────────────────── */
const MAX_LOGIN_ATTEMPTS = 5;
const LOGIN_LOCK_TIME = 5 * 60 * 1000;

function getLoginLockKey(email) {
  return `login_lock_${norm(email)}`;
}

function getLoginLock(email) {
  try {
    return JSON.parse(localStorage.getItem(getLoginLockKey(email)) || "{}");
  } catch {
    return {};
  }
}

function setLoginLock(email, data) {
  try {
    localStorage.setItem(getLoginLockKey(email), JSON.stringify(data));
  } catch (_) {}
}

function clearLoginLock(email) {
  try {
    localStorage.removeItem(getLoginLockKey(email));
  } catch (_) {}
}

function isLoginLocked(email) {
  const lock = getLoginLock(email);

  if (!lock.lockedUntil) return false;

  if (Date.now() >= Number(lock.lockedUntil)) {
    clearLoginLock(email);
    return false;
  }

  return true;
}

function getRemainingLockMinutes(email) {
  const lock = getLoginLock(email);
  const remaining = Number(lock.lockedUntil || 0) - Date.now();
  return Math.max(1, Math.ceil(remaining / 60000));
}

function recordWrongLoginAttempt(email) {
  const lock = getLoginLock(email);
  const attempts = Number(lock.attempts || 0) + 1;

  if (attempts >= MAX_LOGIN_ATTEMPTS) {
    setLoginLock(email, {
      attempts: MAX_LOGIN_ATTEMPTS,
      lockedUntil: Date.now() + LOGIN_LOCK_TIME,
    });

    return {
      attempts: MAX_LOGIN_ATTEMPTS,
      locked: true,
    };
  }

  setLoginLock(email, { attempts });

  return {
    attempts,
    locked: false,
  };
}

function pwStr(p) {
  if (!p) return 0;
  let s = 0;
  if (p.length >= 6) s++;
  if (p.length >= 10) s++;
  if (/[A-Z]/.test(p) || /[0-9]/.test(p) || /[^a-zA-Z0-9]/.test(p)) s++;
  return s;
}
const PW_LBL = ["", "Weak", "Medium", "Strong"];
const PW_CLS = ["", "w", "m", "s"];

function PwBar({ pw }) {
  const s = pwStr(pw);
  if (!pw) return null;
  return (
    <>
      <div className="lpw">
        {[0, 1, 2].map(i => <div key={i} className={`lpw-s ${i < s ? PW_CLS[s] : ""}`} />)}
      </div>
      <div className="lpw-l">{PW_LBL[s]}</div>
    </>
  );
}

function Steps({ vals }) {
  return (
    <div className="lsteps">
      {vals.map((v, i) => <div key={i} className={`lstep ${v ? "on" : ""}`} />)}
    </div>
  );
}

function saveSession(user, token = "") {
  const finalToken =
    token ||
    user?.token ||
    user?.accessToken ||
    user?.jwt ||
    "";

  const finalUser = {
    ...user,
    token: finalToken,
  };

  sessionStorage.setItem("currentUser", JSON.stringify(finalUser));

  if (finalToken) {
    sessionStorage.setItem("token", finalToken);
    sessionStorage.setItem("authToken", finalToken);
    sessionStorage.setItem("jwt", finalToken);
  } else {
    sessionStorage.removeItem("token");
    sessionStorage.removeItem("authToken");
    sessionStorage.removeItem("jwt");
  }
}

/* ══════════════════════════════════════════════════════════════════
   syncUserWithBackend
══════════════════════════════════════════════════════════════════ */
async function syncUserWithBackend(localUser, password) {
  try {
    const res = await fetch(`${BASE}/auth/sync`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        name: localUser.name || "",
        email: localUser.email || "",
        password,
        role: localUser.role || "team",
        status: localUser.status || "pending",
        tenantId: localUser.tenantId || null,
        orgName: localUser.orgName || "",
        adminAccessCode: localUser.adminAccessCode || null,
        ownerAdminEmail: localUser.ownerAdminEmail || null,
        isInternal: localUser.isInternal || false,
      }),
    });

    const data = await res.json().catch(() => ({}));

    if (!res.ok) {
      if (data.status === "pending") return { pending: true };
      if (data.status === "rejected") return { rejected: true };
      console.warn("Backend sync failed:", data.error || res.status);
      return { error: data.error };
    }

    return data;
  } catch (e) {
    console.warn("Backend sync unreachable:", e.message);
    return { offline: true };
  }
}

export default function Login() {
  const navigate = useNavigate();

  const [tab, setTab] = useState("signin");
  const [subtab, setSubtab] = useState("register");

  const [f, setF] = useState({ name: "", email: "", password: "", org: "", code: "" });
  const set = (k, v) => { setF(p => ({ ...p, [k]: v })); setErr(null); };

  const [err, setErr] = useState(null);
  const [loading, setLoading] = useState(false);
  const [pending, setPending] = useState(false);
  const [success, setSuccess] = useState(null);

  const switchTab = t => {
    setTab(t);
    setErr(null);
    setLoading(false);
    setPending(false);
    setSuccess(null);
    setF({ name: "", email: "", password: "", org: "", code: "" });
  };

  const switchSub = s => {
    setSubtab(s);
    setErr(null);
    setF(p => ({ ...p, code: "" }));
  };

  const ensureSA = () => {
    const users = getAllUsers();
    if (!users.find(u => norm(u.email) === norm(SUPER_ADMIN_EMAIL))) {
      saveAllUsers([...users, {
        name: "Super Admin",
        email: SUPER_ADMIN_EMAIL,
        password: "Admin@1234",
        role: "superadmin",
        status: "approved",
        tenantId: null,
        subTenantId: null,
        isInternal: true,
        adminAccessCode: null,
        ownerAdminEmail: null,
      }]);
    }
  };

  /* ── SIGN IN ──────────────────────────────────────────────────────────── */
  const handleSignIn = async () => {
    if (!f.email.trim() || !f.password) {
      setErr("Please enter your email and password.");
      return;
    }

    const email = norm(f.email);

    // No IP blocking. Only this email is locked in this browser after wrong password attempts.
    if (isLoginLocked(email)) {
      setErr(
        `Too many wrong password attempts. Please try again after ${getRemainingLockMinutes(email)} minutes.`
      );
      return;
    }

    setLoading(true);
    setErr(null);
    setPending(false);

    try {
      const res = await authAPI.login({
        email,
        password: f.password,
      });

      const token = res.token || res.user?.token || res.accessToken || res.jwt;

      if (!token || !res.user) {
        throw new Error("Login response missing token/user");
      }

      const user = {
        ...res.user,
        token,
        subTenantId: res.user.subTenantId || res.user.tenantId || null,
      };

      // Correct login: reset wrong-password counter immediately.
      clearLoginLock(email);

      saveSession(user, token);

      setLoading(false);
      navigate("/");
      return;
    } catch (e) {
      const msg = String(e.message || "").toLowerCase();

      if (msg.includes("pending") || msg.includes("403")) {
        setPending(true);
      } else if (msg.includes("rejected")) {
        setErr("Your account has been rejected. Please contact Tervies support.");
      } else if (msg.includes("incorrect") || msg.includes("password") || msg.includes("401")) {
        const result = recordWrongLoginAttempt(email);

        if (result.locked) {
          setErr("Wrong password entered 5 times. Login is locked for 5 minutes. After 5 minutes, you can enter password again.");
        } else {
          setErr(`Incorrect password. Attempt ${result.attempts}/${MAX_LOGIN_ATTEMPTS}.`);
        }
      } else {
        setErr("Login failed. Please check your email/password or server connection.");
      }

      setLoading(false);
    }
  };

  /* ── JOIN AS STAFF ────────────────────────────────────────────────────── */
  const handleStaff = async () => {
    setErr(null);
    setLoading(true);

    try {
      if (!f.name.trim() || !f.email.trim() || f.password.length < 6) {
        setErr("Please fill in all fields. Password must be at least 6 characters.");
        setLoading(false);
        return;
      }

      const staffPayload = {
        name: f.name.trim(),
        email: norm(f.email),
        password: f.password,
        role: "team",
        status: "pending",
        tenantId: null,
        subTenantId: null,
        ownerAdminEmail: null,
        isInternal: true,
        orgName: "Tervies Internal",
      };

      const r = await registerInternalStaff({
        name: staffPayload.name,
        email: staffPayload.email,
        password: staffPayload.password,
      });

      if (r.error) {
        setErr(r.error);
        setLoading(false);
        return;
      }

      // Only Super Admin internal staff is synced to backend here.
      // Company admin and company team registration logic below is untouched.
      try {
        const res = await fetch(`${BASE}/auth/register`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(staffPayload),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok && !String(data.error || data.message || "").toLowerCase().includes("exist")) {
          console.warn("Backend staff register failed:", data.error || data.message || res.status);
        }
      } catch (e) {
        console.warn("Backend staff register unreachable, local request saved:", e.message);
      }

      const all = getAllUsers();
      const localUser = { ...staffPayload, registeredAt: new Date().toLocaleDateString("en-IN") };
      if (!all.some(u => norm(u.email) === staffPayload.email)) saveAllUsers([...all, localUser]);
      else saveAllUsers(all.map(u => norm(u.email) === staffPayload.email ? { ...u, ...localUser } : u));

      setPending(true);
    } catch (e) {
      console.error("Staff registration failed:", e);
      setErr("Staff registration failed. Please try again.");
    }

    setLoading(false);
  };

  /* ── COMPANY REGISTER ─────────────────────────────────────────────────── */
  const handleCompanyRegister = async () => {
    setErr(null);
    setLoading(true);

    try {
      if (!f.name.trim() || !f.email.trim() || f.password.length < 6 || !f.org.trim()) {
        setErr("Please fill in all fields before entering your access code.");
        setLoading(false);
        return;
      }

      const code = f.code.trim().toUpperCase();

      if (!code) {
        setErr("Please enter your Tenant Access Code. Contact superadmin@tervies.com if you don't have one.");
        setLoading(false);
        return;
      }

      /*
        LIVE FIX:
        Earlier this page checked TAC only from browser localStorage first.
        On another laptop / after refresh / after server sync, valid TAC could be
        present in MongoDB PortalState but missing from this browser localStorage,
        causing false "invalid or already used" errors.

        New safe flow:
        1) Try backend registration first. Backend now validates TAC from MongoDB.
        2) Mirror returned user/tenant into localStorage so old UI logic stays same.
        3) If backend is unreachable, fallback to old localStorage registration.
      */
      let backendOk = false;
      let backendUser = null;
      let backendError = "";

      try {
        const res = await fetch(`${BASE}/auth/register`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            name: f.name.trim(),
            email: f.email.trim(),
            password: f.password,
            role: "admin",
            orgName: f.org.trim(),
            tenantAccessCode: code,
          }),
        });

        const data = await res.json().catch(() => ({}));

        if (res.ok && data?.user) {
          backendOk = true;
          backendUser = data.user;
        } else {
          backendError = data.error || data.message || `HTTP ${res.status}`;
        }
      } catch (e) {
        backendError = e.message || "Backend unreachable";
      }

      if (backendOk && backendUser) {
        const all = getAllUsers();
        const cleanUser = {
          ...backendUser,
          email: norm(backendUser.email || f.email),
          password: f.password,
          registeredAt: backendUser.registeredAt || new Date().toLocaleString("en-IN"),
        };

        if (!all.some(u => norm(u.email) === norm(cleanUser.email))) {
          saveAllUsers([...all, cleanUser]);
        } else {
          saveAllUsers(all.map(u => norm(u.email) === norm(cleanUser.email) ? { ...u, ...cleanUser } : u));
        }

        if (cleanUser.tenantId) {
          saveTenant(cleanUser.tenantId, {
            name: f.org.trim(),
            adminEmail: norm(f.email),
            tenantId: cleanUser.tenantId,
            subTenantId: cleanUser.subTenantId || cleanUser.tenantId,
            active: cleanUser.status === "approved",
            createdAt: new Date().toLocaleString("en-IN"),
            adminAccessCode: cleanUser.adminAccessCode,
            accessCodeUsed: code,
          });
        }

        try {
          const codes = getAllTenantAccessCodes();
          const key = Object.keys(codes).find(k => String(k).toUpperCase() === code);
          if (key) {
            codes[key] = { ...(codes[key] || {}), used: true, usedBy: norm(f.email), usedAt: Date.now(), code };
            localStorage.setItem("tenantAccessCodes", JSON.stringify(codes));
          }
        } catch (_) {}

        setSuccess({
          org: f.org.trim(),
          email: norm(f.email),
          adminCode: cleanUser.adminAccessCode,
        });

        setLoading(false);
        return;
      }

      /* Fallback: keep old localStorage registration logic for local/dev cases. */
      const r = registerClientAdmin({
        name: f.name.trim(),
        email: f.email.trim(),
        password: f.password,
        orgName: f.org.trim(),
        tenantAccessCode: code,
      });

      if (r.error) {
        const msg = String(backendError || r.error || "");
        if (
          r.error.includes("Invalid or expired") ||
          msg.toLowerCase().includes("invalid") ||
          msg.toLowerCase().includes("used")
        ) {
          setErr(`Access code "${code}" is invalid or has already been used. Please ask Tervies to generate a new code.`);
        } else {
          setErr(r.error);
        }
        setLoading(false);
        return;
      }

      setSuccess({
        org: f.org.trim(),
        email: norm(f.email),
        adminCode: r.adminAccessCode,
      });
    } catch (e) {
      console.error("Company registration failed:", e);
      setErr("Company registration failed. Please try again.");
    }

    setLoading(false);
  };

  /* ── JOIN COMPANY ─────────────────────────────────────────────────────── */
  const handleJoinCompany = async () => {
    setErr(null);
    setLoading(true);

    try {
      if (!f.name.trim() || !f.email.trim() || f.password.length < 6) {
        setErr("Please fill in all fields.");
        setLoading(false);
        return;
      }

      const code = f.code.trim();

      if (!code) {
        setErr("Please enter the access code your company admin gave you.");
        setLoading(false);
        return;
      }

      const r = await registerClientTeam({
        name: f.name.trim(),
        email: f.email.trim(),
        password: f.password,
        adminAccessCode: code,
      });

      if (r.error) {
        setErr(r.error);
        setLoading(false);
        return;
      }

      setPending(true);
    } catch (e) {
      console.error("Team registration failed:", e);
      setErr("Team registration failed. Please try again.");
    }

    setLoading(false);
  };

  if (success) {
    return (
      <div className="lr">
        <div className="lcard">
          <div className="lcard-stripe" />
          <div className="lcard-body">
            <div className="lbrand">
              <div className="lbrand-icon">🏢</div>
              <div>
                <div className="lbrand-name">TERVIES Portal</div>
                <div className="lbrand-sub">BGV System</div>
              </div>
            </div>
            <div className="lscreen">
              <div className="lscreen-ico">🎉</div>
              <div className="lscreen-title">Company Registered!</div>
              <div className="lscreen-text">
                <strong>{success.org}</strong> has been submitted for review.
                Tervies will activate your account. You'll be notified once approved.
              </div>
              <div className="lcode-box">
                <div className="lcode-box-label">🔑 Your Team Access Code</div>
                <code className="lcode-box-val">{success.adminCode}</code>
                <div className="lcode-box-note">
                  <strong>Save this immediately.</strong> Share it with your team members so they can
                  register under your company account using the <em>"Join Company"</em> tab.
                </div>
              </div>
              <div className="lbadge lb-amber" style={{ margin: "0 auto 18px" }}>
                ⏳ Awaiting Tervies Approval
              </div>
              <button className="lbtn lb-blue" onClick={() => { setSuccess(null); switchTab("signin"); }}>
                🔐 Back to Sign In
              </button>
            </div>
          </div>
        </div>
      </div>
    );
  }

  if (pending) {
    const isStaff = tab === "staff";
    return (
      <div className="lr">
        <div className="lcard">
          <div className="lcard-stripe" />
          <div className="lcard-body">
            <div className="lbrand">
              <div className="lbrand-icon">🛡️</div>
              <div>
                <div className="lbrand-name">TERVIES Portal</div>
                <div className="lbrand-sub">BGV System</div>
              </div>
            </div>
            <div className="lscreen">
              <div className="lscreen-ico">📬</div>
              <div className="lscreen-title">Request Submitted!</div>
              <div className="lscreen-text">
                {isStaff
                  ? "Your staff request is pending. Tervies admin will review and approve your account."
                  : "Your request is pending. Your company admin will review and approve your account once they're set up."}
              </div>
              <div className="lbadge lb-amber" style={{ margin: "0 auto 20px" }}>
                ⏳ Awaiting Approval
              </div>
              <button className="lbtn lb-blue" onClick={() => { setPending(false); switchTab("signin"); }}>
                ← Back to Sign In
              </button>
            </div>
          </div>
        </div>
      </div>
    );
  }

  return (
    <div className="lr">
      <div className="lcard">
        <div className="lcard-stripe" />
        <div className="lcard-body">
          <div className="lbrand">
            <div className="lbrand-icon">🛡️</div>
            <div>
              <div className="lbrand-name">TERVIES Portal</div>
              <div className="lbrand-sub">Background Verification System</div>
            </div>
          </div>

          <div className="ltabs">
            <button className={`ltab ${tab === "signin" ? "on" : ""}`} onClick={() => switchTab("signin")}>🔐 Sign In</button>
            <button className={`ltab ${tab === "staff" ? "on" : ""}`} onClick={() => switchTab("staff")}>👤 Join as Staff</button>
            <button className={`ltab ${tab === "company" ? "on" : ""}`} onClick={() => switchTab("company")}>🏢 Company Access</button>
          </div>

          {err && (
            <div className="lalert la-err">
              <span style={{ flexShrink: 0 }}>❌</span>
              <span>{err}</span>
            </div>
          )}

          {tab === "signin" && (
            <>
              <div className="lh1">Welcome back</div>
              <div className="lh2">Sign in to your TERVIES BGV Portal account.</div>

              <div className="lfield">
                <label className="llabel">Email Address</label>
                <input
                  className="linput"
                  type="email"
                  placeholder="you@company.com"
                  value={f.email}
                  onChange={e => set("email", e.target.value)}
                  onKeyDown={e => e.key === "Enter" && handleSignIn()}
                  autoComplete="email"
                />
              </div>

              <div className="lfield">
                <label className="llabel">Password</label>
                <input
                  className="linput"
                  type="password"
                  placeholder="••••••••"
                  value={f.password}
                  onChange={e => set("password", e.target.value)}
                  onKeyDown={e => e.key === "Enter" && handleSignIn()}
                  autoComplete="current-password"
                />
              </div>

              <button className="lbtn lb-blue" onClick={handleSignIn} disabled={loading}>
                {loading ? <><span className="spin" /> Signing in…</> : "🔐 Sign In"}
              </button>

              <div className="lnotice ln-amber" style={{ marginTop: 12, marginBottom: 0 }}>
                <span className="ln-icon">🔑</span>
                <span>
                  Forgot password? Ask your Super Admin/Admin to open <strong>Manage Users</strong> and click
                  <strong> Reset Password</strong> beside your account.
                </span>
              </div>

           
              <div style={{ marginTop: 16, borderTop: "1px solid var(--border)", paddingTop: 14 }}>
                <div style={{ fontSize: 10.5, fontWeight: 700, textTransform: "uppercase", letterSpacing: "0.08em", color: "var(--ink4)", marginBottom: 8 }}>
                  Access levels
                </div>
                <div className="lroles">
                  {[
                    { i: "👑", n: "Super Admin", d: "You — manages everything, generates access codes" },
                    { i: "👤", n: "Tervies Staff", d: "Your team — approved by you directly" },
                    { i: "🔑", n: "Company Admin", d: "Client company admin — needs TAC code from you" },
                    { i: "🏢", n: "Company Team", d: "Client staff — needs access code from their admin" },
                  ].map(r => (
                    <div key={r.n} className="lrole">
                      <span className="lrole-i">{r.i}</span>
                      <div>
                        <div className="lrole-n">{r.n}</div>
                        <div className="lrole-d">{r.d}</div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </>
          )}

          {tab === "staff" && (
            <>
              <div className="lh1">Join as Tervies Staff</div>
              <div className="lh2">Register as an internal team member. The Tervies admin will approve your account.</div>

              <div className="lnotice ln-blue">
                <span className="ln-icon">ℹ️</span>
                <span>
                  This is for <strong>Tervies employees only</strong>.
                  If you work for a client company, use the <strong>"Company Access"</strong> tab.
                </span>
              </div>

              <Steps vals={[!!f.name.trim(), !!f.email.trim(), f.password.length >= 6]} />

              <div className="lfield">
                <label className="llabel">Your Full Name</label>
                <input className="linput" placeholder="Jane Smith" value={f.name} onChange={e => set("name", e.target.value)} />
              </div>

              <div className="lfield">
                <label className="llabel">Work Email</label>
                <input className="linput" type="email" placeholder="jane@tervies.com" value={f.email} onChange={e => set("email", e.target.value)} />
              </div>

              <div className="lfield">
                <label className="llabel">Password</label>
                <input className="linput" type="password" placeholder="Minimum 6 characters" value={f.password} onChange={e => set("password", e.target.value)} onKeyDown={e => e.key === "Enter" && handleStaff()} />
                <PwBar pw={f.password} />
              </div>

              <button className="lbtn lb-blue" onClick={handleStaff} disabled={!f.name || !f.email || f.password.length < 6}>
                👤 Submit Staff Request
              </button>

              <div className="lfooter">
                Already have an account? <a onClick={() => switchTab("signin")}>Sign in</a>
              </div>
            </>
          )}

          {tab === "company" && (
            <>
              <div className="lstabs">
                <button className={`lstab ${subtab === "register" ? "on" : ""}`} onClick={() => switchSub("register")}>
                  🏢 Register Company
                </button>
                <button className={`lstab ${subtab === "join" ? "on" : ""}`} onClick={() => switchSub("join")}>
                  🔗 Join Company
                </button>
              </div>

              {subtab === "register" && (
                <>
                  <div className="lh1">Register Your Company</div>
                  <div className="lh2">Set up your company's BGV portal. You need a Tenant Access Code from Tervies.</div>

                  <div className="lhowto">
                    <div className="lhowto-title">How to get a Tenant Access Code</div>
                    <div className="lhowto-steps">
                      {[
                        { n: 1, t: <>Contact Tervies at <strong>superadmin@tervies.com</strong> to request access.</> },
                        { n: 2, t: <>Tervies generates a unique code <strong>(TAC-XXXXX-XXXXXX)</strong> for your company.</> },
                        { n: 3, t: <>Enter that code below to create your company account.</> },
                        { n: 4, t: <>Once Tervies approves, you can sign in and start using the portal.</> },
                      ].map(s => (
                        <div key={s.n} className="lhowto-step">
                          <div className="lhowto-num">{s.n}</div>
                          <div className="lhowto-text">{s.t}</div>
                        </div>
                      ))}
                    </div>
                  </div>

                  <Steps vals={[!!f.name.trim(), !!f.email.trim(), f.password.length >= 6, !!f.org.trim(), !!f.code.trim()]} />

                  <div className="lfield">
                    <label className="llabel">Your Full Name</label>
                    <input className="linput" placeholder="Priya Sharma" value={f.name} onChange={e => set("name", e.target.value)} />
                  </div>

                  <div className="lfield">
                    <label className="llabel">Company Name</label>
                    <input className="linput" placeholder="Acme Pvt Ltd" value={f.org} onChange={e => set("org", e.target.value)} />
                  </div>

                  <div className="lfield">
                    <label className="llabel">Work Email</label>
                    <input className="linput" type="email" placeholder="admin@acme.com" value={f.email} onChange={e => set("email", e.target.value)} />
                  </div>

                  <div className="lfield">
                    <label className="llabel">Password</label>
                    <input className="linput" type="password" placeholder="Minimum 6 characters" value={f.password} onChange={e => set("password", e.target.value)} />
                    <PwBar pw={f.password} />
                  </div>

                  <div className="lfield">
                    <label className="llabel">Tenant Access Code</label>
                    <input
                      className="lcode"
                      placeholder="TAC-XXXXXXXX-XXXXXX  (from Tervies)"
                      value={f.code}
                      onChange={e => set("code", e.target.value)}
                      onKeyDown={e => e.key === "Enter" && handleCompanyRegister()}
                    />
                    <div className="linput-note">
                      This code is generated for you by Tervies. Each code is single-use.
                      Email <strong>superadmin@tervies.com</strong> if you need one.
                    </div>
                  </div>

                  <button className="lbtn lb-purple" onClick={handleCompanyRegister} disabled={!f.name || !f.org || !f.email || f.password.length < 6}>
                    🏢 Register Company
                  </button>

                  <div className="lfooter">
                    Already registered? <a onClick={() => switchTab("signin")}>Sign in</a>
                  </div>
                </>
              )}

              {subtab === "join" && (
                <>
                  <div className="lh1">Join Your Company</div>
                  <div className="lh2">Register as a team member under your company. Ask your company admin for their team access code.</div>

                  <div className="lnotice ln-green">
                    <span className="ln-icon">💡</span>
                    <span>
                      Ask your <strong>company admin</strong> for their <strong>Team Access Code</strong>.
                      It looks like: <code style={{ fontFamily: "var(--mono)", fontSize: 12 }}>XXXXXX-XXXXXX-XXXXXX</code>
                    </span>
                  </div>

                  <Steps vals={[!!f.name.trim(), !!f.email.trim(), f.password.length >= 6, !!f.code.trim()]} />

                  <div className="lfield">
                    <label className="llabel">Your Full Name</label>
                    <input className="linput" placeholder="Rahul Verma" value={f.name} onChange={e => set("name", e.target.value)} />
                  </div>

                  <div className="lfield">
                    <label className="llabel">Your Email</label>
                    <input className="linput" type="email" placeholder="rahul@acme.com" value={f.email} onChange={e => set("email", e.target.value)} />
                  </div>

                  <div className="lfield">
                    <label className="llabel">Password</label>
                    <input className="linput" type="password" placeholder="Minimum 6 characters" value={f.password} onChange={e => set("password", e.target.value)} />
                    <PwBar pw={f.password} />
                  </div>

                  <div className="lfield">
                    <label className="llabel">Company Admin Access Code</label>
                    <input
                      className="lcode"
                      placeholder="XXXXXX-XXXXXX-XXXXXX-XXXXXX"
                      value={f.code}
                      onChange={e => set("code", e.target.value)}
                      onKeyDown={e => e.key === "Enter" && handleJoinCompany()}
                    />
                    <div className="linput-note">
                      Your admin gets this code after their company is approved.
                      They share it with team members to link accounts.
                    </div>
                  </div>

                  <button className="lbtn lb-green" onClick={handleJoinCompany} disabled={!f.name || !f.email || f.password.length < 6 || !f.code.trim()}>
                    🔗 Join Company Team
                  </button>

                  <div className="lfooter">
                    Already have an account? <a onClick={() => switchTab("signin")}>Sign in</a>
                  </div>
                </>
              )}
            </>
          )}

        </div>
      </div>
    </div>
  );
}
