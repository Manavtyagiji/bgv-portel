/* ─────────────────────────────────────────────────────────────────────────────
   MYTABLE.JSX — Virtual table, filters, badges
───────────────────────────────────────────────────────────────────────────── */
 
.tbl-root * { box-sizing: border-box; margin: 0; padding: 0; }
.tbl-root { font-family: var(--body); background: var(--bg); color: var(--text); position: relative; overflow-x: hidden; }
.tbl-root::before { content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 0; background: radial-gradient(ellipse 80% 50% at 10% 0%, rgba(37,99,235,0.08) 0%, transparent 60%), radial-gradient(ellipse 60% 40% at 90% 10%, rgba(6,182,212,0.07) 0%, transparent 50%), radial-gradient(ellipse 50% 60% at 80% 80%, rgba(16,185,129,0.05) 0%, transparent 55%); }
 
.tbl-page-header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; flex-wrap: wrap; gap: 12px; }
.tbl-page-title { font-family: var(--head); font-size: 26px; font-weight: 700; letter-spacing: -0.3px; background: var(--accentg); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.tbl-page-sub { font-size: 13px; color: var(--text3); margin-top: 4px; display: flex; align-items: center; gap: 6px; }
.tbl-live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 3px rgba(16,185,129,0.20); animation: tbl-glow 2s ease infinite; display: inline-block; flex-shrink: 0; }
@keyframes tbl-glow { 0%,100% { box-shadow: 0 0 0 3px rgba(16,185,129,0.20); } 50% { box-shadow: 0 0 0 7px rgba(16,185,129,0.07); } }
.tbl-hdr-btns { display: flex; gap: 10px; flex-wrap: wrap; }
 
.card { background: var(--card); border: 1.5px solid var(--border2); border-radius: var(--radius); box-shadow: var(--shadow-sm); padding: 0; transition: var(--transition); position: relative; z-index: 1; }
.card:hover { box-shadow: var(--shadow-md); }
.card-header { display: flex; align-items: center; gap: 10px; padding: 18px 22px 14px; border-bottom: 1.5px solid var(--border2); }
.card-header-icon { width: 32px; height: 32px; border-radius: var(--r8); display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; }
.icon-blue { background: rgba(37,99,235,0.10); border: 1px solid rgba(37,99,235,0.22); }
.card-title { font-family: var(--head); font-size: 13.5px; font-weight: 600; color: var(--text); letter-spacing: 0.01em; display: flex; align-items: center; gap: 8px; }
.row-count { display: inline-flex; align-items: center; background: rgba(37,99,235,0.08); border: 1px solid rgba(37,99,235,0.18); color: var(--accent); border-radius: 99px; padding: 3px 12px; font-size: 12px; font-weight: 700; margin-left: 10px; }
.card-body { padding: 18px 22px 22px; }
 
.tbl-input { font-family: var(--body); font-size: 13.5px; background: var(--surface); border: 1.5px solid var(--border2); border-radius: var(--radius-xs); padding: 9px 13px; color: var(--text); outline: none; transition: var(--transition); }
.tbl-input:focus { background: #fff; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(37,99,235,0.09); }
.tbl-input::placeholder { color: var(--text3); }
.tbl-input option { background: #fff; color: var(--text); }
 
.btn { font-family: var(--head); font-size: 13px; font-weight: 600; letter-spacing: 0.02em; border: none; border-radius: var(--radius-xs); padding: 9px 18px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; transition: var(--transition); white-space: nowrap; }
.btn:hover  { filter: brightness(1.08); transform: translateY(-1px); }
.btn:active { transform: scale(0.97); }
.btn-accent   { background: var(--accentg); color: #fff; box-shadow: 0 4px 14px rgba(37,99,235,0.26); }
.btn-success  { background: linear-gradient(135deg,#10b981,#34d399); color: #001a0d; box-shadow: 0 4px 14px rgba(16,185,129,0.24); }
.btn-dark     { background: var(--text); color: #fff; box-shadow: 0 4px 14px rgba(15,28,63,0.18); }
.btn-ghost    { background: transparent; border: 1.5px solid var(--border2); color: var(--text2); }
.btn-ghost:hover { border-color: var(--accent); color: var(--accent); }
 
.filter-chip { background: rgba(37,99,235,0.08); border: 1px solid rgba(37,99,235,0.22); color: var(--accent); font-size: 12px; font-weight: 600; padding: 4px 13px; border-radius: 99px; }
.action-row  { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.act-div     { width: 1px; height: 28px; background: var(--border2); margin: 0 2px; }
.srch-wrap   { position: relative; display: inline-flex; align-items: center; }
.srch-ico    { position: absolute; left: 11px; color: var(--text3); font-size: 14px; pointer-events: none; }
.srch-wrap .tbl-input { padding-left: 32px; }
 
/* Scrollbar */
.tbl-vscroll::-webkit-scrollbar { height: 8px; width: 8px; }
.tbl-vscroll::-webkit-scrollbar-track { background: var(--surface); border-radius: 99px; }
.tbl-vscroll::-webkit-scrollbar-thumb { background: rgba(37,99,235,0.25); border-radius: 99px; }
.tbl-vscroll::-webkit-scrollbar-thumb:hover { background: rgba(37,99,235,0.45); }
 
/* Table head */
.tbl-head tr { background: linear-gradient(135deg,#1d4ed8 0%,#0891b2 100%); }
.tbl-th { font-family: var(--head); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.09em; color: rgba(255,255,255,0.78); padding: 15px 18px; text-align: left; white-space: nowrap; border-bottom: 1px solid rgba(255,255,255,0.10); border-right: 1px solid rgba(255,255,255,0.08); background: linear-gradient(135deg,#1d4ed8 0%,#0891b2 100%); }
.tbl-th:last-child { border-right: none; }
.tbl-th-client-price { background: linear-gradient(135deg,#0e6655,#0a7a5a) !important; }
.tbl-th-vendor-price { background: linear-gradient(135deg,#1a4480,#1565c0) !important; }
.tbl-th-vendor-name  { background: linear-gradient(135deg,#5b21b6,#7c3aed) !important; }
 
/* Table rows */
.tbl-tr { height: var(--row-h); border-bottom: 1px solid var(--border2); background: #ffffff; will-change: transform; }
.tbl-tr:hover { background: #eef4ff !important; }
.tbl-tr:nth-child(even) { background: var(--surface); }
.tbl-td { padding: 10px 18px; color: var(--text); vertical-align: middle; white-space: nowrap; border-right: 1px solid var(--border); font-size: 13.5px; overflow: hidden; max-width: 260px; text-overflow: ellipsis; }
.tbl-td:last-child { border-right: none; }
 
/* Price cells */
.client-price-cell  { display: inline-flex; align-items: center; gap: 5px; background: rgba(16,185,129,0.07); border: 1px solid rgba(16,185,129,0.20); color: #059669; font-family: var(--head); font-size: 13px; font-weight: 700; padding: 4px 10px; border-radius: var(--r4); min-width: 60px; justify-content: center; }
.client-price-empty { color: var(--text3); font-size: 12px; font-style: italic; }
.vendor-price-cell  { display: inline-flex; align-items: center; gap: 5px; font-family: var(--head); font-size: 13px; font-weight: 700; padding: 4px 10px; border-radius: var(--r4); min-width: 60px; justify-content: center; }
.vendor-price-filled { background: rgba(37,99,235,0.08); border: 1px solid rgba(37,99,235,0.22); color: var(--accent); }
.vendor-price-empty  { background: rgba(245,158,11,0.07); border: 1px solid rgba(245,158,11,0.18); color: #b45309; font-size: 11px; font-style: italic; font-weight: 500; }
.vendor-name-cell    { display: inline-flex; align-items: center; gap: 5px; background: rgba(139,92,246,0.07); border: 1px solid rgba(139,92,246,0.22); color: #6d28d9; font-family: var(--head); font-size: 12px; font-weight: 600; padding: 4px 10px; border-radius: var(--r4); max-width: 180px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.vendor-name-empty   { color: var(--text3); font-size: 11px; font-style: italic; }
 
/* Editable & inputs */
.rate-input  { width: 82px; font-family: var(--head); font-size: 13px; font-weight: 700; background: rgba(37,99,235,0.06); border: 1.5px solid rgba(37,99,235,0.22); border-radius: var(--radius-xs); padding: 6px 10px; color: var(--accent); text-align: center; outline: none; transition: var(--transition); }
.rate-input:focus { background: rgba(37,99,235,0.10); border-color: var(--accent); box-shadow: 0 0 0 3px rgba(37,99,235,0.10); }
.agent-input { font-family: var(--body); font-size: 13px; background: var(--surface); border: 1.5px solid var(--border2); border-radius: var(--radius-xs); padding: 6px 11px; color: var(--text); outline: none; width: 140px; transition: var(--transition); }
.agent-input:focus { border-color: var(--accent); background: #fff; box-shadow: 0 0 0 3px rgba(37,99,235,0.09); }
.agent-input::placeholder { color: var(--text3); }
.editable-cell { outline: none; cursor: text; width: 100%; min-height: 24px; display: block; font-weight: 450; color: var(--ink); padding: 4px; }
.editable-cell:empty::before { content: "✎ Click to edit..."; color: var(--text3); font-size: 11px; font-style: italic; opacity: 0.5; pointer-events: none; }
.editable-cell:focus::before { content: ""; }
 
/* Badges */
.badge { display: inline-flex; align-items: center; gap: 5px; padding: 4px 11px 4px 8px; border-radius: 99px; font-size: 11.5px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
.badge::before { content: ''; width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.badge-sent    { background: rgba(16,185,129,0.10); border: 1px solid rgba(16,185,129,0.25); color: #059669; }
.badge-sent::before { background: #10b981; box-shadow: 0 0 0 3px rgba(16,185,129,0.18); animation: bdot 2s infinite; }
.badge-pending { background: rgba(245,158,11,0.09); border: 1px solid rgba(245,158,11,0.22); color: #b45309; }
.badge-pending::before { background: #f59e0b; }
@keyframes bdot { 0%,100% { box-shadow: 0 0 0 3px rgba(16,185,129,0.18); } 50% { box-shadow: 0 0 0 6px rgba(16,185,129,0.06); } }
 
.assign-date  { font-size: 12px; color: var(--text3); font-family: var(--head); letter-spacing: 0.02em; }
 
/* Send buttons */
.send-btn { background: linear-gradient(135deg,#25d366 0%,#128c7e 100%); color: #fff; border: none; border-radius: var(--radius-xs); padding: 7px 15px; font-family: var(--head); font-size: 12px; font-weight: 700; cursor: pointer; transition: var(--transition); box-shadow: 0 3px 10px rgba(37,211,102,0.22); display: inline-flex; align-items: center; gap: 5px; }
.send-btn:hover  { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(37,211,102,0.32); filter: brightness(1.07); }
