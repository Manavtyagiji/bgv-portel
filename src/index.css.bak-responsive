.stat-hint { font-size: 10.5px; color: var(--text3); margin-top: 5px; font-family: var(--head); opacity: 0.7; }
 
/* ── Common panel/card ── */
.panel { background: var(--card); border: 1px solid var(--border2); border-radius: var(--r16); box-shadow: var(--shadow); overflow: hidden; min-width: 0; }
.live-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--green); box-shadow: 0 0 0 3px rgba(16,185,129,0.20); animation: lglow 2s ease infinite; display: inline-block; }
