/* ── Role pills / selects ── */
.role-select {
  font-family: var(--head); font-size: 11.5px; font-weight: 600;
  border: 1.5px solid var(--border2); border-radius: 7px;
  padding: 5px 28px 5px 10px; background: #f8faff; color: var(--text);
