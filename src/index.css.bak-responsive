/* ── Access denied ── */
.access-denied { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 320px; gap: 14px; background: linear-gradient(135deg, rgba(239,68,68,0.04), rgba(245,158,11,0.03)); border: 1.5px dashed rgba(239,68,68,0.22); border-radius: var(--r16); }
