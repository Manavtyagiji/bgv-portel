.sv-blue   { background: var(--accentg); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.sv-purple { background: linear-gradient(135deg,#7c3aed,#a78bfa); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
.stat-bar-wrap { margin-top: 6px; height: 3px; background: var(--border2); border-radius: 99px; overflow: hidden; width: 100px; }
.stat-bar { height: 100%; border-radius: 99px; transition: width 0.6s var(--ease); }
.sbar-green  { background: linear-gradient(90deg,#10b981,#34d399); }
.sbar-amber  { background: linear-gradient(90deg,#f59e0b,#fbbf24); }
