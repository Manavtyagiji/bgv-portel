/* ── Toast ── */
@keyframes toastSlideIn { from { opacity: 0; transform: translateY(16px) scale(0.97); } to { opacity: 1; transform: translateY(0) scale(1); } }
.upl-toast { position: fixed; bottom: 28px; right: 28px; z-index: 99999; display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-radius: 14px; font-family: var(--head); font-size: 14px; font-weight: 600; box-shadow: 0 12px 40px rgba(0,0,0,0.18); animation: toastSlideIn 0.3s cubic-bezier(.4,0,.2,1) forwards; max-width: 380px; pointer-events: none; }
.upl-toast.success { background: #10b981; color: #fff; border: 1.5px solid rgba(255,255,255,0.20); }
.upl-toast.master  { background: linear-gradient(135deg,#7c3aed,#a78bfa); color: #fff; border: 1.5px solid rgba(255,255,255,0.20); }
.upl-toast.error   { background: #ef4444; color: #fff; border: 1.5px solid rgba(255,255,255,0.20); }
