.modal-tab-count { font-size: 10px; font-weight: 800; padding: 2px 7px; border-radius: 99px; font-family: var(--head); }
.count-pending  { background: rgba(245,158,11,0.12); color: #b45309; border: 1px solid rgba(245,158,11,0.25); }
.count-approved { background: rgba(16,185,129,0.10); color: #059669; border: 1px solid rgba(16,185,129,0.22); }
.count-rejected { background: rgba(239,68,68,0.10); color: #b91c1c; border: 1px solid rgba(239,68,68,0.22); }
.modal-body { overflow-y: auto; flex: 1; padding: 16px 22px 22px; }
.modal-body::-webkit-scrollbar { width: 4px; }
.modal-body::-webkit-scrollbar-thumb { background: var(--border2); border-radius: 99px; }
.modal-empty { text-align: center; padding: 40px 20px; color: var(--text3); }
.modal-empty-icon { font-size: 32px; opacity: 0.3; margin-bottom: 10px; }.modal-empty-text { font-family: var(--head); font-size: 13.5px; }
 
/* User cards inside modal */
.user-card { background: var(--bg); border: 1.5px solid var(--border2); border-radius: 12px; padding: 14px 16px; margin-bottom: 10px; display: flex; align-items: center; gap: 14px; transition: all 0.15s; flex-wrap: wrap; }
.user-card:hover { border-color: rgba(37,99,235,0.30); box-shadow: 0 2px 12px rgba(37,99,235,0.07); }
.user-card:last-child { margin-bottom: 0; }
.user-avatar { width: 38px; height: 38px; border-radius: 10px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; font-size: 16px; font-weight: 700; font-family: var(--head); color: #fff; }
.ua-pending  { background: linear-gradient(135deg,#f59e0b,#fbbf24); }
.ua-approved { background: linear-gradient(135deg,#10b981,#34d399); }
.ua-rejected { background: linear-gradient(135deg,#ef4444,#f87171); }
.user-info  { flex: 1; min-width: 0; }
.user-name  { font-family: var(--head); font-size: 14px; font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.user-email { font-size: 12px; color: var(--text3); margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.user-meta  { font-size: 11px; color: var(--text3); margin-top: 3px; font-family: var(--head); }
.usb { padding: 3px 10px; border-radius: 99px; font-size: 11px; font-weight: 700; font-family: var(--head); text-transform: uppercase; flex-shrink: 0; }
.usb-pending  { background: rgba(245,158,11,0.10); border: 1px solid rgba(245,158,11,0.25); color: #b45309; }
.usb-approved { background: rgba(16,185,129,0.10); border: 1px solid rgba(16,185,129,0.25); color: #059669; }
.usb-rejected { background: rgba(239,68,68,0.10);  border: 1px solid rgba(239,68,68,0.22); color: #b91c1c; }
.user-actions { display: flex; gap: 6px; flex-shrink: 0; flex-wrap: wrap; }
.ua-btn { font-family: var(--head); font-size: 12px; font-weight: 600; border: none; border-radius: 7px; padding: 6px 13px; cursor: pointer; transition: all 0.15s; display: inline-flex; align-items: center; gap: 5px; }
.ua-btn:active { transform: scale(0.96); }
.ua-approve { background: linear-gradient(135deg,#10b981,#34d399); color: #001a0d; }
.ua-approve:hover { filter: brightness(1.08); transform: translateY(-1px); }
.ua-reject  { background: rgba(239,68,68,0.09); border: 1px solid rgba(239,68,68,0.25); color: #b91c1c; }
.ua-reject:hover  { background: rgba(239,68,68,0.15); transform: translateY(-1px); }
.ua-revoke  { background: rgba(245,158,11,0.09); border: 1px solid rgba(245,158,11,0.25); color: #92400e; }
.ua-revoke:hover  { background: rgba(245,158,11,0.15); transform: translateY(-1px); }
 
/* ── Insuff Modal ── */
.insuff-overlay { position: fixed; inset: 0; z-index: 2000; background: rgba(15,28,63,0.50); backdrop-filter: blur(7px); display: flex; align-items: center; justify-content: center; padding: 20px; animation: fadeIn 0.2s var(--ease); }
.insuff-box { background: var(--card); border: 1.5px solid rgba(124,58,237,0.30); border-radius: 20px; width: 100%; max-width: 900px; max-height: 88vh; overflow: hidden; box-shadow: 0 24px 80px rgba(124,58,237,0.18); display: flex; flex-direction: column; animation: slideUp 0.25s var(--ease); }
.insuff-header { padding: 22px 26px 18px; border-bottom: 1.5px solid rgba(124,58,237,0.18); display: flex; align-items: center; justify-content: space-between; flex-shrink: 0; background: linear-gradient(135deg, rgba(124,58,237,0.05), rgba(139,92,246,0.03)); }
.insuff-title { font-family: var(--head); font-size: 17px; font-weight: 700; color: var(--text); display: flex; align-items: center; gap: 10px; }
.insuff-title-icon { width: 36px; height: 36px; border-radius: 10px; background: linear-gradient(135deg,rgba(124,58,237,0.15),rgba(139,92,246,0.10)); border: 1px solid rgba(124,58,237,0.28); display: flex; align-items: center; justify-content: center; font-size: 17px; }
.insuff-count-badge { background: linear-gradient(135deg,#7c3aed,#a78bfa); color: #fff; font-size: 11px; font-weight: 800; padding: 3px 10px; border-radius: 99px; font-family: var(--head); }
.insuff-close { width: 32px; height: 32px; border-radius: 8px; border: 1.5px solid var(--border2); background: transparent; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 16px; color: var(--text3); transition: all 0.15s; }
.insuff-close:hover { background: var(--bg2); color: var(--text); }
.insuff-body { overflow: auto; flex: 1; padding: 0; }
.insuff-table { width: 100%; border-collapse: separate; border-spacing: 0; }
.insuff-thead tr { background: linear-gradient(135deg,#5b21b6,#7c3aed); }
.insuff-th { font-family: var(--head); font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.09em; color: rgba(255,255,255,0.85); padding: 14px 18px; text-align: left; white-space: nowrap; border-bottom: 1px solid rgba(255,255,255,0.12); border-right: 1px solid rgba(255,255,255,0.10); position: sticky; top: 0; z-index: 10; background: linear-gradient(135deg,#5b21b6,#7c3aed); }
.insuff-th:last-child { border-right: none; }
.insuff-tr { border-bottom: 1px solid rgba(124,58,237,0.10); transition: background 0.15s; }
.insuff-tr:last-child { border-bottom: none; }
.insuff-tr:hover { background: rgba(124,58,237,0.04); }
.insuff-tr:nth-child(even) { background: rgba(124,58,237,0.025); }
.insuff-td { padding: 12px 18px; font-size: 13px; color: var(--text); white-space: nowrap; border-right: 1px solid rgba(124,58,237,0.08); }
.insuff-td:last-child { border-right: none; }
.insuff-remark-cell { max-width: 260px; white-space: normal; word-break: break-word; font-size: 12.5px; color: var(--text2); line-height: 1.5; }
.insuff-date-cell { font-family: var(--head); font-size: 12px; font-weight: 600; background: rgba(124,58,237,0.07); border: 1px solid rgba(124,58,237,0.18); color: #6d28d9; padding: 3px 10px; border-radius: 6px; display: inline-block; }
.insuff-empty { text-align: center; padding: 64px 20px; color: var(--text3); }
.insuff-empty-icon { font-size: 40px; opacity: 0.25; margin-bottom: 12px; }
.insuff-empty-text { font-family: var(--head); font-size: 14px; }
 
@keyframes fadeIn  { from { opacity: 0; } to { opacity: 1; } }
@keyframes slideUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
 
