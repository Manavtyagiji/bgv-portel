/* ── App empty state ── */
.app-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 320px; gap: 12px; }
.app-empty-icon { font-size: 48px; opacity: 0.25; }
.app-empty-text { font-family: var(--head); font-size: 15px; color: var(--text3); }
