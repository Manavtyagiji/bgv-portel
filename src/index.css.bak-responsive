.stat-filter-badge { position: absolute; top: 10px; right: 10px; background: var(--accentg); color: #fff; font-size: 9px; font-weight: 700; padding: 2px 7px; border-radius: 99px; font-family: var(--head); text-transform: uppercase; }
.stat-icon-wrap { width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 20px; flex-shrink: 0; }
.sicon-green  { background: rgba(16,185,129,0.10); border: 1px solid rgba(16,185,129,0.20); }
.sicon-amber  { background: rgba(245,158,11,0.10); border: 1px solid rgba(245,158,11,0.20); }
.sicon-blue   { background: rgba(37,99,235,0.10);  border: 1px solid rgba(37,99,235,0.20);  }
