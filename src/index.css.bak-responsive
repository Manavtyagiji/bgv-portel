.stat-card.active-amber  { border-color: rgba(245,158,11,0.55); background: linear-gradient(135deg, rgba(245,158,11,0.06), rgba(251,191,36,0.04)); box-shadow: 0 0 0 3px rgba(245,158,11,0.14), var(--shadow-md); }
