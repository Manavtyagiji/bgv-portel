.pricing-header-icon { width: 32px; height: 32px; border-radius: var(--r8); display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; background: rgba(245,158,11,0.10); border: 1px solid rgba(245,158,11,0.22); }
.pricing-header-title { font-family: var(--head); font-size: 13.5px; font-weight: 600; color: var(--text); }
.pricing-header-sub { font-size: 12px; color: var(--text3); margin-top: 1px; }
.pricing-active-pill { background: rgba(37,99,235,0.08); border: 1px solid rgba(37,99,235,0.20); color: var(--accent); font-size: 11.5px; font-weight: 600; padding: 3px 11px; border-radius: 99px; font-family: var(--head); }
.pricing-body { padding: 18px 24px 20px; display: flex; flex-direction: column; gap: 14px; }
