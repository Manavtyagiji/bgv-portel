.sidebar-section-label { font-family:var(--head); font-size:9.5px; font-weight:700; text-transform:uppercase; letter-spacing:0.10em; color:var(--text3); padding:10px 10px 6px; white-space:nowrap; overflow:hidden; transition:opacity 0.2s; }
.sidebar.collapsed .sidebar-section-label { opacity:0; }
