/* ══════════════════════════════════════════════════════════════
   SUPER ADMIN EMAIL — must match tenantAuth.js + authController.js
══════════════════════════════════════════════════════════════ */
const SUPER_ADMIN_EMAIL = "superadmin@tervies.com";

/* Super Admin internal-team sync helpers only */
const API_BASE =
  window.location.hostname === "localhost" || window.location.hostname === "127.0.0.1"
    ? "http://localhost:5002/api"
  : "/api";
function getAuthTokenForApp() {
  try {
    const cu = JSON.parse(localStorage.getItem("currentUser") || "{}");
    return cu?.token || localStorage.getItem("token") || localStorage.getItem("authToken") || localStorage.getItem("jwt") || "";
  } catch {
    return localStorage.getItem("token") || localStorage.getItem("authToken") || localStorage.getItem("jwt") || "";
  }
}

function normaliseSAInternalUser(u = {}) {
  const roleRaw = String(u.role || "").trim().toLowerCase();
  const internalTeam =
    u.isInternal === true &&
    roleRaw !== "superadmin" &&
    roleRaw !== "admin" &&
    roleRaw !== "secondary_admin";

  return {
    ...u,
    email: String(u.email || "").trim().toLowerCase(),
    role: internalTeam ? "team" : (roleRaw || "team"),
    status: String(u.status || "pending").trim().toLowerCase(),
    isInternal: u.isInternal === true || internalTeam,
    _orgName: u.isInternal === true ? "Tervies Internal" : u._orgName,
  };
}

function isSAInternalTeamUser(u = {}) {
  const role = String(u.role || "").trim().toLowerCase();
  return u.isInternal === true && role !== "superadmin" && role !== "admin" && role !== "secondary_admin";
}

function mergeUsersByEmail(localUsers = [], remoteUsers = []) {
  const map = new Map();
  [...localUsers, ...remoteUsers].forEach(raw => {
    const u = normaliseSAInternalUser(raw);
    if (!u.email) return;
    map.set(u.email, { ...(map.get(u.email) || {}), ...u });
  });
  return Array.from(map.values());
}

async function fetchUsersForSuperAdminManagement() {
  const token = getAuthTokenForApp();
  if (!token) return [];

  const endpoints = ["/auth/users", "/auth/all-users"];
  for (const ep of endpoints) {
    try {
      const res = await fetch(`${API_BASE}${ep}`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok) continue;
      const arr = Array.isArray(data) ? data : (Array.isArray(data.users) ? data.users : []);
      if (arr.length) return arr.map(normaliseSAInternalUser);
    } catch (e) {
      console.warn("Super Admin user sync failed:", e.message);
    }
  }
  return [];
}

const CSS = `
@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap');
:root {
  --bg:#f0f6ff; --bg2:#e6f0ff; --card:#ffffff;
  --border:rgba(59,130,246,0.12); --border2:rgba(59,130,246,0.22);
  --text:#0f1c3f; --text2:#4a6080; --text3:#8ba3c0;
  --accent:#2563eb; --accent2:#06b6d4;
  --accentg:linear-gradient(135deg,#2563eb 0%,#06b6d4 100%);
  --green:#10b981; --amber:#f59e0b; --red:#ef4444;
  --gold:#f5a623; --purple:#7c3aed;
  --sidebar-w:240px; --sidebar-collapsed:64px;
  --r8:8px; --r12:12px; --r16:16px;
  --head:'Space Grotesk',sans-serif;
  --body:'Plus Jakarta Sans',sans-serif;
