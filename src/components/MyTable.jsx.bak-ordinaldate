  ══════════════════════════════════════════════════════════════ */
  const onDeleteRow = useCallback(async (row, ri) => {
    if (isTeam) return; // safety guard — team members can never delete

    const recordId = getRecordMongoId(row);
    const candidateName =
      row?.["Candidate Name"] ||
      row?.["Check Id"] ||
      row?.["Case ID"] ||
      `Row ${ri + 1}`;

    const ok = window.confirm(
      `⚠️ Permanently delete case "${candidateName}"?\n\nThis cannot be undone and will remove it from the server.`
    );
    if (!ok) return;

    showSaving();
    try {
      const token = getAuthToken();
      const API_BASE =
        window.location.hostname === "localhost"
          ? "http://localhost:5002/api"
          : "https://profeix.info/api";

      if (recordId) {
        if (typeof uploadAPI.deleteRecord === "function") {
          await uploadAPI.deleteRecord(recordId);
        } else if (typeof uploadAPI.removeRecord === "function") {
          await uploadAPI.removeRecord(recordId);
        } else {
          const res = await fetch(
            `${API_BASE}/upload/records/${encodeURIComponent(recordId)}`,
            {
              method: "DELETE",
              headers: token ? { Authorization: `Bearer ${token}` } : {},
            }
          );
          if (res.status === 401 || res.status === 403) {
            throw new Error("Session expired. Please logout and login again.");
          }
          if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            throw new Error(
              errData.error || errData.message || `Delete failed (${res.status})`
            );
          }
        }
      }

      /* Remove from local state */
      setData(prev => {
        const nd = Array.isArray(prev) ? [...prev] : [];
        return nd.filter((r, idx) => {
          if (recordId && getRecordMongoId(r) === recordId) return false;
          if (idx === ri) return false;
          return true;
        });
      });

      showSaved();
    } catch (err) {
      console.error("Delete row failed:", err);
      setDbStatus(null);
      alert(`❌ Delete failed: ${err.message}`);
    }
  }, [isTeam, data, setData, showSaving, showSaved]);

  /* ══════════════════════════════════════════════════════════════
     SEND TO CLIENT — admin/superadmin only.
     Looks up the client contact for the row's clientName, then
     sends via the existing send-mail endpoint (same as onGmail).
  ══════════════════════════════════════════════════════════════ */
  const onSendToClient = useCallback(async (row) => {
    if (isTeam && !isInternalSuperTeam) return;

    const recordId = getRecordMongoId(row);
    if (!recordId) {
      alert("❌ Record ID missing. Please refresh and try again.");
      return;
    }

    const clientName = row["Client Name"] || row.clientName || row.rawData?.["Client Name"] || "";
    if (!clientName) {
      alert("❌ This case has no client name. Cannot look up client contact.");
      return;
    }

    const token = getAuthToken();
    const API_BASE =
      window.location.hostname === "localhost"
        ? "http://localhost:5002/api"
        : "https://profeix.info/api";

    // Always fetch fresh pricing from DB to avoid stale localStorage/closure issues.
    let clientEmail = "", clientCc = [];
    try {
      const freshPricing = await fetch(`${API_BASE}/pricing`, {
        headers: { Authorization: `Bearer ${token}` },
      }).then(r => r.json());
      const scopeRules = getRulesForKey(freshPricing, clientName);
      const cpRules    = scopeRules.filter(r => r.clientPrice !== undefined);
      const stateMatch = cpRules.map(r => findMatchingRule([r], row)).find(r => r && r.email)
                      || findMatchingRule(cpRules, row);
      if (stateMatch?.email) {
        clientEmail = stateMatch.email;
        clientCc    = Array.isArray(stateMatch.ccList) ? stateMatch.ccList : [];
      }
    } catch (e) {
      console.warn("[ClientSend] pricing fetch failed, falling back to cache:", e.message);
      const scopeRules = getRulesForKey(pricingRulesRef.current, clientName);
      const cpRules    = scopeRules.filter(r => r.clientPrice !== undefined);
      const stateMatch = cpRules.map(r => findMatchingRule([r], row)).find(r => r && r.email)
                      || findMatchingRule(cpRules, row);
      if (stateMatch?.email) {
        clientEmail = stateMatch.email;
        clientCc    = Array.isArray(stateMatch.ccList) ? stateMatch.ccList : [];
      }
    }

    if (!clientEmail) {
      const rowState = (row["State"] || row.state || row.rawData?.["State"] || "").trim();
      alert(
        `❌ No email found for "${clientName}"${rowState ? ` in state "${rowState}"` : ""}.\n\n` +
        `Go to Add Clients → Client Price / State and set the email for this state row, ` +
        `or use Client Contacts → Bulk Import.`
      );
      return;
    }

    // Direct send — no prompts. Use the resolved client email/CC as-is.
    const to = clientEmail;
    const cc = clientCc.join(", ");
    const candidateName = row["Candidate Name"] || row.candidateName || "Candidate";

    // Default mail account (first one) — no picker prompt.
    let mailConfigId = "";
    try {
      const mcRes = await fetch(`${API_BASE}/upload/mail-configs`, {
        headers: { Authorization: `Bearer ${token}` },
      });
      const mcData = await mcRes.json().catch(() => ({}));
      const accounts = Array.isArray(mcData?.accounts) ? mcData.accounts : [];
      if (accounts.length > 0) mailConfigId = accounts[0].id;
    } catch (_) { mailConfigId = ""; }

    // Send via existing endpoint
    try {
      const res = await fetch(`${API_BASE}/upload/send-mail`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
        body: JSON.stringify({
          recordId,
          to,
          cc,
          mailConfigId,
          subject: `BGV Report - ${candidateName} (${clientName})`,
          source: "client",
        }),
      });
      const dataRes = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(dataRes.error || dataRes.message || "Send failed");
      alert(`✅ Report sent to client "${clientName}" (${to}) successfully!`);
    } catch (err) {
      console.error("Send to client error:", err);
      alert(`❌ Send failed: ${err.message}`);
    }
  }, [isTeam]);

  const onStatus = useCallback((ri, v, sourceRow = null, { skipReportGate = false } = {}) => {
    const statusMap = {
      pending: "Pending",
      insuff: "Insuff",
      "insuff clear": "Insuff Clear",
      insuffclear: "Insuff Clear",
      closed: "Closed",
      hold: "Hold",
      stop: "Stop",
      sent: "Sent",
    };

    const statusKey = String(v || "").trim().toLowerCase();

    // Super-admin scope only: require a report to be uploaded before allowing Closed.
    // Secondary admin and their team are completely unaffected. skipReportGate
    // is opt-in per caller (currently only the bulk-status-bar action) — the
    // per-row dropdown never passes it, so its own behavior is unchanged.
    if (statusKey === "closed" && !skipReportGate) {
      // Role-based, not just an exact email match against the hardcoded
      // SUPER_ADMIN_EMAIL constant — if the logged-in superadmin account's
      // actual email ever differs from that constant, an email-only check
      // silently fails and this "super-admin scope" gate (and the matching
      // auto-close-after-upload below) never fires for a genuine superadmin.
      const isSuperScope =
        normalizeEmail(scopeAdmin) === normalizeEmail(SUPER_ADMIN_EMAIL) ||
        String(currentUser?.role || "").trim().toLowerCase() === "superadmin";
      if (isSuperScope) {
        const checkRow = sourceRow || null;
        const hasReport = Boolean(
          checkRow?.reportUploaded || checkRow?.reportFile ||
          checkRow?.rawData?.reportUploaded || checkRow?.rawData?.reportFile
        );
        if (!hasReport) {
          alert("❌ A report must be uploaded before setting status to Closed.");
          return;
        }
      }
    }

    const nextStatus = statusMap[statusKey] || String(v || "Pending").trim() || "Pending";
    const sourceId = getRecordMongoId(sourceRow || {});

    // Everything below used to be gated on first finding this row inside
    // `data` (a separate, lazily/partially-populated cache — under server
    // pagination it very often does NOT yet contain the row on screen). If
    // that lookup failed, the whole function silently bailed out before ever
    // reaching the API call below — no visible change, no network request,
    // nothing. sourceRow (passed straight from the rendered row a moment
    // ago) is always the correct, current record, so it's now the source of
    // truth for the patch; `data`/serverRows/normRef are only best-effort
    // synced afterward, never gates.
    if (!sourceId) return;
    const currentRow = sourceRow || {};

    const shouldClearCompletedDate = statusKey === "pending";
    const existingCompletedDate =
      currentRow["Completed Date"] ||
      currentRow.completedDate ||
      currentRow.closedDate ||
      currentRow.rawData?.["Completed Date"] ||
      currentRow.rawData?.completedDate ||
      currentRow.rawData?.closedDate ||
      "";

    const cd = statusKey === "closed" && !existingCompletedDate
      ? todayStr()
      : shouldClearCompletedDate
        ? ""
        : existingCompletedDate;

    const completedDatePatch = shouldClearCompletedDate
      ? { "Completed Date": "", completedDate: "", closedDate: "" }
      : (cd ? { "Completed Date": cd, completedDate: cd, closedDate: cd } : {});

    const existingStopDate =
      currentRow["Stop Date"] ||
      currentRow.stopDate ||
      currentRow.rawData?.["Stop Date"] ||
      currentRow.rawData?.stopDate ||
      "";

    const sd = statusKey === "stop" && !existingStopDate
      ? todayStr()
      : existingStopDate;

    const stopDatePatch = statusKey === "stop" && sd
      ? { "Stop Date": sd, stopDate: sd }
      : {};

    const existingVCD =
      currentRow["Vendor Complete Date"] ||
      currentRow.vendorCompleteDate ||
      currentRow.rawData?.["Vendor Complete Date"] ||
      currentRow.rawData?.vendorCompleteDate ||
      "";
    const vcd = statusKey === "closed" && !existingVCD
      ? todayStr()
      : shouldClearCompletedDate
        ? ""
        : existingVCD;
    const vendorCompleteDatePatch = shouldClearCompletedDate
      ? { "Vendor Complete Date": "", vendorCompleteDate: "" }
      : (vcd ? { "Vendor Complete Date": vcd, vendorCompleteDate: vcd } : {});

    // Secondary-admin-only (same audience as the Insuff Clear status option
    // itself, showInsuffClearOption) — auto-stamp today's date into Insuff
    // Date / Insuff Clear Date the moment that status is picked, same
    // pattern as Closed auto-stamping Completed Date above. Super admin and
    // their internal team are unaffected; nothing here changes their
    // Insuff/Insuff Clear behavior.
    const existingInsuffDate =
      currentRow["Insuff Date"] || currentRow.insuffDate ||
      currentRow.rawData?.["Insuff Date"] || currentRow.rawData?.insuffDate || "";
    const insDate = (showInsuffClearOption && statusKey === "insuff" && !existingInsuffDate)
      ? todayStr()
      : existingInsuffDate;
    const insuffDatePatch = insDate ? { "Insuff Date": insDate, insuffDate: insDate } : {};

    const existingInsuffClearDate =
      currentRow["Insuff Clear Date"] || currentRow.insuffClearDate ||
      currentRow.rawData?.["Insuff Clear Date"] || currentRow.rawData?.insuffClearDate || "";
    const isInsuffClearStatus = statusKey === "insuff clear" || statusKey === "insuffclear";
    const insClearDate = (showInsuffClearOption && isInsuffClearStatus && !existingInsuffClearDate)
      ? todayStr()
      : existingInsuffClearDate;
    const insuffClearDatePatch = insClearDate ? { "Insuff Clear Date": insClearDate, insuffClearDate: insClearDate } : {};

    const accessPatch = makeAccessPatch(currentRow);

    const updatedRow = {
      ...currentRow,
      ...accessPatch,
      Status: nextStatus,
      status: nextStatus,
      ...completedDatePatch,
      ...stopDatePatch,
      ...vendorCompleteDatePatch,
      ...insuffDatePatch,
      ...insuffClearDatePatch,
      rawData: {
        ...(currentRow.rawData || {}),
        ...accessPatch,
        Status: nextStatus,
        status: nextStatus,
        ...completedDatePatch,
        ...stopDatePatch,
        ...vendorCompleteDatePatch,
        ...insuffDatePatch,
        ...insuffClearDatePatch,
      },
    };

    const previousRow = { ...currentRow };

    let updatedIndex = -1;
    let updatedDataSnapshot = null;
    setData(prevData => {
      const base = Array.isArray(prevData) ? prevData : [];
      let targetIndex = Number.isInteger(ri) ? ri : -1;
      if (targetIndex < 0 || !base[targetIndex] || getRecordMongoId(base[targetIndex]) !== sourceId) {
        targetIndex = base.findIndex(r => getRecordMongoId(r) === sourceId);
      }
      const nd = [...base];
      if (targetIndex >= 0) {
        nd[targetIndex] = updatedRow;
        updatedIndex = targetIndex;
      } else {
        // Not cached locally yet — add it so exports/bulk ops relying on
        // `data` can still find it, without blocking on that lookup.
        nd.push(updatedRow);
        updatedIndex = nd.length - 1;
      }
      updatedDataSnapshot = nd;
      return nd;
    });

    // For Admin/SA, the visible table (pagedData) is sourced from serverRows,
    // not from `data` — the per-page fetch effect is the only other writer of
    // serverRows. Without this, the edit above updates `data`/normRef (used
    // by exports/bulk ops) but the on-screen dropdown itself keeps rendering
    // the old serverRows value and appears to silently ignore the change.
    if (serverPaginated) {
      setServerRows(prevRows => {
        if (!Array.isArray(prevRows)) return prevRows;
        const idx = prevRows.findIndex(r => getRecordMongoId(r) === sourceId);
        if (idx < 0) return prevRows;
        const nr = [...prevRows];
        nr[idx] = updatedRow;
        return nr;
      });
    }

    if (normRef.current && updatedIndex >= 0 && normRef.current[updatedIndex]) {
      normRef.current[updatedIndex] = normalizeRow(updatedRow);
    }

    // Only re-filter when a status filter is active — changing a row's status
    // can't affect which rows pass a tier/search filter, only a status filter.
    if (statusFilter) triggerFilter();

    if (statusKey === "stop") {
      setStopFieldsOpen(true);
    } else {
      const stillHasStop = (updatedDataSnapshot || []).some((r, idx) =>
        idx !== updatedIndex && getRowStatus(r).toLowerCase().trim() === "stop"
      );
      if (!stillHasStop) setStopFieldsOpen(false);
    }

    if (statusKey === "insuff") {
      if (!insuffExpandRef.current.showInsuff) {
        insuffExpandRef.current.setShowInsuff(true);
        setInsuffToast(true);
        clearTimeout(toastTimer.current);
        toastTimer.current = setTimeout(() => setInsuffToast(false), 2600);
      }
    } else {
      const stillHasInsuff = (updatedDataSnapshot || []).some((r, idx) =>
        idx !== updatedIndex && getRowStatus(r).toLowerCase().trim() === "insuff"
      );
      if (!stillHasInsuff && insuffExpandRef.current.showInsuff) {
        insuffExpandRef.current.setShowInsuff(false);
        setShowInsuffClear(false);
      }
    }

    locallyEditedStatusRef.current.set(String(sourceId), Date.now());
    showSaving();
    uploadAPI.updateRecord(sourceId, {
      ...accessPatch,
      status: nextStatus,
      Status: nextStatus,
      ...completedDatePatch,
      ...stopDatePatch,
      ...vendorCompleteDatePatch,
      ...insuffDatePatch,
      ...insuffClearDatePatch,
      rawData: updatedRow.rawData,
    })
      .then((serverRow) => {
        // Sync local state from the SERVER's confirmed saved document
        // instead of only trusting the optimistic local patch above. This
        // closes the exact gap that caused status to look "Closed" on
        // screen while the database silently stayed on a different value
        // (interrupted save, or a concurrent edit landing moments later) —
        // the on-screen row can no longer drift from what's actually saved
        // once a save call itself succeeds.
        if (serverRow && typeof serverRow === "object") {
          setData(prev => {
            if (!Array.isArray(prev)) return prev;
            const nd = [...prev];
            if (updatedIndex >= 0 && updatedIndex < nd.length) nd[updatedIndex] = serverRow;
            return nd;
          });
          if (normRef.current && updatedIndex >= 0 && normRef.current[updatedIndex]) {
            normRef.current[updatedIndex] = normalizeRow(serverRow);
          }
          if (serverPaginated) {
            setServerRows(prevRows => {
              if (!Array.isArray(prevRows)) return prevRows;
              const idx = prevRows.findIndex(r => getRecordMongoId(r) === sourceId);
              if (idx < 0) return prevRows;
              const nr = [...prevRows];
              nr[idx] = serverRow;
              return nr;
            });
          }
        }
        showSaved();
      })
      .catch(e => {
        console.warn("DB status update failed:", e.message);
        setDbStatus(null);
        locallyEditedStatusRef.current.delete(String(sourceId));
        setData(prev => {
          if (!Array.isArray(prev)) return prev;
          const nd = [...prev];
          if (updatedIndex >= 0 && updatedIndex < nd.length) nd[updatedIndex] = previousRow;
          return nd;
        });
        if (normRef.current && updatedIndex >= 0 && normRef.current[updatedIndex]) {
          normRef.current[updatedIndex] = normalizeRow(previousRow);
        }
        if (serverPaginated) {
          setServerRows(prevRows => {
            if (!Array.isArray(prevRows)) return prevRows;
            const idx = prevRows.findIndex(r => getRecordMongoId(r) === sourceId);
            if (idx < 0) return prevRows;
            const nr = [...prevRows];
            nr[idx] = previousRow;
            return nr;
          });
        }
        if (statusFilter) triggerFilter();
        alert("⚠️ Status update failed — reverted to previous value.");
      });
  }, [setData, setServerRows, serverPaginated, triggerFilter, showSaving, showSaved, makeAccessPatch, statusFilter, showInsuffClearOption]);

  /* ── Bulk Update by Excel — parse step ── */
  const handleBulkUpdateParse = useCallback((e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    if (e?.target) e.target.value = null;

    const cleanVal = (v) => {
      if (!v) return "";
      if (v instanceof Date) return v.toLocaleDateString("en-IN");
      return String(v).replace(/[\r\n\u2028\u2029]+/g, " ").replace(/\s+/g, " ").trim();
    };
    const isStatusCol = (name = "") => {
      const k = String(name || "").trim().toLowerCase();
      return k === "status" || k === "new status" || k === "newstatus" || k === "target status";
    };
    const isCheckIdCol = (name = "") => {
      const k = String(name || "").trim().toLowerCase();
      return k === "check id" || k === "checkid" || k === "case id" || k === "caseid";
    };
    const isVendorCol = (name = "") =>
      String(name || "").trim().toLowerCase().startsWith("vendor");

    // Check Id match key — the upload file and the DB don't always agree on
    // Check Id's type (e.g. a plain number 166594023 in the file vs the
    // string "166594023" already stored), and a raw string comparison
    // silently fails in that case. Normalize both sides identically: string,
    // trimmed, a trailing ".0"/".00" from a numeric-to-string conversion
    // stripped, compared case-insensitively.
    const normalizeIdForMatch = (v) => {
      let s = String(v === undefined || v === null ? "" : v).trim();
      s = s.replace(/\.0+$/, "");
      return s.toLowerCase();
    };

    const getExistingVal = (record, colName) => {
      if (!record || !colName) return "";
      if (record[colName] !== undefined && record[colName] !== null) return record[colName];
      if (record.rawData?.[colName] !== undefined && record.rawData?.[colName] !== null) return record.rawData[colName];
      const cl = String(colName).trim().toLowerCase();
      const dk = Object.keys(record).find((k) => String(k).trim().toLowerCase() === cl);
      if (dk !== undefined) return record[dk];
      const rk = Object.keys(record.rawData || {}).find((k) => String(k).trim().toLowerCase() === cl);
      return rk !== undefined ? record.rawData[rk] : "";
    };
    // Checks both "Check Id" and "Case ID" on the record — different parts of
    // this app use either name for the same identity field.
    const getExistingCheckId = (record) =>
      getExistingVal(record, "Check Id") || getExistingVal(record, "Case ID");

    const getExistingVendorName = (record) =>
      cleanVal(
        getExistingVal(record, "Vendor Name") ||
        getExistingVal(record, "Vendor Company") ||
        getExistingVal(record, "Vendor") || ""
      );

    const STATUS_MAP = {
      pending: "Pending", insuff: "Insuff", closed: "Closed",
      hold: "Hold", stop: "Stop", sent: "Sent",
    };
    const normalizeStatusValue = (v) => {
      const k = String(v || "").trim().toLowerCase();
      return STATUS_MAP[k] || String(v || "").trim();
    };
    const getExistingStatus = (record) =>
      normalizeStatusValue(getExistingVal(record, "Status") || getExistingVal(record, "status"));

    const reader = new FileReader();
    reader.onload = async (ev) => {
      setBulkUpdateLoading(true);
      try {
        const buf = new Uint8Array(ev.target.result);
        const wb = XLSX.read(buf, { type: "array" });

        // A workbook can have multiple sheets (e.g. a template/instructions
        // sheet plus the real data sheet) — always reading SheetNames[0]
        // would silently match against the wrong sheet whenever the real
        // data isn't first. Scan every sheet and use the first one whose
        // header row actually has a Check Id column.
        let raw = null;
        for (const sheetName of wb.SheetNames) {
          const candidateRaw = XLSX.utils.sheet_to_json(wb.Sheets[sheetName], {
            header: 1, raw: false, dateNF: "dd/mm/yyyy", cellDates: true,
          });
          if (candidateRaw.length && candidateRaw[0]?.length &&
              candidateRaw[0].some((h) => isCheckIdCol(h))) {
            raw = candidateRaw;
            break;
          }
        }
        // No sheet had a recognizable Check Id column — fall back to the
        // first sheet so the existing "no Check Id column found" message
        // still fires below, same as before this fix.
        if (!raw) {
          raw = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], {
            header: 1, raw: false, dateNF: "dd/mm/yyyy", cellDates: true,
          });
        }
        if (!raw.length || !raw[0]?.length) { alert("❌ Excel is empty."); return; }

        const headers = raw[0];
        const checkIdColIdx = headers.findIndex((h) => isCheckIdCol(h));
        if (checkIdColIdx === -1) {
          alert('❌ No "Check Id" (or "Case ID") column found in this file. Bulk Update by Excel matches records by Check Id.');
          return;
        }
        const statusColIdx = headers.findIndex((h) => isStatusCol(h));
        const vendorColIdx = headers.findIndex((h) => isVendorCol(h));

        if (statusColIdx === -1 && vendorColIdx === -1) {
          alert('❌ This file has no "Status" and no "Vendor Name"/"Vendor Company" column — nothing for Bulk Update to change.');
          return;
        }

        const body = raw.slice(1);

        // Pass 1: walk the file once, skip blank rows (stopping early after
        // a long run of them — see below), and collect just the small bits
        // needed per real row. No matching happens yet.
        const rowEntries = [];
        const blankRows = [];

        // A plain .forEach can't stop early — with a file that has a huge
        // phantom range (e.g. 1,048,575 rows from Excel's used-range
        // artifact, only ~920 of them real), that means iterating the whole
        // thing pointlessly. Stop once a long run of fully-blank rows is
        // hit, on the assumption everything after is trailing emptiness.
        const MAX_CONSECUTIVE_BLANK = 500;
        let consecutiveBlank = 0;

        for (let ri = 0; ri < body.length; ri++) {
          const row = body[ri];
          const isBlank = !row?.length || row.every((v) => !v);
          if (isBlank) {
            consecutiveBlank++;
            if (consecutiveBlank >= MAX_CONSECUTIVE_BLANK) break;
            continue;
          }
          consecutiveBlank = 0;

          const rowNo = ri + 2;
          const rowCheckIdRaw = row[checkIdColIdx];
          const key = normalizeIdForMatch(rowCheckIdRaw);
          if (!key) {
            blankRows.push({ rowNo, preview: "Check Id: (blank)" });
            continue;
          }
          const rowStatus = statusColIdx !== -1 ? normalizeStatusValue(row[statusColIdx]) : "";
          const rowVendor = vendorColIdx !== -1 ? cleanVal(row[vendorColIdx]) : "";
          rowEntries.push({ rowNo, rowCheckIdRaw, key, rowStatus, rowVendor });
        }

        // Pass 2: resolve matches. Under server pagination, `data` only ever
        // holds the small page currently loaded client-side — fetching the
        // FULL dataset here (as an earlier version of this fix did) just to
        // match a few hundred Check Ids reintroduced the exact "load
        // everything into the browser tab" pattern that caused the Records
        // page OOM crashes server pagination was built to eliminate. The
        // matching itself now happens on the server (bulkMatchByCheckId) —
        // only the small matched subset is sent back, never the full
        // dataset. Team members are unchanged: their `data` already holds
        // their complete allocated set, matched locally as before.
        const recordsById = new Map();
        const serverUnmatchedKeys = new Set();
        const serverAmbiguousCounts = new Map();

        if (serverPaginated) {
          let matchResult;
          try {
            matchResult = await fetchBulkMatchFromServer(
              rowEntries.map((r) => r.rowCheckIdRaw)
            );
          } catch (err) {
            alert(`❌ Could not match against server records: ${err.message}`);
            return;
          }
          (matchResult.matched || []).forEach((record) => {
            const key = normalizeIdForMatch(getExistingCheckId(record));
            if (!key) return;
            recordsById.set(key, [{ record, dataIndex: -1 }]);
          });
          (matchResult.unmatchedKeys || []).forEach((k) => serverUnmatchedKeys.add(k));
          (matchResult.ambiguousKeys || []).forEach(({ key, count }) => serverAmbiguousCounts.set(key, count));
        } else {
          (Array.isArray(data) ? data : []).forEach((record, dataIndex) => {
            const key = normalizeIdForMatch(getExistingCheckId(record));
            if (!key) return;
            const arr = recordsById.get(key);
            if (arr) arr.push({ record, dataIndex });
            else recordsById.set(key, [{ record, dataIndex }]);
          });
        }

        const matched = [], unmatched = [...blankRows], ambiguous = [];
        const vendorChanges = [], statusChanges = [];

        for (const { rowNo, rowCheckIdRaw, key, rowStatus, rowVendor } of rowEntries) {
          const hits = recordsById.get(key) || [];
          if (hits.length === 1) {
            const record = hits[0].record;
            const existingStatus = getExistingStatus(record);
            const existingVendor = getExistingVendorName(record);
            const statusChanged = rowStatus && rowStatus !== existingStatus;
            const vendorChanged = rowVendor && rowVendor.toLowerCase() !== existingVendor.toLowerCase();

            if (statusChanged && statusChanges.length < 8) {
              statusChanges.push({ rowNo, from: existingStatus || "(none)", to: rowStatus });
            }
            if (vendorChanged && vendorChanges.length < 8) {
              vendorChanges.push({ rowNo, from: existingVendor || "(none)", to: rowVendor });
            }

            matched.push({
              rowNo, rowStatus, rowVendor, statusChanged, vendorChanged,
              record, dataIndex: hits[0].dataIndex,
            });
          } else if (hits.length === 0) {
            const ambCount = serverAmbiguousCounts.get(key);
            if (ambCount) {
              ambiguous.push({ rowNo, count: ambCount });
            } else {
              unmatched.push({ rowNo, preview: `Check Id: ${cleanVal(rowCheckIdRaw)}` });
            }
          } else {
            ambiguous.push({ rowNo, count: hits.length });
          }
        }

        const statusChangeCount = matched.filter((m) => m.statusChanged).length;
        const vendorChangeCount = matched.filter((m) => m.vendorChanged).length;

        setBulkUpdateModal({
          matched, unmatched, ambiguous, forceStatus: "",
          willUpdateStatus: statusColIdx !== -1,
          willUpdateVendor: vendorColIdx !== -1,
          statusChangeCount, vendorChangeCount, statusChanges, vendorChanges,
        });
      } catch (err) {
        alert(`❌ Failed to parse Excel: ${err.message}`);
      } finally {
        setBulkUpdateLoading(false);
      }
    };
    reader.readAsArrayBuffer(file);
  }, [data, serverPaginated, fetchBulkMatchFromServer]);

  /* ── Bulk Update by Excel — apply step ── */
  const handleBulkUpdateApply = useCallback(async () => {
    if (!bulkUpdateModal || !bulkUpdateModal.matched.length) { setBulkUpdateModal(null); return; }
    const { matched, unmatched, ambiguous, forceStatus, willUpdateStatus, willUpdateVendor } = bulkUpdateModal;

    // Same convention used elsewhere in this file (handleAppend's existing
    // vendor-change flow): any field name starting with "vendor" is treated
    // as a vendor field, both top-level and inside rawData.
    const isVendorHeader = (name = "") =>
      String(name || "").trim().toLowerCase().startsWith("vendor");

    const buildVendorPatch = (currentRow, newVendor) => {
      const patch = {};
      Object.keys(currentRow || {}).forEach((k) => { if (isVendorHeader(k)) patch[k] = newVendor; });
      Object.keys(currentRow?.rawData || {}).forEach((k) => { if (isVendorHeader(k)) patch[k] = newVendor; });
      // The record had no vendor-named field at all yet — still set the two
      // canonical names the rest of the app reads/displays vendor from.
      if (!Object.keys(patch).length) {
        patch["Vendor Company"] = newVendor;
        patch["Vendor Name"] = newVendor;
      }
      return patch;
    };

    const statusMap = {
      pending: "Pending", insuff: "Insuff", closed: "Closed",
      hold: "Hold", stop: "Stop", sent: "Sent",
    };
    const today = todayStr();

    const buildStatusPatch = (currentRow, targetStr) => {
      const statusKey = String(targetStr || "Pending").trim().toLowerCase();
      const nextStatus = statusMap[statusKey] || String(targetStr || "Pending").trim();
      const shouldClear = statusKey === "pending";

      const existingCD =
        currentRow["Completed Date"] || currentRow.completedDate || currentRow.closedDate ||
        currentRow.rawData?.["Completed Date"] || currentRow.rawData?.completedDate || currentRow.rawData?.closedDate || "";
      const cd = statusKey === "closed" && !existingCD ? today : shouldClear ? "" : existingCD;
      const completedDatePatch = shouldClear
        ? { "Completed Date": "", completedDate: "", closedDate: "" }
        : (cd ? { "Completed Date": cd, completedDate: cd, closedDate: cd } : {});

      const existingSD = currentRow["Stop Date"] || currentRow.stopDate ||
                         currentRow.rawData?.["Stop Date"] || currentRow.rawData?.stopDate || "";
      const sd = statusKey === "stop" && !existingSD ? today : existingSD;
      const stopDatePatch = statusKey === "stop" && sd ? { "Stop Date": sd, stopDate: sd } : {};

      const existingVCD = currentRow["Vendor Complete Date"] || currentRow.vendorCompleteDate ||
                          currentRow.rawData?.["Vendor Complete Date"] || currentRow.rawData?.vendorCompleteDate || "";
      const vcd = statusKey === "closed" && !existingVCD ? today : shouldClear ? "" : existingVCD;
      const vendorCompleteDatePatch = shouldClear
        ? { "Vendor Complete Date": "", vendorCompleteDate: "" }
        : (vcd ? { "Vendor Complete Date": vcd, vendorCompleteDate: vcd } : {});

      const accessPatch = makeAccessPatch(currentRow);
      const fullPatch = {
        ...accessPatch, Status: nextStatus, status: nextStatus,
        ...completedDatePatch, ...stopDatePatch, ...vendorCompleteDatePatch,
      };
      return { nextStatus, fullPatch };
    };

    // Mirrors onStatus's own rule (the single-row status dropdown, above):
    // for superadmin scope, a case can't be set to Closed until a report has
    // been uploaded for it. Bulk update must respect the same rule rather
    // than silently forcing cases closed that the normal UI would refuse.
    const isSuperScope =
      normalizeEmail(scopeAdmin) === normalizeEmail(SUPER_ADMIN_EMAIL) ||
      String(currentUser?.role || "").trim().toLowerCase() === "superadmin";
    const blockedByReportGate = (record) => {
      if (!isSuperScope) return false;
      const hasReport = Boolean(
        record?.reportUploaded || record?.reportFile ||
        record?.rawData?.reportUploaded || record?.rawData?.reportFile
      );
      return !hasReport;
    };

    // If the user picked an explicit override in the modal, that's a
    // deliberate "set everyone to X" action — apply to every matched row
    // regardless of per-row change detection. Otherwise (syncing from the
    // file's own Status column) only touch rows where the value actually
    // differs, per row — "if the value is the same, leave it".
    const skippedNoReport = [];
    const workItems = [];

    matched.forEach((m) => {
      let fullPatch = { ...makeAccessPatch(m.record) };
      let touchedAnything = false;

      const targetStatus = forceStatus || (willUpdateStatus ? m.rowStatus : "");
      const shouldApplyStatus = forceStatus ? true : (willUpdateStatus && m.statusChanged);
      if (shouldApplyStatus && targetStatus) {
        if (String(targetStatus).trim().toLowerCase() === "closed" && blockedByReportGate(m.record)) {
          skippedNoReport.push(m.rowNo);
        } else {
          const { fullPatch: statusPatch } = buildStatusPatch(m.record, targetStatus);
          fullPatch = { ...fullPatch, ...statusPatch };
          touchedAnything = true;
        }
      }

      if (willUpdateVendor && m.rowVendor && m.vendorChanged) {
        fullPatch = { ...fullPatch, ...buildVendorPatch(m.record, m.rowVendor) };
        touchedAnything = true;
      }

      if (touchedAnything) {
        workItems.push({ record: m.record, dataIndex: m.dataIndex, fullPatch });
      }
    });

    setBulkUpdateModal(null);

    // One optimistic state update for all rows
    setData(prevData => {
      if (!Array.isArray(prevData)) return prevData;
      const nd = [...prevData];
      workItems.forEach(({ record, dataIndex, fullPatch }) => {
        const mongoId = getRecordMongoId(record);
        let ti = mongoId
          ? prevData.findIndex((r) => getRecordMongoId(r) === mongoId)
          : dataIndex;
        if (ti < 0) ti = dataIndex;
        if (ti < 0 || !nd[ti]) return;
        nd[ti] = { ...nd[ti], ...fullPatch, rawData: { ...(nd[ti].rawData || {}), ...fullPatch } };
      });
      return nd;
    });

    // Update normRef in sync
    workItems.forEach(({ record, dataIndex, fullPatch }) => {
      const mongoId = getRecordMongoId(record);
      let ti = mongoId
        ? normRef.current.findIndex((r) => getRecordMongoId(r) === mongoId)
        : dataIndex;
      if (ti < 0) ti = dataIndex;
      if (ti >= 0 && normRef.current[ti]) {
        normRef.current[ti] = {
          ...normRef.current[ti], ...fullPatch,
          rawData: { ...(normRef.current[ti].rawData || {}), ...fullPatch },
        };
      }
    });
    if (statusFilter) triggerFilter();

    // Fire API calls, aggregate results
    showSaving();
    let updatedCount = 0, failedCount = 0;

    for (const { record, fullPatch } of workItems) {
      const recordId = getRecordMongoId(record);
      if (!recordId) { failedCount++; continue; }
      try {
        const serverRow = await uploadAPI.updateRecord(recordId, {
          ...fullPatch,
          rawData: { ...(record.rawData || {}), ...fullPatch },
        });
        updatedCount++;
        // Same "trust the server's confirmed save, not just the optimistic
        // guess" fix as the single-row status dropdown (onStatus, above).
        if (serverRow && typeof serverRow === "object") {
          setData(prev => {
            if (!Array.isArray(prev)) return prev;
            const nd = [...prev];
            const ti = prev.findIndex((r) => getRecordMongoId(r) === recordId);
            if (ti >= 0) nd[ti] = serverRow;
            return nd;
          });
          if (normRef.current) {
            const ti = normRef.current.findIndex((r) => getRecordMongoId(r) === recordId);
            if (ti >= 0) normRef.current[ti] = normalizeRow(serverRow);
          }
          if (serverPaginated) {
            setServerRows(prevRows => {
              if (!Array.isArray(prevRows)) return prevRows;
              const idx = prevRows.findIndex((r) => getRecordMongoId(r) === recordId);
              if (idx < 0) return prevRows;
              const nr = [...prevRows];
              nr[idx] = serverRow;
              return nr;
            });
          }
        }
      } catch {
        failedCount++;
        setData(prev => {
          if (!Array.isArray(prev)) return prev;
          const nd = [...prev];
          const ti = prev.findIndex((r) => getRecordMongoId(r) === recordId);
          if (ti >= 0) nd[ti] = record;
          return nd;
        });
      }
    }

    if (failedCount > 0) setDbStatus(null);
    else showSaved();

    const noChangeCount = matched.length - workItems.length - skippedNoReport.length;

    const skipLine = (unmatched.length + ambiguous.length) > 0
      ? `\n⚠️ ${unmatched.length} skipped (no match), ${ambiguous.length} skipped (ambiguous).`
      : "";
    const noChangeLine = noChangeCount > 0
      ? `\nℹ️ ${noChangeCount} matched row(s) already up to date — nothing to change.`
      : "";
    const reportGateLine = skippedNoReport.length > 0
      ? `\n🔒 ${skippedNoReport.length} row(s) skipped — Closed requires a report to be uploaded first (rows: ${skippedNoReport.slice(0, 10).join(", ")}${skippedNoReport.length > 10 ? "…" : ""}).`
      : "";
    const failLine = failedCount > 0 ? `\n❌ ${failedCount} failed and rolled back.` : "";
    alert(`✅ ${updatedCount} record(s) updated.${skipLine}${noChangeLine}${reportGateLine}${failLine}`);
  }, [bulkUpdateModal, data, setData, makeAccessPatch, normRef, statusFilter, triggerFilter, showSaving, showSaved, scopeAdmin, serverPaginated, setServerRows]);

  const ALLOWED = [
    "S.NO","Company Name","Check Id","Check Name","Sub Check Type",
    "Candidate Name","Candidate Father Name",
    "Candidate Phone Number","Candidate Alternative number",
    "Address","City","State","Pincode",
  ];

  const onWA = useCallback((row, ri) => {
    let msg = "📄 BGV Case Details:\n\n";
    ALLOWED.forEach(f => { if (row[f]) msg += `${f}: ${row[f]}\n`; });
    const tier = getRowTier(row);
    if (tier) msg += `Tier: ${tier}\n`;
    const nd  = [...data];
    const now = todayStr();
    const idx = resolveRowIndex(nd, ri, row);
    if (idx >= 0) {
      nd[idx] = { ...nd[idx], assignDate: nd[idx].assignDate || now };
      setData(nd);
      if (normRef.current[idx]) {
        normRef.current[idx] = { ...normRef.current[idx], assignDate: normRef.current[idx].assignDate || now };
      }
      triggerFilter();
      if (nd[idx]._id) {
        const accessPatch = makeAccessPatch(nd[idx]);
        uploadAPI.updateRecord(nd[idx]._id, { ...accessPatch, assignDate: nd[idx].assignDate || now, rawData:{...(nd[idx].rawData||{}), ...accessPatch, assignDate: nd[idx].assignDate || now} }).catch(() => {});
      }
    }
    if (row.agent?.match(/^[0-9]{10,}$/))
      window.open(`https://wa.me/91${row.agent}?text=${encodeURIComponent(msg)}`, "_blank");
    else
      window.open(`https://wa.me/?text=${encodeURIComponent(msg)}`, "_blank");
  }, [data, setData, triggerFilter, makeAccessPatch]);

  const onGmail = useCallback(async (row, ri) => {
    try {
      const recordId = getRecordMongoId(row);

      if (!recordId) {
        alert("❌ Record ID missing. Please refresh records and try again.");
        return;
      }

      const defaultEmail =
        row.Email || row.email || row["Email"] || row["Vendor Email"] ||
        row["Agent Email"] || row["Mail"] || row.mail || "";

      const to = window.prompt("Enter recipient email:", defaultEmail);
      if (!to) return;

      const cc = window.prompt(
        "Enter CC emails separated by comma (optional):",
        ""
      ) || "";

      const ok = window.confirm(
        "Send Excel + uploaded report directly through mail?"
      );
      if (!ok) return;

      const nd = [...data];
      const now = todayStr();
      const idx = resolveRowIndex(nd, ri, row);
      if (idx >= 0) {
        nd[idx] = { ...nd[idx], assignDate: nd[idx].assignDate || now };
        setData(nd);

        if (normRef.current[idx]) {
          normRef.current[idx] = {
            ...normRef.current[idx],
            assignDate: normRef.current[idx].assignDate || now,
          };
        }

        triggerFilter();

        if (nd[idx]._id) {
          const accessPatch = makeAccessPatch(nd[idx]);
          uploadAPI.updateRecord(nd[idx]._id, {
            ...accessPatch,
            assignDate: nd[idx].assignDate || now,
            rawData: {
              ...(nd[idx].rawData || {}),
              ...accessPatch,
              assignDate: nd[idx].assignDate || now,
            },
          }).catch(() => {});
        }
      }

      const token = getAuthToken();

      if (!token) {
        alert("❌ No login token found. Please logout and login again.");
        return;
      }

      const API_BASE =
        window.location.hostname === "localhost"
          ? "http://localhost:5002/api"
          : "https://profeix.info/api";

      // ── Pick which mail account to send from (if more than one is set up) ──
      // Fetches the current user's available mail accounts. If 2 or 3 exist,
      // the sender chooses one; otherwise it sends from the only/default one.
      let mailConfigId = "";
      try {
        const mcRes = await fetch(`${API_BASE}/upload/mail-configs`, {
          headers: { Authorization: `Bearer ${token}` },
        });
        const mcData = await mcRes.json().catch(() => ({}));
        const accounts = Array.isArray(mcData?.accounts) ? mcData.accounts : [];

        if (accounts.length > 1) {
          const listText = accounts
            .map((a, i) => `${i + 1}. ${a.label || a.fromName || a.smtpUser} (${a.smtpUser})`)
            .join("\n");
          const pick = window.prompt(
            `Send this report from which mail?\n\n${listText}\n\nEnter a number (1-${accounts.length}):`,
            "1"
          );
