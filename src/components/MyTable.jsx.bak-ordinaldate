        // For super admin, a row that matches an existing case on everything
        // EXCEPT the vendor is not imported as a new record. Instead it becomes
        // a candidate to REPLACE the vendor (and vendor pricing) on the existing
        // record after a single on-screen confirmation. Non-super-admin behavior
        // is completely unchanged (rowsToImport === uniqueExcelRows for them).
        const roleKeyUp = String(currentUser?.role || "").trim().toLowerCase();
        const isSuperAdminUpload =
          roleKeyUp === "superadmin" ||
          normalizeEmail(currentUser?.email) === normalizeEmail(SUPER_ADMIN_EMAIL);

        const isVendorHeader = (name = "") =>
          String(name || "").trim().toLowerCase().startsWith("vendor");
        const isAssignHeader = (name = "") =>
          String(name || "").trim().toLowerCase().includes("assign date");

        // Case identity = all duplicate-check columns EXCEPT vendor + assign date.
        const caseKeyColumns = excelColumnsForDuplicateCheck.filter(
          ({ name }) => !isVendorHeader(name) && !isAssignHeader(name)
        );

        const makeCaseKeyFromExcelRow = (row = []) =>
          caseKeyColumns
            .map(({ name, idx }) => {
              let value = row[idx];
              if (idx === clientColIndex) {
                const ec = value === undefined || value === null
                  ? ""
                  : String(value).replace(/\s+/g, " ").trim();
                value = manualClientMap.get(normalizeClientForMatch(ec)) || ec;
              }
              return `${name}::${clean(value)}`;
            })
            .join("||");

        const makeCaseKeyFromExistingRecord = (record = {}) =>
          caseKeyColumns
            .map(({ name }) => `${name}::${clean(getExistingValueForColumn(record, name))}`)
            .join("||");

