      ...cols.filter((col) =>
        !isBlockedExportColumn(col) &&
        !isExportPenaltyColumn(col) &&
        (showPricing || (col !== "Client Price" && col !== "Vendor Price"))
      ),
      ...(showPricing ? ["Vendor Company"] : []),
      "Vendor Complete Date",
      ...(showPricing && showVendorBlock ? ["Extra Approval"] : []),
    ];

    const exportHeaders = [...portalHeaders].filter(
      (col) => !isBlockedExportColumn(col) && !isExportPenaltyColumn(col)
    );

    // Add Assigned Date + Completed Date ONLY in Closed export
    const isClosedExport =
      String(statusFilter || "").toLowerCase().trim() === "closed" ||
      (rowsForExport.length > 0 && rowsForExport.every((row) => getRowStatus(row).toLowerCase().trim() === "closed"));

    if (isClosedExport) {
      if (!exportHeaders.includes("Assigned Date")) {
        exportHeaders.push("Assigned Date");
      }

      if (!exportHeaders.includes("Completed Date")) {
        exportHeaders.push("Completed Date");
      }
    }

    if (shouldAddPendingPenalty && !exportHeaders.includes("Penalty %")) {
      const monthIndex = exportHeaders.findIndex((h) => String(h).trim().toLowerCase() === "month");
      if (monthIndex >= 0) exportHeaders.splice(monthIndex + 1, 0, "Penalty %");
      else exportHeaders.push("Penalty %");
    }

    const getExportCellValue = (row, col, index) => {
      if (col === "S.NO") return index + 1;
      if (col === "Status") return getRowStatus(row);
      if (col === "Tier") return getRowTier(row) || "";
      if (col === "Client Price") {
        const { autoCP } = getCP(row);
        return autoCP ?? "";
      }
      if (col === "Vendor Price") {
        const { vPrice } = getVI(row);
        return vPrice ?? "";
      }
      if (col === "Vendor Company") {
        const { vName } = getVI(row);
        return vName || row["Vendor Company"] || row["Vendor Name"] || row["Vendor"] || row.rawData?.["Vendor Company"] || row.rawData?.["Vendor Name"] || row.rawData?.["Vendor"] || "";
      }
      if (col === "Extra Approval") {
        if (!row.extraApproved) return "";
        return row.extraAmount ? `Approved - ₹${row.extraAmount}` : "Approved";
      }
      if (col === "Assigned") {
        return toExportDate(row.assignDate || row.rawData?.assignDate || "");
      }
      if (col === "Assigned Date") {
        return toExportDate(
          row["Assigned Date"] ||
          row["Assign Date"] ||
          row.assignDate ||
          row.assignedDate ||
          row["Sent Date"] ||
          row.vendorSentDate ||
          row["Vendor Sent Date"] ||
          row["Vendor Assign Date"] ||
          row["Vendor Assigned Date"] ||
          row["Vendor Date"] ||
          row["Sent to Vendor"] ||
          row.rawData?.["Assigned Date"] ||
          row.rawData?.["Assign Date"] ||
          row.rawData?.assignDate ||
          row.rawData?.assignedDate ||
          row.rawData?.["Sent Date"] ||
          row.rawData?.vendorSentDate ||
          row.rawData?.["Vendor Sent Date"] ||
          row.rawData?.["Vendor Assign Date"] ||
          row.rawData?.["Vendor Assigned Date"] ||
          row.rawData?.["Vendor Date"] ||
          row.rawData?.["Sent to Vendor"] ||
          ""
        );
      }
      if (col === "Completed Date") {
        return toExportDate(
          row["Completed Date"] ||
          row["Complete Date"] ||
          row.completedDate ||
          row.closedDate ||
          row["Closed Date"] ||
          row["Vendor Close Date"] ||
          row.rawData?.["Completed Date"] ||
          row.rawData?.["Complete Date"] ||
          row.rawData?.completedDate ||
          row.rawData?.closedDate ||
          row.rawData?.["Closed Date"] ||
          row.rawData?.["Vendor Close Date"] ||
          ""
        );
      }
      if (isExportPenaltyColumn(col)) return getPendingPenaltyDays(row);

      let value = row[col];
      if ((value === undefined || value === null || value === "") && row.rawData && typeof row.rawData === "object") {
        value = row.rawData[col];
      }
      // Secondary admin's "full detail" export (buildSecondaryAdminHeaders,
      // below) includes every raw uploaded column, not just the curated
      // list super admin exports — so column-name-based date detection
      // (isExportDateColumn) can miss a genuine date whose header doesn't
      // match a recognized pattern. Route through toExportDate() whenever
      // EITHER the column name looks like a date column OR the value
      // itself looks like one (looksLikeDateString) OR it's a real Date
      // object (which XLSX would otherwise write as a native Excel date
      // cell, displayed per the viewer's own locale instead of the
      // DD-MM-YYYY text every other column uses) — regardless of column name.
      if (isExportDateColumn(col) || value instanceof Date || looksLikeDateString(value)) return toExportDate(value);
      return value ?? "";
    };

    // SAFE CHANGE: only secondary admin gets full-detail export columns.
    // Super admin export logic remains EXACTLY as before (uses exportHeaders).
    const roleKey = String(currentUser?.role || currentUser?.userRole || "")
      .trim()
      .toLowerCase();
    const emailKey = String(currentUser?.email || "").trim().toLowerCase();

    // Super admin is identified by role "superadmin" or the super admin email.
    // This guard guarantees the super admin NEVER takes the secondary-admin path.
    const isSuperAdminExport =
      roleKey === "superadmin" ||
      emailKey === String(SUPER_ADMIN_EMAIL).toLowerCase();

    // Any company/secondary admin (role "admin", and NOT the super admin) now
    // exports the full detail — every uploaded Excel column — including when a
    // status filter like Pending / Insuff / Sent / Closed is active.
    const isSecondaryAdminExport =
      !isSuperAdminExport &&
      [
        "admin",
        "secondary_admin",
        "secondaryadmin",
        "tenantadmin",
        "tenant_admin",
      ].includes(roleKey);

    // A TEAM member that belongs to a SECONDARY admin (NOT the super admin's
    // internal team) also gets the full-detail export. Their visible data is
    // already limited to their allocated client(s) upstream, so the exported
    // rows naturally contain only assigned-client data — no client filtering
    // is added here. Super admin and super-admin internal team are excluded,
    // so super admin logic is unchanged.
    const teamOwnerEmail = normalizeEmail(
      currentUser?.ownerAdminEmail || currentUser?.adminEmail || ""
    );
    const isInternalSuperTeam =
      currentUser?.isInternal === true ||
      (!currentUser?.tenantId && !currentUser?.ownerAdminEmail) ||
      teamOwnerEmail === normalizeEmail(SUPER_ADMIN_EMAIL);
    const isSecondaryAdminTeamExport =
      isTeam && !isInternalSuperTeam && !!teamOwnerEmail;

    const fullDetailExport = isSecondaryAdminExport || isSecondaryAdminTeamExport;

    const buildSecondaryAdminHeaders = (rows = []) => {
      const blocked = new Set([
        "rawData",
        "_realIdx",
        "__v",
        "pdfDataUrl",
        "reportFile",
        "_reportKey",
        "_hasReport",
        "tenantId",
        "ownerAdminEmail",
        "assignedByEmail",
        "updatedByEmail",
        "updatedByRole",
      ]);

      const headers = [];
      const pushHeader = (key) => {
        const clean = String(key || "").trim();
        if (!clean || blocked.has(clean)) return;
        if (!headers.some((h) => String(h).trim().toLowerCase() === clean.toLowerCase())) {
          headers.push(clean);
        }
      };

      // Keep normal visible/export headers first.
      exportHeaders.forEach(pushHeader);

      // Then add all uploaded Excel/raw fields for secondary admin full detail.
      rows.forEach((row) => {
        if (row?.rawData && typeof row.rawData === "object") {
          Object.keys(row.rawData).forEach(pushHeader);
        }
        Object.keys(row || {}).forEach(pushHeader);
      });

      if (!headers.some((h) => String(h).trim().toLowerCase() === "status")) {
        headers.push("Status");
      }
      return headers;
    };

    const finalExportHeaders = fullDetailExport
      ? buildSecondaryAdminHeaders(rowsForExport)
      : exportHeaders;

    const exportData = rowsForExport.map((row, index) => {
      const obj = {};
      finalExportHeaders.forEach((col) => {
        obj[col] = getExportCellValue(row, col, index);
      });
      return obj;
    });

    const ws = XLSX.utils.json_to_sheet(exportData, { header: finalExportHeaders });
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, selectedData.length ? "Selected" : "Filtered");

    const excelBuffer = XLSX.write(wb, { bookType: "xlsx", type: "array" });
    const blob = new Blob([excelBuffer], {
      type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8",
    });
    const safeStatus = statusFilter ? `_${String(statusFilter).replace(/[^a-z0-9_-]/gi, "_")}` : "";
    saveAs(selectedData.length ? blob : blob, selectedData.length ? "Selected.xlsx" : `Filtered${safeStatus}.xlsx`);
  }, [filteredData, selectedData, statusFilter, cols, showPricing, showVendorBlock, getCP, getVI, currentUser, isTeam, serverPaginated, fetchAllMatchingFilter]);

  const bulkSend = useCallback(async () => {
    const rowsToSend = selectedData.length
      ? selectedData
      : (serverPaginated ? await fetchAllMatchingFilter() : filteredData);
    if (!rowsToSend.length) return alert("No data to send");
    let msg = "📦 Bulk BGV Cases:\n\n";
    const nd  = [...data];
    const now = todayStr();
    rowsToSend.forEach((row, idx) => {
      msg += `Case ${idx + 1}:\n`;
      ALLOWED.forEach(f => { if (row[f] !== undefined) msg += `${f}: ${row[f]}\n`; });
      const t = getRowTier(row);
      if (t) msg += `Tier: ${t}\n`;
      msg += "\n-----------------\n";
      // Reference-equality lookup fails for rows freshly fetched via
      // fetchAllMatchingFilter (new objects, not the same reference as
      // anything in `data`) — resolveRowIndex falls back to an id match.
      const oi = resolveRowIndex(nd, -1, row);
      if (oi !== -1) {
        nd[oi] = { ...nd[oi], assignDate: nd[oi].assignDate || now };
        if (normRef.current[oi]) normRef.current[oi] = { ...normRef.current[oi], assignDate: normRef.current[oi].assignDate || now };
        if (nd[oi]._id) {
          const accessPatch = makeAccessPatch(nd[oi]);
          uploadAPI.updateRecord(nd[oi]._id, { ...accessPatch, assignDate: nd[oi].assignDate || now, rawData:{...(nd[oi].rawData||{}), ...accessPatch, assignDate: nd[oi].assignDate || now} }).catch(() => {});
        }
      }
    });
    setData(nd);
    triggerFilter();
    window.open(`https://wa.me/?text=${encodeURIComponent(msg)}`, "_blank");
  }, [filteredData, selectedData, data, setData, triggerFilter, makeAccessPatch, serverPaginated, fetchAllMatchingFilter]);

  const getRowEmail = useCallback((row = {}) => (
    row.Email || row.email || row["Email"] || row["Vendor Email"] ||
    row["Agent Email"] || row["Mail"] || row.mail || ""
  ), []);

  const buildMailBody = useCallback((row) => {
    let msg = "BGV Case Details:\n\n";
    ALLOWED.forEach(f => { if (row[f]) msg += `${f}: ${row[f]}\n`; });
    const tier = getRowTier(row);
    if (tier) msg += `Tier: ${tier}\n`;
    return msg;
  }, []);

  const buildBulkMailBody = useCallback((rows = []) => {
    let msg = "BGV Filtered Case Details:\n\n";
    rows.forEach((row, idx) => {
      msg += `Case ${idx + 1}:\n`;
      ALLOWED.forEach(f => { if (row[f]) msg += `${f}: ${row[f]}\n`; });
      const tier = getRowTier(row);
      if (tier) msg += `Tier: ${tier}\n`;
      msg += "\n-----------------\n";
    });
    return msg;
  }, []);

  const markFilteredAssigned = useCallback((sel) => {
    const now = todayStr();
    const updated = data.map((r, ri) => {
      const matched = sel.some(row => (row === r) || ((row._id || row.id) && (row._id || row.id) === (r._id || r.id)));
      if (!matched) return r;
      if (normRef.current[ri]) normRef.current[ri] = { ...normRef.current[ri], assignDate: normRef.current[ri].assignDate || now };
      if (r._id) {
        const accessPatch = makeAccessPatch(r);
        uploadAPI.updateRecord(r._id, { ...accessPatch, assignDate: r.assignDate || now, rawData:{...(r.rawData||{}), ...accessPatch, assignDate: r.assignDate || now} }).catch(() => {});
      }
      return { ...r, assignDate: r.assignDate || now };
    });
    setData(updated);
    triggerFilter();
  }, [data, setData, triggerFilter, makeAccessPatch]);

  const sendBulkGmail = useCallback(async () => {
    const sel = selectedData.length
      ? selectedData
      : (serverPaginated ? await fetchAllMatchingFilter() : filteredData);
    if (!sel.length) { alert("No filtered rows to send"); return; }

    const ok = window.confirm(`Open Gmail compose for ${sel.length} filtered case(s)?`);
    if (!ok) return;

    const subj = `BGV Filtered Cases - ${sel.length} Case(s)`;
    const body = buildBulkMailBody(sel);

    markFilteredAssigned(sel);

    window.open(
      `https://mail.google.com/mail/?view=cm&fs=1&su=${encodeURIComponent(subj)}&body=${encodeURIComponent(body)}`,
      "_blank"
    );
  }, [filteredData, selectedData, buildBulkMailBody, markFilteredAssigned, serverPaginated, fetchAllMatchingFilter]);

  const sendBulkHostingerMail = useCallback(async () => {
    const sel = selectedData.length
      ? selectedData
      : (serverPaginated ? await fetchAllMatchingFilter() : filteredData);
    if (!sel.length) { alert("No filtered rows to send"); return; }

    const ok = window.confirm(`Open Hostinger webmail for ${sel.length} filtered case(s)?\n\nThe filtered case details will be copied so you can paste and send from Hostinger.`);
    if (!ok) return;

    const subj = `BGV Filtered Cases - ${sel.length} Case(s)`;
    const body = buildBulkMailBody(sel);
    const copyText = `Subject: ${subj}\n\n${body}`;

    try {
      if (navigator?.clipboard?.writeText) {
        await navigator.clipboard.writeText(copyText);
        alert("✅ Filtered case details copied. Hostinger mail page will open now — paste and send.");
      }
    } catch (_) {}

    markFilteredAssigned(sel);
    window.open("https://mail.hostinger.com/", "_blank");
  }, [filteredData, selectedData, buildBulkMailBody, markFilteredAssigned, serverPaginated, fetchAllMatchingFilter]);

  const handleBulkStatusUpdate = useCallback((nextStatus) => {
    const sel = selectedData;
    if (!sel.length) { alert("Please select cases first."); return; }
    const ok = window.confirm(`Update ${sel.length} selected case(s) to ${nextStatus}?`);
    if (!ok) return;
    // skipReportGate: bulk status change is allowed to set Closed without a
    // report on file — deliberately different from the per-row dropdown,
    // which still requires one. Doesn't touch the auto-close-on-report-upload
    // behavior elsewhere, only this one bulk action.
    sel.forEach(row => onStatus(row?._realIdx, nextStatus, row, { skipReportGate: true }));
  }, [selectedData, onStatus]);

  const handleBulkDeleteSelected = useCallback(async () => {
    if (isTeam) return;
    const sel = selectedData;
    if (!sel.length) { alert("Please select cases first."); return; }

    const ok = window.confirm(`⚠️ Permanently delete ${sel.length} selected case(s)?\n\nThis cannot be undone.`);
    if (!ok) return;

    showSaving();
    const failed = [];
    const idsToDelete = [];

    for (const row of sel) {
      const recordId = getRecordMongoId(row);
      if (!recordId) {
        idsToDelete.push(getRowSelectionKey(row, row?._realIdx));
        continue;
      }
      try {
        if (typeof uploadAPI.deleteRecord === "function") {
          await uploadAPI.deleteRecord(recordId);
        } else if (typeof uploadAPI.removeRecord === "function") {
          await uploadAPI.removeRecord(recordId);
        } else {
          const token = getAuthToken();
          const API_BASE =
            window.location.hostname === "localhost"
              ? "http://localhost:5002/api"
              : "https://profeix.info/api";
          const res = await fetch(`${API_BASE}/upload/records/${encodeURIComponent(recordId)}`, {
            method: "DELETE",
            headers: token ? { Authorization: `Bearer ${token}` } : {},
          });
          if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            throw new Error(errData.error || errData.message || `Delete failed (${res.status})`);
          }
        }
        idsToDelete.push(`id:${recordId}`);
      } catch (err) {
        failed.push(recordId || getRowSelectionKey(row, row?._realIdx));
      }
    }

    if (idsToDelete.length) {
      const deleteSet = new Set(idsToDelete);
      setData(prev => (Array.isArray(prev) ? prev.filter((row, idx) => {
        const id = getRecordMongoId(row);
        const key = id ? `id:${id}` : getRowSelectionKey(row, idx);
        return !deleteSet.has(key);
      }) : prev));
      setSelectedRowKeys(prev => {
        const next = new Set(prev);
        idsToDelete.forEach(k => next.delete(k));
        return next;
      });
      triggerFilter();
    }

    if (failed.length) {
      setDbStatus(null);
      alert(`❌ Some selected records were not deleted. Failed: ${failed.length}`);
      return;
    }

    showSaved();
    alert(`✅ ${idsToDelete.length} selected record(s) deleted permanently.`);
  }, [isTeam, selectedData, setData, showSaving, showSaved, triggerFilter]);

  const sfKey   = statusFilter ? statusFilter.toLowerCase().trim() : null;
  const sfStyle = sfKey ? (STATUS_STYLE[sfKey] || STATUS_STYLE["pending"]) : null;

  const handleAddRow = useCallback(async () => {
    const newRow = { Status:"Pending", status:"Pending", assignDate:"" };
    showSaving();
    try {
      const saved = await uploadAPI.addRecord(newRow);
      setData(prev => [...prev, {
        ...newRow,
        _id: saved._id || saved.id,
        ...(saved.clientName ? { clientName: saved.clientName, "Client Name": saved.clientName } : {}),
      }]);
      showSaved();
    } catch (err) {
      console.warn("Add row:", err.message);
      setData(prev => [...prev, newRow]);
      setDbStatus(null);
    }
  }, [setData, showSaving, showSaved]);

  const handleToggleInsuff = useCallback(() => {
    setShowInsuff(v => {
      const next = !v;
      if (!next) setShowInsuffClear(false);
      return next;
    });
  }, []);

  const handleToggleInsuffClear = useCallback(() => {
    if (!showInsuff) return;
    setShowInsuffClear(v => !v);
  }, [showInsuff]);

  /* ═══════════════════════ RENDER ═══════════════════════ */
  return (
    <div className="tbl-root" spellCheck={false}
      style={{padding:"28px 24px 10px 24px",gap:16,display:"flex",flexDirection:"column",position:"relative",zIndex:1}}>

      {insuffToast && (
        <div className="insuff-toast">
          ⚠️ Insuff selected — detail columns expanded
        </div>
      )}

      {modal && (
        <ReportModal
          row={modal.row}
          onClose={() => !generating && setModal(null)}
          onGenerate={onGenerateReport}
          generating={generating}
        />
      )}

      {selectedRowKeys.size > 0 && (
        <div className="bulk-bar">
          <span className="bulk-bar-title">✅ Selected: {selectedData.length} case(s)</span>
          <select
            className="bulk-status-select"
            defaultValue=""
            onChange={(e) => {
              const v = e.target.value;
              e.target.value = "";
              if (v) handleBulkStatusUpdate(v);
            }}
          >
            <option value="">Bulk Status</option>
            <option value="Pending">Pending</option>
            <option value="Insuff">Insuff</option>
            {showInsuffClearOption && <option value="Insuff Clear">Insuff Clear</option>}
            <option value="Closed">Closed</option>
            <option value="Hold">Hold</option>
            <option value="Stop">Stop</option>
            <option value="Sent">Sent</option>
          </select>
          <button className="btn btn-dark" onClick={bulkSend}>📲 Bulk Whatsapp</button>
          <button className="send-btn" onClick={sendBulkGmail}>📧 Bulk Gmail</button>
          <button className="send-btn" onClick={sendBulkHostingerMail}>✉️ Hostinger Mail</button>
          <button className="btn btn-success" onClick={downloadExcel}>↓ Export Selected</button>
          {!isTeam && (
            <button
              className="btn btn-dark"
              onClick={handleBulkDeleteSelected}
              style={{ background:"linear-gradient(135deg,#ef4444,#f87171)", color:"#fff" }}
            >
              🗑 Delete Selected
            </button>
          )}
          <button className="btn btn-ghost" onClick={() => setSelectedRowKeys(new Set())}>✕ Clear Selection</button>
        </div>
      )}

      {/* ── Bulk Update by Excel — preview modal ── */}
      {bulkUpdateModal && (
        <div style={{position:"fixed",inset:0,background:"rgba(0,0,0,0.55)",zIndex:9999,display:"flex",alignItems:"center",justifyContent:"center",padding:16}}>
          <div style={{background:"#fff",borderRadius:14,padding:28,maxWidth:520,width:"100%",boxShadow:"0 8px 40px rgba(0,0,0,0.22)",maxHeight:"80vh",overflowY:"auto"}}>
            <h3 style={{margin:"0 0 16px",fontSize:17,fontWeight:700,color:"#1e293b"}}>🔄 Bulk Update Preview</h3>

            <div style={{marginBottom:16}}>
              <label style={{fontSize:13,fontWeight:600,color:"#475569",display:"block",marginBottom:6}}>Override status for ALL matched rows:</label>
              <select
                value={bulkUpdateModal.forceStatus}
                onChange={(e) => setBulkUpdateModal(prev => ({...prev, forceStatus: e.target.value}))}
                style={{width:"100%",padding:"8px 12px",borderRadius:8,border:"1px solid #cbd5e1",fontSize:13}}
              >
                <option value="">— Use each row's own Status column —</option>
                <option value="Pending">Pending</option>
                <option value="Insuff">Insuff</option>
                {showInsuffClearOption && <option value="Insuff Clear">Insuff Clear</option>}
                <option value="Closed">Closed</option>
                <option value="Hold">Hold</option>
                <option value="Stop">Stop</option>
                <option value="Sent">Sent</option>
              </select>
            </div>

            <div style={{background:"#f8fafc",borderRadius:10,padding:"14px 16px",marginBottom:16,fontSize:13,lineHeight:1.8}}>
              <div style={{color:"#16a34a",fontWeight:700}}>✅ {bulkUpdateModal.matched.length} rows matched by Check Id</div>
              {bulkUpdateModal.willUpdateVendor && (
                <div style={{color:"#334155",fontWeight:600}}>
                  🏢 {bulkUpdateModal.vendorChangeCount || 0} row(s) will change Vendor
                </div>
              )}
              {(bulkUpdateModal.willUpdateStatus || bulkUpdateModal.forceStatus) && (
                <div style={{color:"#334155",fontWeight:600}}>
                  🔄 {bulkUpdateModal.forceStatus
                    ? `${bulkUpdateModal.matched.length} row(s) forced to Status "${bulkUpdateModal.forceStatus}"`
                    : `${bulkUpdateModal.statusChangeCount || 0} row(s) will change Status`}
                </div>
              )}
              <div style={{color:"#dc2626",fontWeight:600}}>❌ {bulkUpdateModal.unmatched.length} rows — no match found (will skip)</div>
              <div style={{color:"#d97706",fontWeight:600}}>[⚠] {bulkUpdateModal.ambiguous.length} rows — multiple matches found (will skip)</div>
            </div>

            {bulkUpdateModal.willUpdateVendor && bulkUpdateModal.vendorChanges?.length > 0 && (
              <div style={{marginBottom:12}}>
                <div style={{fontSize:12,fontWeight:700,color:"#0891b2",marginBottom:4}}>Vendor changes (first 8):</div>
                <div style={{background:"#ecfeff",borderRadius:8,padding:"8px 12px",fontSize:11,color:"#155e75",lineHeight:1.8,fontFamily:"monospace"}}>
                  {bulkUpdateModal.vendorChanges.map((c) => <div key={c.rowNo}>Row {c.rowNo}: {c.from} → {c.to}</div>)}
                  {(bulkUpdateModal.vendorChangeCount || 0) > bulkUpdateModal.vendorChanges.length && (
                    <div>…and {bulkUpdateModal.vendorChangeCount - bulkUpdateModal.vendorChanges.length} more</div>
                  )}
                </div>
              </div>
            )}

            {!bulkUpdateModal.forceStatus && bulkUpdateModal.willUpdateStatus && bulkUpdateModal.statusChanges?.length > 0 && (
              <div style={{marginBottom:12}}>
                <div style={{fontSize:12,fontWeight:700,color:"#7c3aed",marginBottom:4}}>Status changes (first 8):</div>
                <div style={{background:"#f5f3ff",borderRadius:8,padding:"8px 12px",fontSize:11,color:"#4c1d95",lineHeight:1.8,fontFamily:"monospace"}}>
                  {bulkUpdateModal.statusChanges.map((c) => <div key={c.rowNo}>Row {c.rowNo}: {c.from} → {c.to}</div>)}
                  {(bulkUpdateModal.statusChangeCount || 0) > bulkUpdateModal.statusChanges.length && (
                    <div>…and {bulkUpdateModal.statusChangeCount - bulkUpdateModal.statusChanges.length} more</div>
                  )}
                </div>
              </div>
            )}

            {bulkUpdateModal.unmatched.length > 0 && (
              <div style={{marginBottom:12}}>
                <div style={{fontSize:12,fontWeight:700,color:"#ef4444",marginBottom:4}}>Unmatched rows (first 8):</div>
                <div style={{background:"#fef2f2",borderRadius:8,padding:"8px 12px",fontSize:11,color:"#7f1d1d",lineHeight:1.8,fontFamily:"monospace"}}>
                  {bulkUpdateModal.unmatched.slice(0,8).map((r) => <div key={r.rowNo}>Row {r.rowNo}: {r.preview}</div>)}
                  {bulkUpdateModal.unmatched.length > 8 && <div>…and {bulkUpdateModal.unmatched.length - 8} more</div>}
                </div>
              </div>
            )}

            {bulkUpdateModal.ambiguous.length > 0 && (
              <div style={{marginBottom:12}}>
                <div style={{fontSize:12,fontWeight:700,color:"#d97706",marginBottom:4}}>Ambiguous rows (first 8):</div>
                <div style={{background:"#fffbeb",borderRadius:8,padding:"8px 12px",fontSize:11,color:"#78350f",lineHeight:1.8,fontFamily:"monospace"}}>
                  {bulkUpdateModal.ambiguous.slice(0,8).map((r) => <div key={r.rowNo}>Row {r.rowNo}: matched {r.count} records</div>)}
                  {bulkUpdateModal.ambiguous.length > 8 && <div>…and {bulkUpdateModal.ambiguous.length - 8} more</div>}
                </div>
              </div>
            )}

            <div style={{display:"flex",gap:10,justifyContent:"flex-end",marginTop:18}}>
              <button onClick={() => setBulkUpdateModal(null)} style={{padding:"8px 20px",borderRadius:8,border:"1px solid #cbd5e1",background:"#f8fafc",fontSize:13,cursor:"pointer",fontWeight:600}}>
                Cancel
              </button>
              <button
                onClick={handleBulkUpdateApply}
                disabled={bulkUpdateModal.matched.length === 0}
                style={{padding:"8px 20px",borderRadius:8,border:"none",background:bulkUpdateModal.matched.length===0?"#94a3b8":"#6366f1",color:"#fff",fontSize:13,cursor:bulkUpdateModal.matched.length===0?"not-allowed":"pointer",fontWeight:700}}
              >
                Apply {bulkUpdateModal.matched.length} Update{bulkUpdateModal.matched.length !== 1 ? "s" : ""}
              </button>
            </div>
          </div>
        </div>
      )}

      {/* Header */}
      <div className="tbl-page-header">
        <div>
          <div className="tbl-page-title">BGV Case Manager</div>
          <div className="tbl-page-sub">
            <span className="tbl-live-dot" />
            {serverPaginated
              ? <>{displayTotalRows.toLocaleString()} total · {pagedData.length.toLocaleString()} shown (page {page} of {totalPages})</>
              : <>{data.length.toLocaleString()} total · {displayTotalRows.toLocaleString()} shown</>}
            {isFiltering && (
              <span style={{fontSize:11,color:"var(--accent)",fontFamily:"var(--head)",fontWeight:600}}>⚡ Filtering…</span>
            )}
            {statusFilter && sfStyle && (
              <span className="active-filter-badge"
                style={{background:sfStyle.bg,border:`1px solid ${sfStyle.border}`,color:sfStyle.color}}>
                🔍 {statusFilter} · {displayTotalRows} rows
              </span>
            )}
            {tierFilter !== "All" && TIER_STYLE[tierFilter] && (
              <span className="active-filter-badge"
                style={{background:TIER_STYLE[tierFilter].bg,border:`1px solid ${TIER_STYLE[tierFilter].border}`,color:TIER_STYLE[tierFilter].color}}>
                📍 {tierFilter} · {(serverPaginated ? pagedData.length : filteredData.length)} rows{serverPaginated ? " on this page" : ""}
              </span>
            )}
            {showInsuff && (
              <span style={{display:"inline-flex",alignItems:"center",gap:4,background:"rgba(124,58,237,0.09)",border:"1px solid rgba(124,58,237,0.25)",color:"#6d28d9",fontSize:10.5,fontWeight:700,fontFamily:"var(--head)",padding:"3px 10px",borderRadius:99}}>
                ⚠️ Insuff columns open
              </span>
            )}
            {showInsuff && showInsuffClear && (
              <span style={{display:"inline-flex",alignItems:"center",gap:4,background:"rgba(168,85,247,0.09)",border:"1px solid rgba(168,85,247,0.28)",color:"#a855f7",fontSize:10.5,fontWeight:700,fontFamily:"var(--head)",padding:"3px 10px",borderRadius:99}}>
                🗓 Insuff Clear columns open
              </span>
            )}
            {dbStatus === "saving" && (
              <span className="db-saving"><span className="db-saving-spin" />Saving…</span>
            )}
            {dbStatus === "saved" && <span className="db-saved">✓ Saved to DB</span>}
            <span className="worker-badge">⚡ Web Worker</span>
            {isTeam && <span className="team-badge">👤 Team View</span>}
          </div>
        </div>
        <div className="tbl-hdr-btns">
          <label className="btn btn-accent" style={{cursor:"pointer",margin:0,padding:"9px 18px"}}>
            <span style={{fontSize:13,marginRight:5}}>➕</span> Upload Daily Excel
            <input type="file" accept=".xlsx,.xls" style={{display:"none"}} onChange={handleAppend} />
          </label>
          <label style={{cursor: bulkUpdateLoading ? "wait" : "pointer",margin:0,padding:"9px 18px",borderRadius:8,border:"1.5px solid #6366f1",color:"#6366f1",fontWeight:700,fontSize:13,display:"inline-flex",alignItems:"center",gap:6,background:"transparent",whiteSpace:"nowrap",opacity:bulkUpdateLoading?0.6:1}}>
            {bulkUpdateLoading ? <>⏳ Loading records to match…</> : <>🔄 Bulk Update by Excel</>}
            <input type="file" accept=".xlsx,.xls" disabled={bulkUpdateLoading} style={{display:"none"}} onChange={handleBulkUpdateParse} />
          </label>
          <button className="btn btn-success" onClick={downloadExcel} disabled={exportLoading} style={exportLoading ? {opacity:0.6,cursor:"wait"} : undefined}>
            {exportLoading ? `⏳ Exporting… ${exportProgress ? `(${exportProgress.toLocaleString()} loaded)` : ""}` : "↓ Export Excel"}
          </button>
          <button
            className={editMode ? "btn btn-success" : "btn btn-ghost"}
            onClick={() => setEditMode(v => !v)}
            title={editMode ? "Lock table editing" : "Enable table editing"}
          >
            {editMode ? "🔒 Lock Edit" : "✏️ Edit"}
          </button>
          <button className="btn btn-dark" onClick={bulkSend}>📲 Bulk Whatsapp</button>
          <button className="send-btn" onClick={sendBulkGmail}>📧 Bulk Gmail</button>
          <button className="send-btn" onClick={sendBulkHostingerMail}>✉️ Hostinger Mail</button>
        </div>
      </div>

      {/* Filter card */}
      <div className="card">
        <div className="card-header">
          <div className="card-header-icon icon-blue">⚡</div>
          <div className="card-title">
            Filter & Search
            <span className="row-count">{displayTotalRows.toLocaleString()} rows</span>
          </div>

          <div className="toggle-btn-group">
            <button
              onClick={handleToggleInsuff}
              style={{
                fontFamily:"var(--head)",fontSize:12,fontWeight:700,
                padding:"5px 14px",borderRadius:99,cursor:"pointer",transition:"all 0.15s",
                border: showInsuff ? "1px solid rgba(124,58,237,0.55)" : "1px dashed rgba(124,58,237,0.30)",
                background: showInsuff ? "linear-gradient(135deg,rgba(124,58,237,0.14),rgba(139,92,246,0.10))" : "transparent",
                color:"#7c3aed",display:"inline-flex",alignItems:"center",gap:6,
              }}>
              {showInsuff ? "◀️ Hide Insuff Columns" : "▶️ Show Insuff Columns"}
            </button>

            <button
              onClick={handleToggleInsuffClear}
              title={!showInsuff ? "Open Insuff Columns first" : ""}
              style={{
                fontFamily:"var(--head)",fontSize:12,fontWeight:700,
                padding:"5px 14px",borderRadius:99,
                cursor: showInsuff ? "pointer" : "not-allowed",
                transition:"all 0.15s",
                opacity: showInsuff ? 1 : 0.38,
                border: showInsuffClear ? "1px solid rgba(168,85,247,0.65)" : "1px dashed rgba(168,85,247,0.35)",
                background: showInsuffClear ? "linear-gradient(135deg,rgba(168,85,247,0.16),rgba(192,132,252,0.10))" : "transparent",
                color:"#a855f7",display:"inline-flex",alignItems:"center",gap:6,
              }}>
              {showInsuffClear ? "◀️ Hide Insuff Clear" : "▶️ Show Insuff Clear"}
            </button>

            <button
              onClick={() => setShowVendorBlock(v => !v)}
              style={{
                fontFamily:"var(--head)",fontSize:12,fontWeight:700,
                padding:"5px 14px",borderRadius:99,cursor:"pointer",transition:"all 0.15s",
                border: showVendorBlock ? "1px solid rgba(37,99,235,0.45)" : "1px dashed rgba(37,99,235,0.30)",
                background: showVendorBlock ? "linear-gradient(135deg,rgba(37,99,235,0.12),rgba(6,182,212,0.08))" : "transparent",
                color:"var(--accent)",display:"inline-flex",alignItems:"center",gap:6,
              }}>
              {showVendorBlock ? "◀️ Hide Pricing & Vendor" : "▶️ Show Pricing & Vendor"}
            </button>
          </div>
        </div>

        <div className="card-body">
          <div className="action-row">
            <div className="srch-wrap">
              <span className="srch-ico">🔍</span>
              <input className="tbl-input" placeholder="Smart Search…"
                value={search} onChange={e => setSearch(e.target.value)}
                style={{paddingLeft:34, width:220}} />
            </div>
            <div className="act-div" />
            <select className="tbl-input" value={column} onChange={e => setColumn(e.target.value)}>
              <option value="">Column</option>
              {ALL_FILTER_COLS.map((c, i) => <option key={i}>{c}</option>)}
            </select>
            <select className="tbl-input" value={condition} onChange={e => setCondition(e.target.value)}>
              <option value="contains">Contains</option>
              <option value="equals">Equals</option>
              <option value="starts">Starts with</option>
              <option value="ends">Ends with</option>
              <option value="gt">Greater than</option>
              <option value="lt">Less than</option>
            </select>
            <input className="tbl-input" placeholder="Value"
              value={value} onChange={e => setValue(e.target.value)} style={{width:140}} />
            <button className="btn btn-accent" onClick={() => {
              if (!column || !value) return;
              setFilters([...filters, {column, condition, value}]);
              setColumn(""); setValue("");
            }}>
              + Add Filter
            </button>
            <div className="act-div" />
            <select className="tbl-input" value={logic} onChange={e => setLogic(e.target.value)} style={{width:80}}>
              <option value="AND">AND</option>
              <option value="OR">OR</option>
            </select>
            <button className="btn btn-ghost" onClick={() => setFilters([])}>✕ Clear</button>
            {!isTeam && (
              <button
                className="btn btn-dark"
                onClick={handleDeleteFiltered}
                disabled={!displayTotalRows}
                title="Delete all currently filtered records permanently"
                style={{
                  background: "linear-gradient(135deg,#ef4444,#f87171)",
                  color: "#fff",
                  opacity: displayTotalRows ? 1 : 0.45,
                  cursor: displayTotalRows ? "pointer" : "not-allowed",
                }}
              >
                🗑 Delete Filtered ({displayTotalRows})
              </button>
            )}
          </div>
          {filters.length > 0 && (
            <div style={{display:"flex",flexWrap:"wrap",gap:8,marginTop:14}}>
              {filters.map((f, i) => (
                <span key={i} className="filter-chip">
                  {f.column} {f.condition} "{f.value}"
                </span>
              ))}
            </div>
          )}
        </div>
      </div>

      {/* Table */}
      <div style={{display:"flex",flexDirection:"column",width:"100%",height:"550px",border:"1.5px solid var(--border2)",borderRadius:"var(--radius)",boxShadow:"0 8px 40px rgba(37,99,235,0.10)",overflow:"hidden"}}>
        {pagedData.length === 0 ? (
          <div style={{flex:1, overflow:"auto"}}>
            <table style={{width:"100%",borderCollapse:"separate",borderSpacing:0}}>
              <THead
                cols={displayCols}
                showPricing={showPricing}
                showVendorBlock={showVendorBlock}
                onToggleVendor={() => setShowVendorBlock(v => !v)}
                showInsuff={showInsuff}
                onToggleInsuff={handleToggleInsuff}
                showInsuffClear={showInsuffClear}
                onToggleInsuffClear={handleToggleInsuffClear}
                showDeleteCol={!isTeam}
                isSuperAdmin={isSA}
                selectable={true}
                allVisibleSelected={allVisibleSelected}
                selectedCount={selectedData.length}
                onSelectAllVisible={handleSelectAllVisible}
              />
              <tbody>
                <tr>
                  <td colSpan={displayCols.length + 4 + (showPricing ? 1 : 0) + (showPricing && showVendorBlock ? 1 : 0)} className="tbl-td">
                    <div className="empty-state">
                      <div className="empty-icon">{statusFilter || tierFilter !== "All" ? "🔎" : "🔍"}</div>
                      <div>
                        {(isFiltering || (serverPaginated && serverLoading))
                          ? "Loading…"
                          : tierFilter !== "All"
                            ? `No ${tierFilter} cases found.`
                            : statusFilter
                              ? `No "${statusFilter}" records found.`
                              : "No records match your filters."}
                      </div>
                    </div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        ) : (
          <VirtScroller
            rows={pagedData} cols={displayCols} showPricing={showPricing}
            getCP={getCP} getVI={getVI}
            onBlur={onBlur}
            onStatus={onStatus} onWA={onWA} onGmail={onGmail}
            onOpenModal={onOpenModal} onViewReport={onViewReport}
            getReport={getReport}
            showVendorBlock={showVendorBlock}
            onToggleVendor={() => setShowVendorBlock(v => !v)}
            showInsuff={showInsuff}
            onToggleInsuff={handleToggleInsuff}
            showInsuffClear={showInsuffClear}
            onToggleInsuffClear={handleToggleInsuffClear}
            editMode={editMode}
            rptRefresh={rptRefresh}
            onExtraApproval={onExtraApproval}
            onSpecialCase={isSA ? onSpecialCase : undefined}
            isSuperAdmin={isSA}
            onDeleteRow={isTeam ? undefined : onDeleteRow}
            onSendToClient={(isTeam && !isInternalSuperTeam) ? undefined : onSendToClient}
            selectable={true}
            selectedIds={selectedRowKeys}
            onSelectRow={handleSelectRow}
            allVisibleSelected={allVisibleSelected}
            selectedCount={selectedData.length}
            onSelectAllVisible={handleSelectAllVisible}
            showInsuffClearOption={showInsuffClearOption}
          />
        )}
      </div>

      {/* Pagination */}
      <div
        style={{
          display: "flex",
          justifyContent: "space-between",
          alignItems: "center",
          gap: 12,
          flexWrap: "wrap",
          marginTop: 14,
          marginBottom: 4,
        }}
      >
        <div
          style={{
            fontFamily: "var(--head)",
            fontSize: 12,
            color: "var(--text3)",
            fontWeight: 600,
          }}
        >
          Showing {displayTotalRows === 0 ? 0 : (page - 1) * PAGE_SIZE + 1}
          {" - "}
          {Math.min(page * PAGE_SIZE, displayTotalRows)}
          {" of "}
          {displayTotalRows} records
        </div>

        <div style={{ display: "flex", alignItems: "center", gap: 8, flexWrap: "wrap" }}>
          <button
            className="btn btn-ghost"
            onClick={() => setPage(p => Math.max(1, p - 1))}
            disabled={page === 1}
            style={{ opacity: page === 1 ? 0.5 : 1 }}
          >
            ← Prev
          </button>

          <span
            style={{
              fontFamily: "var(--head)",
              fontSize: 12,
              fontWeight: 700,
              color: "var(--text2)",
              minWidth: 90,
              textAlign: "center",
            }}
          >
            Page {page} / {totalPages}
          </span>

          <button
            className="btn btn-ghost"
            onClick={() => setPage(p => Math.min(totalPages, p + 1))}
            disabled={page === totalPages}
            style={{ opacity: page === totalPages ? 0.5 : 1 }}
          >
            Next →
          </button>
        </div>
      </div>

      {/* Add row */}
      <div style={{display:"flex",justifyContent:"center",marginTop:16}}>
        <button className="btn btn-ghost" onClick={handleAddRow}
          style={{background:"var(--card)",borderRadius:"99px",padding:"8px 24px",boxShadow:"var(--shadow-sm)"}}>
          + Add Row
        </button>
      </div>
    </div>
  );
}
