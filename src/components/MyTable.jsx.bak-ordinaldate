/* ─────────────────────────── STATUS BADGE ───────────────────────────────── */
function StatusBadge({ status }) {
  const s   = (status || "Pending").toLowerCase().trim();
  const cls = s==="sent"?"badge-sent":s==="closed"?"badge-closed":s==="insuff clear"?"badge-insuffclear":s==="insuff"?"badge-insuff":s==="hold"?"badge-hold":s==="stop"?"badge-stop":"badge-pending";
  return <span className={`badge ${cls}`}>{status || "Pending"}</span>;
}

function TierBadge({ tier }) {
  if (!tier) return <span className="tbl-tier-none">—</span>;
  const s = TIER_STYLE[tier] || TIER_STYLE.Tier3;
  return (
    <span className="tbl-tier-badge"
      style={{ background: s.bg, border: `1px solid ${s.border}`, color: s.color }}>
      {tier}
    </span>
  );
}

const STATUS_STYLE = {
  sent:   { color:"#059669", bg:"rgba(16,185,129,0.12)", border:"rgba(16,185,129,0.3)" },
  closed: { color:"#0d9488", bg:"rgba(20,184,166,0.12)", border:"rgba(20,184,166,0.3)" },
  pending:{ color:"#b45309", bg:"rgba(245,158,11,0.12)", border:"rgba(245,158,11,0.3)" },
  insuff: { color:"#6d28d9", bg:"rgba(124,58,237,0.12)", border:"rgba(124,58,237,0.3)" },
  "insuff clear": { color:"#7c3aed", bg:"rgba(139,92,246,0.12)", border:"rgba(139,92,246,0.3)" },
  hold:   { color:"#92400e", bg:"rgba(245,158,11,0.10)", border:"rgba(245,158,11,0.25)"},
  stop:   { color:"#b91c1c", bg:"rgba(239,68,68,0.12)",  border:"rgba(239,68,68,0.3)"  },
};

/* ══════════════════════════════════════════════════════════════════
   REPORT MODAL
══════════════════════════════════════════════════════════════════ */
function ReportModal({ row, onClose, onGenerate, generating }) {
  const [slots,    setSlots]    = useState({ uploadFormat:null,  uploadFormat2:null,  uploadFormat3:null, house1:null, house2:null, photo3:null, photo4:null, photo5:null, photo6:null });
  const [previews, setPreviews] = useState({});
  const [dragKey,  setDragKey]  = useState(null);
  const refs = useRef({});

  const isFileAllowedForSlot = (slot, file) => {
    if (!file) return false;
    const type = String(file.type || "").toLowerCase();
    const name = String(file.name || "").toLowerCase();

    if (slot?.isDoc) {
      return (
        type.startsWith("image/") ||
        type === "application/pdf" ||
        name.endsWith(".pdf") ||
        name.endsWith(".xlsx") ||
        name.endsWith(".xls") ||
        name.endsWith(".doc") ||
        name.endsWith(".docx")
      );
    }

    return type.startsWith("image/") || /\.(jpg|jpeg|png|webp)$/i.test(name);
  };

  const pick = async (key, file) => {
    if (!file) return;

    const slot = IMAGE_SLOTS.find(s => s.key === key);

    if (!isFileAllowedForSlot(slot, file)) {
      alert(slot?.isDoc
        ? "Please upload PDF, Excel, Word or Image file in Upload Format."
        : "Please upload only an image file in photo slots."
      );
      return;
    }

    const name = String(file.name || "").toLowerCase();

    /* ───────── WORD → PDF AUTO CONVERT ───────── */
    if (slot?.isDoc && (name.endsWith(".doc") || name.endsWith(".docx"))) {
      try {
        const token = getAuthToken();

        const fd = new FormData();
        fd.append("file", file);

        const API_BASE =
          window.location.hostname === "localhost"
            ? "http://localhost:5002/api"
            : "https://profeix.info/api";

        const res = await fetch(`${API_BASE}/upload/convert-doc-to-pdf`, {
          method: "POST",
          headers: {
            Authorization: `Bearer ${token}`,
          },
          body: fd,
        });

        const data = await res.json().catch(() => ({}));

        if (!res.ok) {
          throw new Error(data.error || "Word to PDF conversion failed");
        }

        const pdfUrl = data.fileUrl?.startsWith("http")
          ? data.fileUrl
          : `${API_BASE.replace(/\/api$/, "")}${data.fileUrl || ""}`;

        const pdfRes = await fetch(pdfUrl);
        const pdfBlob = await pdfRes.blob();

        const pdfFile = new File(
          [pdfBlob],
          data.pdfName || file.name.replace(/\.(doc|docx)$/i, ".pdf"),
          { type: "application/pdf" }
        );

        setSlots(p => ({ ...p, [key]: pdfFile }));
        setPreviews(p => ({ ...p, [key]: pdfUrl }));

        return;
      } catch (err) {
        alert("Word file convert failed: " + err.message);
        return;
      }
    }

    setSlots(p => ({ ...p, [key]: file }));
    try { setPreviews(p => ({ ...p, [key]: URL.createObjectURL(file) })); } catch (_) {}
  };

  const handleDragOver = (e, key) => {
    e.preventDefault();
    e.stopPropagation();
    if (!generating) setDragKey(key);
  };

  const handleDragLeave = (e, key) => {
    e.preventDefault();
    e.stopPropagation();
    const next = e.relatedTarget;
    if (!e.currentTarget.contains(next)) {
      setDragKey(prev => (prev === key ? null : prev));
    }
  };

  const handleDrop = (e, key) => {
    e.preventDefault();
    e.stopPropagation();
    if (generating) return;
    setDragKey(null);
    const file = e.dataTransfer?.files?.[0];
    pick(key, file);
  };

  const filled = IMAGE_SLOTS.filter(s => slots[s.key]).length;
  const ready  = true;

  return (
    <div className="rpt-overlay"
      onClick={e => e.target.classList.contains("rpt-overlay") && !generating && onClose()}>
      <div className="rpt-modal">
        <div className="rpt-mhead">
          <div>
            <div className="rpt-mtitle">
              <div className="rpt-micon">📄</div>
              Upload Verification Report
            </div>
            <div className="rpt-msub">
              Candidate: <strong>{row?.["Candidate Name"] || "—"}</strong>
              {(row?.["Check Id"] || row?.["Case ID"]) && (
