  const handleAppend = useCallback((e) => {
    const file = e.target.files?.[0];
    if (!file) return;

    const resetInput = () => {
      if (e?.target) e.target.value = null;
    };

    const parseStoredArray = (raw) => {
      try {
        const parsed = JSON.parse(raw || "null");
        return Array.isArray(parsed) ? parsed : [];
      } catch (_) {
        return [];
      }
    };

    // STRICT Daily Excel client matching:
    // Saved client "manavtyagi" will match only Excel "manavtyagi".
    // It will NOT match "Manavtyagi", "manavTyagi", or "manav tyagi".
    const normalizeClientForMatch = (v) =>
      String(v || "")
        .replace(/[\r\n\u2028\u2029]+/g, " ")
        .trim();

    const getManualSavedClients = () => {
      const cu = currentUser || {};
      const role = String(cu.role || "").trim().toLowerCase();
      const email = String(cu.email || "").trim().toLowerCase();
      const ownerAdminEmail = String(cu.ownerAdminEmail || "").trim().toLowerCase();
      // Manager/TL share the super admin's own "__SUPERADMIN__" saved-
      // clients workspace, not a separate one keyed by their own email —
      // without this they'd always hit "No saved clients found" since
      // their own personal workspace is permanently empty (clients are
      // saved into the shared internal workspace, not per-person). Plain
      // team members never reach this at all — "Upload Daily Excel" is
      // hidden from them (teamHidden on that nav item), so this doesn't
      // need to cover role==="team".
      const isSuperAdminUser =
        role === "superadmin" ||
        email === SUPER_ADMIN_EMAIL ||
        role === "manager" ||
        role === "tl";

      // Keep this workspace logic aligned with Upload.jsx so Secondary Admin
      // validates against the same manually saved client list that Add Clients uses.
      const clientWorkspaceId = isSuperAdminUser
        ? "__SUPERADMIN__"
        : String(
            tenantId ||
            cu.tenantId ||
            cu.subTenantId ||
            cu.companyTenantId ||
            cu.companyId ||
            cu.tenantCode ||
            cu.companyCode ||
            cu.companyName ||
            cu.company ||
            (role === "admin" || role === "secondary_admin" ? `ADMIN__${email}` : "") ||
            (role === "team" && ownerAdminEmail ? `ADMIN__${ownerAdminEmail}` : "") ||
            cu.ownerAdminEmail ||
            cu.adminEmail ||
            cu.email ||
            "__LOCAL_COMPANY__"
          ).trim();

      const safeWorkspaceId = String(clientWorkspaceId || "__LOCAL_COMPANY__").trim();
      const savedKey = `saved_upload_clients__${safeWorkspaceId}`;
      const deletedKey = `deleted_upload_clients__${safeWorkspaceId}`;

      const saved = parseStoredArray(localStorage.getItem(savedKey));
      const deleted = parseStoredArray(localStorage.getItem(deletedKey));
      const deletedKeys = new Set(deleted.map((c) => normalizeClientForMatch(c)).filter(Boolean));
      const map = new Map();

      saved.forEach((client) => {
        const c = String(client || "").replace(/\s+/g, " ").trim();
        const key = normalizeClientForMatch(c);
        if (!c || c === MASTER_KEY || !key || deletedKeys.has(key)) return;
        if (!map.has(key)) map.set(key, c);
      });

      return Array.from(map.values());
    };

    const getClientFromRow = (row = {}) =>
      String(
        row["Client Name"] ?? row["client name"] ?? row["CLIENT NAME"] ??
        row["Company Name"] ?? row["company name"] ?? row["COMPANY NAME"] ??
        row["Client"] ?? row["client"] ?? row.clientName ?? row.companyName ??
        row.rawData?.["Client Name"] ?? row.rawData?.["client name"] ?? row.rawData?.["CLIENT NAME"] ??
        row.rawData?.["Company Name"] ?? row.rawData?.["company name"] ?? row.rawData?.["COMPANY NAME"] ??
        row.rawData?.["Client"] ?? row.rawData?.["client"] ?? row.rawData?.clientName ?? row.rawData?.companyName ??
        ""
      );

    const reader = new FileReader();
    reader.onload = async (ev) => {
      try {
        const buf = new Uint8Array(ev.target.result);
        const wb = XLSX.read(buf, { type: "array" });
        const ws = wb.Sheets[wb.SheetNames[0]];
        const raw = XLSX.utils.sheet_to_json(ws, {
          header: 1,
          raw: false,
          dateNF: "dd/mm/yyyy",
          cellDates: true,
        });

        if (!raw.length) {
          alert("❌ Excel is empty");
          resetInput();
          return;
        }

        // Second parse of the same sheet, raw:true, used ONLY to recover full
        // precision for long-number columns (UAN Number etc.) whose formatted
        // text collapsed into scientific notation (e.g. "1.00082E+11") because
        // the source Excel cell was formatted as General/Scientific. raw:false
        // above captures Excel's rounded DISPLAY text for such cells, silently
        // losing digits — raw:true gives the true underlying number instead.
        const rawNumericBody = XLSX.utils.sheet_to_json(ws, { header: 1, raw: true }).slice(1);
        const SCI_NOTATION_RE = /^-?\d+(\.\d+)?[eE][+-]?\d+$/;

        const headers = raw[0];

        const clientColIndex = headers.findIndex((h) => {
          const key = String(h || "").trim().toLowerCase();
          return key === "client name" || key === "client" || key === "company name";
        });

        if (clientColIndex === -1) {
          alert("❌ Excel rejected. Excel must have a Client Name column.");
          resetInput();
          return;
        }

        const manualClients = getManualSavedClients();
        const manualClientMap = new Map(
          manualClients.map((c) => [normalizeClientForMatch(c), String(c || "").replace(/\s+/g, " ").trim()])
        );

        if (manualClientMap.size === 0) {
          alert("❌ No saved clients found. Please add clients manually first, then upload Daily Excel.");
          resetInput();
          return;
        }

        const invalidClientRows = [];
        const usedClientMap = new Map();

        raw.slice(1).forEach((row, idx) => {
          if (!row || row.length === 0) return;

          const excelClient = row[clientColIndex] === undefined || row[clientColIndex] === null
            ? ""
            : String(row[clientColIndex]).replace(/\s+/g, " ").trim();
          const excelClientKey = normalizeClientForMatch(excelClient);

          const existingClient = manualClientMap.get(excelClientKey);

          if (!excelClientKey || !existingClient) {
            invalidClientRows.push({ rowNo: idx + 2, excelClient: excelClient || "Blank" });
            return;
          }

          usedClientMap.set(excelClientKey, existingClient);
        });

        // Previously this rejected the ENTIRE file when even one row had an
        // unrecognized/blank Client Name (e.g. a casing/whitespace variant
        // of an already-saved client, easy to hit across a large manually-
        // typed Excel) — every other, perfectly valid row was silently lost
        // along with it. Now those specific rows are skipped and reported
        // (same pattern as duplicate rows below), while every valid row
        // still imports normally.
        const invalidClientRowNos = new Set(invalidClientRows.map((r) => r.rowNo));

        // ── SUPER ADMIN ONLY: vendor-name check (mirrors client check above) ──
        const isSAForVendorCheck =
          String(currentUser?.role || "").trim().toLowerCase() === "superadmin" ||
          String(currentUser?.email || "").trim().toLowerCase() === String(SUPER_ADMIN_EMAIL).toLowerCase();
        if (isSAForVendorCheck) {
          const vendorColIndex = headers.findIndex((h) => {
            const k = String(h || "").trim().toLowerCase();
            return k === "vendor name" || k === "vendorname" || k === "vendor company" || k === "vendor";
          });
          if (vendorColIndex !== -1) {
            const rawVendors = parseStoredArray(localStorage.getItem("saved_upload_vendors____SUPERADMIN__"));
            const manualVendorMap = new Map(
              rawVendors
                .map((v) => String(v || "").replace(/\s+/g, " ").trim())
                .filter(Boolean)
                .map((v) => [normalizeClientForMatch(v), v])
            );
            if (manualVendorMap.size > 0) {
              const invalidVendorRows = [];
              raw.slice(1).forEach((row, idx) => {
                if (!row || row.length === 0) return;
                const excelVendor =
                  row[vendorColIndex] === undefined || row[vendorColIndex] === null
                    ? ""
                    : String(row[vendorColIndex]).replace(/\s+/g, " ").trim();
                const excelVendorKey = normalizeClientForMatch(excelVendor);
                if (!excelVendorKey || !manualVendorMap.has(excelVendorKey)) {
                  invalidVendorRows.push({ rowNo: idx + 2, excelVendor: excelVendor || "Blank" });
                }
              });
              if (invalidVendorRows.length > 0) {
                const sample = invalidVendorRows
                  .slice(0, 8)
                  .map((r) => `Row ${r.rowNo}: ${r.excelVendor}`)
                  .join("\n");
                alert(
                  `❌ Excel rejected.\n\nEvery Vendor Name in Daily Excel must already exist in your saved vendor list.\n\nInvalid/blank vendor rows: ${invalidVendorRows.length}${sample ? `\n\n${sample}` : ""}`
                );
                resetInput();
                return;
              }
            }
          }
        }

        const clean = (v) => {
          if (!v) return "";
          if (v instanceof Date) return v.toLocaleDateString("en-IN");
          return String(v)
            .replace(/[\r\n\u2028\u2029]+/g, " ")
            .replace(/\s+/g, " ")
            .trim();
        };

        // ✅ Duplicate prevention for Daily Excel upload:
        // It compares ALL Excel columns. If every column value is the same,
        // the row is skipped. If even one column is different, it is imported.
        const excelColumnsForDuplicateCheck = headers
          .map((h, idx) => ({ name: clean(h), idx }))
          .filter((c) => c.name);

        const getExistingValueForColumn = (record = {}, colName = "") => {
          if (!record || !colName) return "";
          if (record[colName] !== undefined && record[colName] !== null) return record[colName];
          if (record.rawData && record.rawData[colName] !== undefined && record.rawData[colName] !== null) {
            return record.rawData[colName];
          }

          const colLower = String(colName).trim().toLowerCase();
          const directKey = Object.keys(record || {}).find((k) => String(k).trim().toLowerCase() === colLower);
          if (directKey) return record[directKey];

          const rawKey = Object.keys(record.rawData || {}).find((k) => String(k).trim().toLowerCase() === colLower);
          if (rawKey) return record.rawData[rawKey];

          return "";
        };

        const makeDuplicateKeyFromExcelRow = (row = []) => {
          return excelColumnsForDuplicateCheck
            .map(({ name, idx }) => {
              let value = row[idx];

              if (idx === clientColIndex) {
                const excelClient = value === undefined || value === null
                  ? ""
                  : String(value).replace(/\s+/g, " ").trim();
                value = manualClientMap.get(normalizeClientForMatch(excelClient)) || excelClient;
              }

              return `${name}::${clean(value)}`;
            })
            .join("||");
        };

        const makeDuplicateKeyFromExistingRecord = (record = {}) => {
          return excelColumnsForDuplicateCheck
            .map(({ name }) => `${name}::${clean(getExistingValueForColumn(record, name))}`)
            .join("||");
        };

        const existingDuplicateKeys = new Set(
          (Array.isArray(data) ? data : [])
            .map((record) => makeDuplicateKeyFromExistingRecord(record))
            .filter(Boolean)
        );

        const uploadDuplicateKeys = new Set();
        const duplicateRows = [];

        const uniqueExcelRows = raw
          .slice(1)
          .map((row, idx) => ({ row, rowNo: idx + 2, numRow: rawNumericBody[idx] }))
          .filter(({ row }) => row?.length)
          .filter(({ rowNo }) => !invalidClientRowNos.has(rowNo))
          .filter(({ row, rowNo }) => {
            const duplicateKey = makeDuplicateKeyFromExcelRow(row);
            if (!duplicateKey) return false;

            if (existingDuplicateKeys.has(duplicateKey) || uploadDuplicateKeys.has(duplicateKey)) {
              duplicateRows.push({ rowNo, excelClient: clean(row[clientColIndex]) || "Blank" });
              return false;
            }

            uploadDuplicateKeys.add(duplicateKey);
            return true;
          });

