function formatExcelDate(value) {
  if (value === undefined || value === null || value === "") return "";

  const formatOut = (d) => {
    if (!(d instanceof Date) || Number.isNaN(d.getTime())) return "";
    return d.toLocaleDateString("en-IN", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    });
  };

  if (value instanceof Date && !Number.isNaN(value.getTime())) {
    return formatOut(value);
  }

  const raw = String(value).trim();
  if (!raw) return "";

  const slashMatch = raw.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2}|\d{4})$/);
  if (slashMatch) {
    let a = Number(slashMatch[1]);
    let b = Number(slashMatch[2]);
    let y = Number(slashMatch[3]);
    if (y < 100) y += 2000;

    let day;
    let month;

    if (a > 12) {
      day = a;
      month = b;
    } else if (b > 12) {
      day = b;
      month = a;
    } else {
      day = b;
      month = a;
    }

    const parsed = new Date(y, month - 1, day);
    if (!Number.isNaN(parsed.getTime())) return formatOut(parsed);
  }

  const hyphenMatch = raw.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/) || raw.match(/^(\d{1,2})-(\d{1,2})-(\d{2}|\d{4})$/);
  if (hyphenMatch) {
    let y, m, d;
    if (hyphenMatch[1].length === 4) {
      y = Number(hyphenMatch[1]);
      m = Number(hyphenMatch[2]);
      d = Number(hyphenMatch[3]);
    } else {
      d = Number(hyphenMatch[1]);
      m = Number(hyphenMatch[2]);
      y = Number(hyphenMatch[3]);
      if (y < 100) y += 2000;
    }
    const parsed = new Date(y, m - 1, d);
    if (!Number.isNaN(parsed.getTime())) return formatOut(parsed);
  }

  const serial = Number(raw);
  if (Number.isFinite(serial) && serial > 20000 && serial < 80000) {
    const excelEpoch = new Date(Date.UTC(1899, 11, 30));
    const jsDate = new Date(excelEpoch.getTime() + serial * 86400000);
    if (!Number.isNaN(jsDate.getTime())) {
      return jsDate.toLocaleDateString("en-IN", {
        day: "2-digit",
        month: "short",
        year: "numeric",
        timeZone: "UTC",
      });
    }
  }

  const parsed = new Date(raw);
  if (!Number.isNaN(parsed.getTime())) return formatOut(parsed);

  return raw;
}

function toDateInputValue(value) {
  if (value === undefined || value === null || value === "") return "";
  if (value instanceof Date && !Number.isNaN(value.getTime())) {
    const y = value.getFullYear();
    const m = String(value.getMonth() + 1).padStart(2, "0");
    const d = String(value.getDate()).padStart(2, "0");
    return `${y}-${m}-${d}`;
  }
  const raw = String(value).trim();
  if (!raw) return "";
  if (/^\d{4}-\d{2}-\d{2}/.test(raw)) return raw.slice(0, 10);

  const slashMatch = raw.match(/^(\d{1,2})\/(\d{1,2})\/(\d{2}|\d{4})$/);
  if (slashMatch) {
    let a = Number(slashMatch[1]);
    let b = Number(slashMatch[2]);
    let y = Number(slashMatch[3]);
    if (y < 100) y += 2000;
    let day, month;
    if (a > 12) { day = a; month = b; }
    else if (b > 12) { day = b; month = a; }
    else { day = b; month = a; }
    const parsed = new Date(y, month - 1, day);
    if (!Number.isNaN(parsed.getTime())) {
      const yy = parsed.getFullYear();
      const mm = String(parsed.getMonth() + 1).padStart(2, "0");
      const dd = String(parsed.getDate()).padStart(2, "0");
      return `${yy}-${mm}-${dd}`;
    }
  }

  const serial = Number(raw);
  if (Number.isFinite(serial) && serial > 20000 && serial < 80000) {
    const excelEpoch = new Date(Date.UTC(1899, 11, 30));
    const jsDate = new Date(excelEpoch.getTime() + serial * 86400000);
    if (!Number.isNaN(jsDate.getTime())) return jsDate.toISOString().slice(0, 10);
  }
  const parsed = new Date(raw);
  if (!Number.isNaN(parsed.getTime())) {
    const y = parsed.getFullYear();
    const m = String(parsed.getMonth() + 1).padStart(2, "0");
    const d = String(parsed.getDate()).padStart(2, "0");
    return `${y}-${m}-${d}`;
  }
  return "";
}

function formatDateInputValue(value) {
  if (!value) return "";
  const [y, m, d] = String(value).split("-").map(Number);
  if (!y || !m || !d) return value;
  return new Date(y, m - 1, d).toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

// Special Billing Date only — normalizes a native <input type="date"> value
// (always "yyyy-mm-dd" once complete) to a sane ISO date, or returns null.
// A native date input fires onChange on every keystroke while the year is
// being typed (e.g. typing "2026" briefly produces "0002", "0020", "0202"
// before settling on "2026") — this rejects anything that isn't a complete,
// plausible date instead of silently accepting a mid-typing snapshot. A
// clearly-truncated 2-digit year (e.g. "0022" meaning "22") is normalized to
// 20xx to match the same convention used elsewhere in this file
// (formatExcelDate/toDateInputValue); anything outside 2000-2100 after that
// is rejected outright rather than saved.
function normalizeSpecialBillingDateInput(raw) {
  if (!raw) return null;
  const m = String(raw).trim().match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if (!m) return null;
  let y = Number(m[1]);
  const mo = Number(m[2]);
  const d = Number(m[3]);
  if (y < 100) y += 2000;
  if (y < 2000 || y > 2100) return null;
  if (mo < 1 || mo > 12 || d < 1 || d > 31) return null;
  return `${String(y).padStart(4, "0")}-${String(mo).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
}

// Defense-in-depth for legacy bad-year records still in the DB (before the
// one-time cleanup script runs) — never render a garbage year like "22"
// instead of "2026" if a stale record slips through.
function isSaneBillingYear(dateVal) {
  if (!dateVal) return false;
  const d = new Date(dateVal);
  if (Number.isNaN(d.getTime())) return false;
  const y = d.getFullYear();
  return y >= 2000 && y <= 2100;
}

function fmtCellForColumn(col, val) {
  return isDateColumnName(col) ? formatExcelDate(val) : fmtCell(val);
}
function isAddressColumnName(col = "") {
  const c = String(col || "").trim().toLowerCase();
  return (
    c === "address" ||
    c === "full address" ||
    c === "candidate address" ||
    c === "current address" ||
    c === "permanent address" ||
    c.endsWith(" address")
  );
}
function parsePrice(val) {
  if (!val && val !== 0) return null;
  const n = Number(String(val).replace(/[^0-9.]/g, ""));
  return !isNaN(n) && n > 0 ? n : null;
}
function getRowStatus(row) {
  if (!row) return "Pending";
  return (
    row["Status"] || row["status"] || row["STATUS"] ||
    row["Case Status"] || row["BGV Status"] ||
    row["Verification Status"] || row["Current Status"] ||
    (row.rawData && typeof row.rawData === "object" && (
      row.rawData["Status"] || row.rawData["status"] || row.rawData["STATUS"] ||
      row.rawData["Case Status"] || row.rawData["BGV Status"] ||
      row.rawData["Verification Status"] || row.rawData["Current Status"]
    )) || "Pending"
  );
}

function getRowTier(row) {
  if (!row) return null;
  const stored =
    row["Tier"] || row["tier"] || row["TIER"] ||
    row["Tier Type"] || row["tier type"] || row["TierType"] ||
    (row.rawData && (row.rawData["Tier"] || row.rawData["tier"] || row.rawData["Tier Type"]));
  if (stored) {
    const t = String(stored).trim();
    const m = t.match(/(\d)/);
    return m ? `Tier${m[1]}` : t;
  }
  return getTierForRow(row);
}

function getExcelVendorPrice(row) {
  const ks = ["Vendor Price","vendor price","VendorPrice","Vendor Rate","vendor rate","VendorRate","V Price","v price"];
  for (const k of ks) { const p = parsePrice(row[k]); if (p !== null) return p; }
  if (row.rawData && typeof row.rawData === "object") {
    for (const k of ks) { const p = parsePrice(row.rawData[k]); if (p !== null) return p; }
  }
  return null;
}
function getExcelVendorName(row) {
  const ks = ["Vendor Name","vendor name","VendorName","Vendor Company","vendor company","Vendor","vendor"];
  for (const k of ks) { if (row[k] && String(row[k]).trim()) return String(row[k]).trim(); }
  if (row.rawData && typeof row.rawData === "object") {
    for (const k of ks) { if (row.rawData[k] && String(row.rawData[k]).trim()) return String(row.rawData[k]).trim(); }
  }
  return null;
}
function getExcelClientPrice(row) {
  const ks = ["Client Price","client price","ClientPrice","Client Rate","client rate","ClientRate","Price","price","C Price","c price"];
  for (const k of ks) { const p = parsePrice(row[k]); if (p !== null) return p; }
  if (row.rawData && typeof row.rawData === "object") {
    for (const k of ks) { const p = parsePrice(row.rawData[k]); if (p !== null) return p; }
  }
  return null;
}


function getRulesForKey(obj, key) {
  if (!obj || !key) return [];
  if (Array.isArray(obj[key])) return obj[key];
  const lowerKey = String(key).trim().toLowerCase();
  if (Array.isArray(obj[lowerKey])) return obj[lowerKey];
  const foundKey = Object.keys(obj).find(k => String(k).trim().toLowerCase() === lowerKey);
  return foundKey && Array.isArray(obj[foundKey]) ? obj[foundKey] : [];
}

function getRowStateDistrict(row) {
  const pick = (keys) => {
    for (const k of keys) {
      const direct = row?.[k];
      if (direct !== undefined && direct !== null && String(direct).trim()) return String(direct).trim();
      const raw = row?.rawData?.[k];
      if (raw !== undefined && raw !== null && String(raw).trim()) return String(raw).trim();
    }
    return "";
  };

  const state = pick([
    "State", "state", "STATE", "State Name", "state name", "STATE NAME",
    "Location State", "location state", "LOCATION STATE",
    "Candidate State", "candidate state", "CANDIDATE STATE",
  ]).toLowerCase();

  const district = pick([
    "District", "district", "DISTRICT", "District Name", "district name", "DISTRICT NAME",
    "City", "city", "CITY", "Location", "location", "LOCATION",
  ]).toLowerCase();

  return { state, district };
}

function findMatchingRule(rules, row) {
  if (!rules || !rules.length) return null;

  const { state: directState, district: directDistrict } = getRowStateDistrict(row);

  const addressStr = [
    row["Address"], row["Full Address"], row["Candidate Address"], row["Current Address"], row["Permanent Address"],
    row["City"], row["State"], row["District"], row["Pincode"], row["Location"], row["Village"], row["Area"],
    row.rawData?.["Address"], row.rawData?.["Full Address"], row.rawData?.["Candidate Address"], row.rawData?.["Current Address"], row.rawData?.["Permanent Address"],
    row.rawData?.["City"], row.rawData?.["State"], row.rawData?.["District"], row.rawData?.["Pincode"], row.rawData?.["Location"],
    row.rawData?.["Village"], row.rawData?.["Area"],
  ].filter(Boolean).join(" ").toLowerCase();

  const words = addressStr.split(/[\\s,;/\\\\|.()\\-]+/).filter(Boolean);

  const textMatches = (needle) => {
    if (!needle) return false;
    const n = String(needle).trim().toLowerCase();
    return addressStr.includes(n) || words.includes(n);
  };

  for (const rule of rules) {
    const rs = String(rule.state || "").trim().toLowerCase();
    const rd = String(rule.district || "").trim().toLowerCase();

    const stateMatches = !rs ||
      (directState && directState === rs) ||
      textMatches(rs);

    const districtMatches = !rd ||
      (directDistrict && directDistrict === rd) ||
      textMatches(rd);

    if (stateMatches && districtMatches) return rule;
  }

  return null;
}

