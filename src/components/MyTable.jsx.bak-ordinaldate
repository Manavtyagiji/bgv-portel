/* ─────────────────────────── WORKER FACTORY ─────────────────────────────── */
const WORKER_SRC = `
let cachedData = [];
self.onmessage = function(e) {
  const { type, data: incomingData, search, filters, logic, statusFilter, tierFilter } = e.data;
  if (type === "SET_DATA") {
    cachedData = incomingData || [];
    return;
  }
  if (type !== "FILTER") return;
  const data = cachedData;
  const sl  = (search || "").toLowerCase();
  const sfl = statusFilter ? statusFilter.toLowerCase().trim() : null;
  const tfl = tierFilter   ? tierFilter.toLowerCase().replace(/[^a-z0-9]/g,"") : null;
  const result = [];
  for (let i = 0; i < data.length; i++) {
    const row = data[i];
    if (sfl) {
      const rs = (row["Status"]||row["status"]||row["STATUS"]||row["Case Status"]||row["BGV Status"]||row["Verification Status"]||row["Current Status"]||"pending").toLowerCase().trim();
      if (rs !== sfl) continue;
    }
    if (tfl) {
      const rt = (row["Tier"]||row["tier"]||row["TIER"]||row["Tier Type"]||"").toLowerCase().replace(/[^a-z0-9]/g,"");
      if (rt !== tfl) continue;
    }
    if (sl) {
      let found = false;
      const keys = Object.keys(row);
      for (let k = 0; k < keys.length; k++) {
        const v = row[keys[k]];
        if (v && typeof v !== "object" && String(v).toLowerCase().includes(sl)) { found = true; break; }
      }
      if (!found) continue;
    }
    if (filters && filters.length > 0) {
      const pass = logic === "AND" ? filters.every(f => match(row,f)) : filters.some(f => match(row,f));
      if (!pass) continue;
    }
    result.push(i);
  }
  const buf = new Int32Array(result);
  self.postMessage({ type:"RESULT", indices:buf }, [buf.buffer]);
};
function match(row,f){
  const c=String(row[f.column]||"").toLowerCase();const v=String(f.value||"").toLowerCase();
  switch(f.condition){case"equals":return c===v;case"contains":return c.includes(v);case"starts":return c.startsWith(v);case"ends":return c.endsWith(v);case"gt":return Number(c)>Number(v);case"lt":return Number(c)<Number(v);default:return true;}
}
`;
function makeWorker() {
  if (typeof Worker === "undefined") return null;
  try {
    const blob = new Blob([WORKER_SRC], { type:"application/javascript" });
    const url  = URL.createObjectURL(blob);
    const w    = new Worker(url);
    URL.revokeObjectURL(url);
    return w;
  } catch { return null; }
}

/* ─────────────────────────── NORMALIZE ──────────────────────────────────── */
// Education/PAN fields (super admin + internal team columns) — some legacy
// records have been observed with a literal nested "rawData.rawData" key.
// The generic single-level promotion below already covers rawData[x]; this
// adds a fallback to rawData.rawData[x] for just these 7 fields, in case a
// future upload's data ends up double-nested the same way. Doesn't change
// how any other field is read.
const EDU_PII_FIELD_NAMES = [
  "UAN Number", "University/College", "Date of Birth (DD-MM-YYYY)",
  "Course Name", "Roll/Registration/Seat Number", "Course Completion Year", "PAN No.",
];

function normalizeRow(row) {
  if (!row) return {};
  const out = {};
  for (const k of Object.keys(row)) {
    const key = typeof k === "string" ? k.trim() : k;
    out[key === "Company name" ? "Company Name" : key] = row[k];
  }
  if (out.rawData && typeof out.rawData === "object") {
    for (const rk of Object.keys(out.rawData)) {
      const nk = rk.trim();
      if (out[nk] === undefined || out[nk] === null || out[nk] === "") out[nk] = out.rawData[rk];
    }
    const nested = out.rawData.rawData;
    if (nested && typeof nested === "object") {
      for (const name of EDU_PII_FIELD_NAMES) {
        if ((out[name] === undefined || out[name] === null || out[name] === "") && nested[name] !== undefined) {
          out[name] = nested[name];
        }
      }
    }
  }
  return out;
}

