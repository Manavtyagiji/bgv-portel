  p.hasReport   === n.hasReport   &&
  p.row?._hasReport    === n.row?._hasReport    &&
  p.row?.extraApproved     === n.row?.extraApproved     &&
  p.row?.extraAmount       === n.row?.extraAmount       &&
  p.row?.isSpecialCase     === n.row?.isSpecialCase     &&
  p.row?.specialBillingDate === n.row?.specialBillingDate &&
  p.isSuperAdmin    === n.isSuperAdmin    &&
  p.showVendorBlock === n.showVendorBlock &&
  p.editMode === n.editMode &&
  p.onDeleteRow     === n.onDeleteRow     &&
  p.onSendToClient  === n.onSendToClient  &&
  p.isSelected === n.isSelected
);

