    pdf.text(slot.label || "Upload Format", 14, 18);

    pdf.setTextColor(60, 80, 120);
    pdf.setFontSize(11);
    pdf.setFont("helvetica", "bold");
    pdf.text("Uploaded File", 14, 44);

    pdf.setFont("helvetica", "normal");
    pdf.setFontSize(10);
    pdf.text(`File: ${file.name}`, 14, 56, { maxWidth: pw - 28 });

    pdf.setFontSize(9);
    pdf.setTextColor(95, 115, 150);
    pdf.text(
      "Note: Excel files cannot be visually embedded by the browser PDF generator. PDF/Word converted PDF files are merged directly, and images are embedded directly.",
      14,
      70,
      { maxWidth: pw - 28 }
    );

    pdf.setFontSize(8);
    pdf.setTextColor(170, 185, 210);
    pdf.text(`BGV Report  ·  ${slot.label || "Upload Format"}  ·  ${todayStr()}`, 14, ph - 8);

    await appendJsPdfToPdfLib(finalPdf, pdf);
  };

  const drawImagePage = async (slot, file, titlePrefix = "Upload Format", quality = 0.92) => {
    const pdf = createPagePdf();
    const pw  = pdf.internal.pageSize.getWidth();
    const ph  = pdf.internal.pageSize.getHeight();

const conv = await toJpeg(file, 1100, 0.70);
    const mx    = 0;
    const maxW  = pw - mx * 2;
    const maxH  = ph - mx * 2;
    const ratio = Math.min(maxW / conv.width, maxH / conv.height);
    const rW    = conv.width  * ratio;
    const rH    = conv.height * ratio;
    const xOff  = (pw - rW) / 2;
    const yOff  = (ph - rH) / 2;

    pdf.addImage(conv.dataUrl, "JPEG", xOff, yOff, rW, rH);

    pdf.setFillColor(37, 99, 235);
    pdf.rect(0, 0, pw, 10, "F");
    pdf.setTextColor(255, 255, 255);
    pdf.setFontSize(7);
    pdf.setFont("helvetica", "bold");
    pdf.text(slot.label || titlePrefix, 8, 6.8);

    await appendJsPdfToPdfLib(finalPdf, pdf);
  };

  const drawPhotoPage = async (slot, file, index, total) => {
    const pdf = createPagePdf();
    const pw  = pdf.internal.pageSize.getWidth();
    const ph  = pdf.internal.pageSize.getHeight();

    pdf.setFillColor(37, 99, 235);
    pdf.rect(0, 0, pw, 16, "F");
    pdf.setTextColor(255, 255, 255);
    pdf.setFontSize(10); pdf.setFont("helvetica", "bold");
    pdf.text(slot.label, 14, 11);
    pdf.setFontSize(8); pdf.setFont("helvetica", "normal");
    pdf.text(
      `Photo ${index + 1} of ${total}  ·  ${row?.["Candidate Name"] || "-"}`,
      pw - 14, 11, { align: "right" }
    );

    const conv = await toJpeg(file, 1000, 0.68);
    const topY  = 20;
    const maxW  = pw - 10;
    const maxH  = ph - topY - 8;
    const ratio = Math.min(maxW / conv.width, maxH / conv.height);
    const rW    = conv.width  * ratio;
    const rH    = conv.height * ratio;
    pdf.addImage(conv.dataUrl, "JPEG", (pw - rW) / 2, topY, rW, rH);

    pdf.setFontSize(6); pdf.setTextColor(170, 185, 210);
    pdf.text(`BGV Report  ·  ${slot.label}  ·  ${todayStr()}`, 14, ph - 4);

    await appendJsPdfToPdfLib(finalPdf, pdf);
  };

  /* ── Upload Format pages ── */
  const docSlots = IMAGE_SLOTS.filter(s => s.isDoc);

  for (const slot of docSlots) {
    const file = slots[slot.key];
    if (!file) continue;

    const fileType = String(file.type || "").toLowerCase();
    const fileName = String(file.name || "").toLowerCase();
    const isImage  = fileType.startsWith("image/") || /\.(jpg|jpeg|png|webp)$/i.test(fileName);
    const isPdf    = fileType === "application/pdf" || fileName.endsWith(".pdf");

    if (isImage) {
      await drawImagePage(slot, file, slot.label, 0.92);
    } else if (isPdf) {
      try {
        await appendUploadedPdfToPdfLib(finalPdf, file);
      } catch (err) {
        console.warn("PDF merge failed, adding info page:", err.message);
        await drawFileInfoPage(slot, file);
      }
    } else {
      await drawFileInfoPage(slot, file);
    }
  }

  /* ── Photo pages ── */
  const photoSlots = IMAGE_SLOTS.filter(s => !s.isDoc);
  const photoTotal = photoSlots.length;

  for (let i = 0; i < photoSlots.length; i++) {
    const slot = photoSlots[i];
    const file = slots[slot.key];
    if (!file) continue;
    await drawPhotoPage(slot, file, i, photoTotal);
  }

  if (finalPdf.getPageCount() === 0) {
    await drawFileInfoPage({ label: "Upload Verification Report" }, { name: "No file selected" });
  }

  const bytes = await finalPdf.save();
  return `data:application/pdf;base64,${uint8ToBase64(bytes)}`;
}

function dataUrlToFile(dataUrl, filename = "report.pdf") {
  const [meta, content] = dataUrl.split(",");
  const mimeMatch = meta.match(/data:(.*?);base64/);
  const mime = mimeMatch ? mimeMatch[1] : "application/pdf";
  const bin = atob(content);
  const arr = new Uint8Array(bin.length);

  for (let i = 0; i < bin.length; i++) {
    arr[i] = bin.charCodeAt(i);
  }

  return new File([arr], filename, { type: mime });
}


