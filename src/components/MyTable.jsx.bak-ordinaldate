  const getVI = useCallback((row) => {
    if (!showPricing) return { vPrice:null, vName:null, vpSource:null };

    const manualVN = (
      row["Vendor Name"] ||
      row["Vendor Company"] ||
      row["Vendor"] ||
      row.rawData?.["Vendor Name"] ||
      row.rawData?.["Vendor Company"] ||
      row.rawData?.["Vendor"] ||
      ""
    ).toString().trim();

    if (!manualVN) {
      return { vPrice:null, vName:null, vpSource:null };
    }

    const manualVP = getExcelVendorPrice(row);

    if (manualVP !== null) {
      return {
        vPrice: manualVP,
        vName: manualVN,
        vpSource: "manual",
      };
    }

    const clientNameKey = (
      row["Client Name"] ||
      row["Company Name"] ||
      ""
    ).trim().toLowerCase();

    const ruleSets = [
      { arr: getRulesForKey(pricingRules, clientNameKey),      src: "client-rule" },
      { arr: getRulesForKey(pricingRules, selectedClient),     src: "client-rule" },
      { arr: getRulesForKey(clientPricing, clientNameKey),     src: "client-rule" },
      { arr: getRulesForKey(clientPricing, selectedClient),    src: "client-rule" },
      { arr: getRulesForKey(pricingRules, GLOBAL_PRICING_KEY), src: "global-rule" },
      { arr: getRulesForKey(clientPricing, GLOBAL_PRICING_KEY),src: "global-rule" },
    ];

    for (const { arr, src } of ruleSets) {
      if (!Array.isArray(arr) || !arr.length) continue;

      const vpRules = arr.filter((r) => {
        const ruleVendor = String(r.vendorName || "").trim().toLowerCase();

        return (
          r.rate !== undefined &&
          r.rate !== null &&
          r.rate !== "" &&
          ruleVendor &&
          ruleVendor === manualVN.toLowerCase()
        );
      });

      const match = findMatchingRule(vpRules, row);

      if (match) {
        return {
          vPrice: match.rate,
          vName: manualVN,
          vpSource: src,
        };
      }
    }

    return {
      vPrice:null,
      vName:manualVN,
      vpSource:"manual",
    };
  }, [pricingRules, clientPricing, selectedClient, showPricing]);

