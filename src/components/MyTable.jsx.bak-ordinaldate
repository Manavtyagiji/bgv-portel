    row?.recordId ||
    row?.rawData?._id ||
    row?.rawData?.id ||
    row?.rawData?.recordId ||
    ""
  ).trim();
}

// Resolves the real index of `sourceRow` within `arr`, using `hintIndex` as a
// fast-path guess and falling back to a full search by the row's database id
// if the guess is wrong or stale (e.g. a search/filter/refresh reordered rows
// since the hint was captured). Prevents an edit from silently landing on the
// wrong record. Mirrors the verify-and-fallback pattern already used by
// onStatus — extracted here so every edit handler can share it.
function resolveRowIndex(arr, hintIndex, sourceRow) {
  const sourceId = getRecordMongoId(sourceRow || {});
  let idx = Number.isInteger(hintIndex) ? hintIndex : -1;
  if (
    sourceId &&
    (idx < 0 || !arr[idx] || getRecordMongoId(arr[idx]) !== sourceId)
  ) {
    const found = arr.findIndex(r => getRecordMongoId(r) === sourceId);
    if (found >= 0) idx = found;
  }
  return idx;
}

function getRowSelectionKey(row, idx = 0) {
  const id = getRecordMongoId(row);
  if (id) return `id:${id}`;
  return `row:${getRowReportKey(row, Number.isInteger(idx) ? idx : 0)}`;
}

async function uploadReportFileToServer(file, recordId, row = {}, currentUser = {}, tenantId = "") {
  const token = getAuthToken();

  if (!token) {
    throw new Error("No login token found. Please logout and login again.");
  }

  if (!recordId) {
    throw new Error("Record ID missing. Please refresh records and try again.");
  }

  const formData = new FormData();
  formData.append("file", file);
  formData.append("recordId", recordId);

  const accessPatch = getRecordAccessPatch(row, currentUser, tenantId);
  formData.append("tenantId", accessPatch.tenantId || "");
  formData.append("ownerAdminEmail", accessPatch.ownerAdminEmail || "");
  formData.append("assignedByEmail", accessPatch.assignedByEmail || "");
  formData.append("updatedByEmail", accessPatch.updatedByEmail || "");
  formData.append("updatedByRole", accessPatch.updatedByRole || "");
  formData.append("isInternalTeamUpdate", accessPatch.isInternalTeamUpdate ? "true" : "false");

  const API_BASE =
    window.location.hostname === "localhost"
      ? "http://localhost:5002/api"
      : "https://profeix.info/api";

  const res = await fetch(`${API_BASE}/upload/report-file`, {
    method: "POST",
    headers: {
      Authorization: `Bearer ${token}`,
    },
    body: formData,
  });

  const data = await res.json().catch(() => ({}));

  if (!res.ok) {
    throw new Error(
      data.error ||
      data.message ||
      `Report upload failed (${res.status})`
    );
  }

  return data;
}

// Resolves the actual openable URL for a record's report — an S3 presigned
// URL (fresh, short-lived) if the report has been uploaded/migrated to S3,
// or the legacy local static path otherwise. Always goes through this authed
// endpoint rather than building a URL client-side, since a presigned URL
// can't just be stored/reused — it expires.
async function fetchReportViewUrl(recordId) {
  const token = getAuthToken();
  if (!token || !recordId) return "";

  const API_BASE =
    window.location.hostname === "localhost"
      ? "http://localhost:5002/api"
      : "https://profeix.info/api";

  try {
    const res = await fetch(`${API_BASE}/upload/report-file/${recordId}`, {
      headers: { Authorization: `Bearer ${token}` },
    });
    if (!res.ok) return "";
    const data = await res.json().catch(() => ({}));
    return data.url || "";
  } catch {
    return "";
  }
}

