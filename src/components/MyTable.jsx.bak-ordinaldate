  const isInternalTeam =
    role === "team" &&
    (currentUser.isInternal === true || (!currentUser.tenantId && !currentUser.ownerAdminEmail));

  const ownerAdminEmail = normalizeEmail(
    row.ownerAdminEmail ||
    row.rawData?.ownerAdminEmail ||
    currentUser.ownerAdminEmail ||
    (isInternalTeam ? SUPER_ADMIN_EMAIL : userEmail)
  );

  const recordTenantId =
    row.tenantId ||
    row.rawData?.tenantId ||
    tenantId ||
    currentUser.tenantId ||
    "";

  return {
    tenantId: recordTenantId,
    ownerAdminEmail,
    assignedByEmail: ownerAdminEmail,
    updatedByEmail: userEmail,
    updatedByRole: role,
    isInternalTeamUpdate: isInternalTeam,
  };
}
function getRowReportKey(row, idx) {
  const mongoId = row?._id || row?.id || row?.recordId || row?.rawData?._id || row?.rawData?.id || row?.rawData?.recordId;
  if (mongoId) return String(mongoId).trim();

  const pick = (...keys) => {
    for (const k of keys) {
      const direct = row?.[k];
      if (direct !== undefined && direct !== null && String(direct).trim()) return String(direct).trim();
      const raw = row?.rawData?.[k];
      if (raw !== undefined && raw !== null && String(raw).trim()) return String(raw).trim();
    }
    return "";
  };

  const base = [
    pick("Case ID", "Check Id", "Application ID", "Candidate ID", "Reference ID"),
    pick("Candidate Name"),
    pick("Candidate Phone Number", "Phone Number", "Mobile Number"),
    pick("Address", "Full Address", "Candidate Address", "Current Address", "Permanent Address"),
    pick("Pincode", "Pin Code"),
  ]
    .filter(Boolean)
    .join("__");

  return String(base || `row_${idx}`)
    .trim()
    .toLowerCase()
    .replace(/\s+/g, "_")
    .replace(/[^a-z0-9_@.-]+/g, "_");
}

/* ══════════════════════════════════════════════════════════════
   REPORT STORE — uses IndexedDB (supports ~GB) instead of
   localStorage (limited to ~5-10MB, too small for PDF data URLs).
   Sync wrappers keep the rest of the code unchanged.
══════════════════════════════════════════════════════════════ */
const IDB_NAME    = "bgv_reports_db";
const IDB_STORE   = "reports";
const IDB_VERSION = 1;

function openIDB() {
  return new Promise((res, rej) => {
    const req = indexedDB.open(IDB_NAME, IDB_VERSION);
    req.onupgradeneeded = e => {
      const db = e.target.result;
      if (!db.objectStoreNames.contains(IDB_STORE)) {
        db.createObjectStore(IDB_STORE, { keyPath: "id" });
      }
    };
    req.onsuccess = e => res(e.target.result);
    req.onerror   = e => rej(e.target.error);
  });
}

/* Async save — fire and forget with error handling */
async function saveReportStoreAsync(s) {
  try {
    const db  = await openIDB();
    const tx  = db.transaction(IDB_STORE, "readwrite");
    const st  = tx.objectStore(IDB_STORE);
    /* Store entire map as single record keyed "main" */
    st.put({ id: REPORT_STORE_KEY, data: s });
    await new Promise((res, rej) => {
      tx.oncomplete = res;
      tx.onerror    = () => rej(tx.error);
    });
    db.close();
  } catch (e) {
    console.warn("Report store (IDB) save failed:", e.message);
    /* Fallback: try localStorage without the pdfDataUrl to save metadata */
    try {
      const light = {};
      Object.entries(s).forEach(([k, v]) => {
        light[k] = { ...v, pdfDataUrl: "__idb__" };
      });
      localStorage.setItem(REPORT_STORE_KEY + "_meta", JSON.stringify(light));
    } catch (_) {}
  }
}

/* Synchronous-looking load using a module-level cache */
let _reportCache = null;

async function loadReportStoreAsync() {
  try {
    const db  = await openIDB();
    const tx  = db.transaction(IDB_STORE, "readonly");
    const st  = tx.objectStore(IDB_STORE);
    const req = st.get(REPORT_STORE_KEY);
    const rec = await new Promise((res, rej) => {
      req.onsuccess = () => res(req.result);
      req.onerror   = () => rej(req.error);
    });
    db.close();
    return rec?.data || {};
  } catch (e) {
    console.warn("Report store (IDB) load failed:", e.message);
    return {};
  }
}

/* Synchronous wrappers — use cache for reads, async for writes */
function loadReportStore() {
  return _reportCache || {};
}
function saveReportStore(s) {
  _reportCache = s;           /* update cache immediately */
  saveReportStoreAsync(s);    /* persist to IDB async */
}

/* LAZY report cache — do NOT load all previously stored report PDFs on startup.
   Previously this read the entire saved-reports blob into memory the instant
   this module was imported, which slowed every page load. Now the cache loads
   once, in the background, only when the table that needs it actually mounts.
   Reports are also kept on the server, so viewing still works either way. */
let _reportCacheLoading = null;
let _reportCachePrimed = false; // becomes true after the cache has loaded once this session
function ensureReportCacheLoaded() {
  if (_reportCache) return Promise.resolve(_reportCache);
  if (_reportCacheLoading) return _reportCacheLoading;
  _reportCacheLoading = loadReportStoreAsync()
    .then((data) => {
      _reportCache = data || {};
      _reportCacheLoading = null;
      return _reportCache;
    })
    .catch(() => {
      _reportCache = _reportCache || {};
      _reportCacheLoading = null;
      return _reportCache;
    });
  return _reportCacheLoading;
}

/* ─────────────────────────── IMAGE → JPEG ───────────────────────────────── */
function fileToDataUrl(file) {
  return new Promise((res, rej) => {
    const r = new FileReader();
    r.onload = () => res(r.result);
    r.onerror = rej;
    r.readAsDataURL(file);
  });
}
function loadImg(src) {
  return new Promise((res, rej) => {
    const i = new Image();
    i.onload  = () => res(i);
    i.onerror = () => rej(new Error("Image load failed"));
    i.src = src;
  });
}
async function toJpeg(file, maxSide = 1000, q = 0.68){
  const du = await fileToDataUrl(file);
  const img = await loadImg(du);

  const c = document.createElement("canvas");
  const ctx = c.getContext("2d", { alpha: false });

  if (!ctx) throw new Error("Canvas not supported");

  let { width: w, height: h } = img;

  const s = Math.min(1, maxSide / Math.max(w, h));
  w = Math.max(1, Math.round(w * s));
  h = Math.max(1, Math.round(h * s));

  c.width = w;
  c.height = h;

  ctx.imageSmoothingEnabled = true;
  ctx.imageSmoothingQuality = "medium";

  ctx.fillStyle = "#fff";
  ctx.fillRect(0, 0, w, h);
  ctx.drawImage(img, 0, 0, w, h);

  const out = c.toDataURL("image/jpeg", q);

  c.width = 1;
  c.height = 1;

  if (!out.startsWith("data:image/jpeg")) {
    throw new Error("JPEG conversion failed");
  }

  return { dataUrl: out, width: w, height: h };
}

/* ─────────────────────────── PDF BUILDER ───────────────────────────────── */
function uint8ToBase64(uint8) {
  let binary = "";
  const chunkSize = 0x8000;
  for (let i = 0; i < uint8.length; i += chunkSize) {
    const chunk = uint8.subarray(i, i + chunkSize);
    binary += String.fromCharCode.apply(null, chunk);
  }
  return btoa(binary);
}

async function appendJsPdfToPdfLib(finalPdf, jsPdf) {
  const arr = jsPdf.output("arraybuffer");
  const src = await PDFDocument.load(arr);
  const pages = await finalPdf.copyPages(src, src.getPageIndices());
  pages.forEach((p) => finalPdf.addPage(p));
}

async function appendUploadedPdfToPdfLib(finalPdf, file) {
  const arr = await file.arrayBuffer();
  const src = await PDFDocument.load(arr);
  const pages = await finalPdf.copyPages(src, src.getPageIndices());
  pages.forEach((p) => finalPdf.addPage(p));
}

async function buildPdf(slots, row) {
