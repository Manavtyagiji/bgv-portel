/* ─────────────────────────── MAIN EXPORT ────────────────────────────────── */
export default function MyTable({
  data, setData, statusFilter,
  selectedClient, rawSelectedClient = null, pricingRules,
  clientPricing,
  isTeam      = false,
  currentUser = {},
  tenantId    = "",
  hideClientNameForVendorTeam = false,
}) {
  const showPricing = !isTeam;

  // SA internal team (isInternal or no tenantId+ownerAdminEmail, or ownerAdmin=SA):
  // they have isTeam=true but work like admins — allow admin-only send buttons.
  const isInternalSuperTeam =
    currentUser?.isInternal === true ||
    (!currentUser?.tenantId && !currentUser?.ownerAdminEmail) ||
    normalizeEmail(currentUser?.ownerAdminEmail || currentUser?.adminEmail || "") ===
      normalizeEmail(SUPER_ADMIN_EMAIL);

  const [search,          setSearch]          = useState("");
  const [dSearch,         setDSearch]         = useState("");
  const [filters,         setFilters]         = useState([]);
  const [logic,           setLogic]           = useState("AND");
  const [column,          setColumn]          = useState("");
  const [condition,       setCondition]       = useState("contains");
  const [value,           setValue]           = useState("");
  const [showInsuff,      setShowInsuff]      = useState(false);
  const [showInsuffClear, setShowInsuffClear] = useState(false);
  const [showVendorBlock, setShowVendorBlock] = useState(false);
  const [editMode,        setEditMode]        = useState(false);
  const [stopFieldsOpen,  setStopFieldsOpen]  = useState(false);
  const [dbStatus,        setDbStatus]        = useState(null);
  const [filteredIdx,     setFilteredIdx]     = useState(null);
  const [isFiltering,     setIsFiltering]     = useState(false);
  const [tierFilter,      setTierFilter]      = useState("All");
  const [insuffToast,     setInsuffToast]     = useState(false);
  const [page,            setPage]            = useState(1);
  const [selectedRowKeys, setSelectedRowKeys] = useState(() => new Set());
  const PAGE_SIZE = 50;

  // Fetch one small page at a time from the server instead of loading the
  // entire (and steadily growing) dataset into the browser first. Now
  // applies to team members too — their allocation-based visibility
  // (client/vendor/check-type scoping) is resolved server-side via
  // scopeToAllocations (see the fetch effect below), not by filtering a
  // fully client-side-loaded dataset. This was the last piece still using
  // the old full-dataset-eager-load path, and the confirmed source of
  // repeated browser OOM crashes for team member accounts as data grew.
  const serverPaginated = true;
  const [serverRows,    setServerRows]    = useState([]);
  const [serverTotal,   setServerTotal]   = useState(0);
  const [serverLoading, setServerLoading] = useState(false);
  const serverFetchIdRef = useRef(0);

  /* Report modal */
  const [modal,      setModal]      = useState(null);
  const [generating, setGenerating] = useState(false);
  const [rptRefresh, setRptRefresh] = useState(0);

  /* Bulk Update by Excel modal */
  const [bulkUpdateModal, setBulkUpdateModal] = useState(null);
  // Matching against server records (see fetchBulkMatchFromServer) can take
  // a real amount of time with thousands of records. Without this, the file
  // picker just closes and nothing visibly happens until it's done, which
  // looks broken.
  const [bulkUpdateLoading, setBulkUpdateLoading] = useState(false);
  // Export Excel: visual feedback while fetching the full matching set under
  // server pagination — without it, a slow fetch looked identical to a
  // broken button (nothing visibly happens either way).
  const [exportLoading, setExportLoading] = useState(false);
  const [exportProgress, setExportProgress] = useState(0);

  const normRef        = useRef([]);
  const workerRef      = useRef(null);
  const dbTimer        = useRef(null);
  const toastTimer     = useRef(null);
  const insuffExpandRef = useRef({ showInsuff: false, setShowInsuff: null });
  // WeakMap caches: return the same object reference for rows whose source
  // data hasn't changed, so memo(TRow) actually skips unchanged rows.
  const normCacheRef = useRef(new WeakMap());
  const extCacheRef  = useRef(new WeakMap());
  // Always-current ref so callbacks that write to data don't need `data` in
  // their useCallback deps (which would create new fn refs on every data change
  // and force VirtScroller + all TRow to re-render).
  const dataRef = useRef(data);
  dataRef.current = data;
  const pricingRulesRef = useRef(pricingRules);
  pricingRulesRef.current = pricingRules;
  insuffExpandRef.current.showInsuff    = showInsuff;
  insuffExpandRef.current.setShowInsuff = setShowInsuff;

  const scopeAdmin = useMemo(() => getScopeAdminEmail(currentUser), [currentUser]);
  const makeAccessPatch = useCallback((row = {}) => (
    getRecordAccessPatch(row, currentUser, tenantId)
  ), [currentUser, tenantId]);

  const getScopedKey = useCallback((row, idx) =>
    `${tenantId}__${scopeAdmin}__${getRowReportKey(row, idx)}`,
  [tenantId, scopeAdmin]);

  const openPdfSource = useCallback((src) => {
    if (!src) return false;

    try {
      const win = window.open("", "_blank");
      if (!win) return false;

      const str = String(src);

      if (str.startsWith("blob:")) {
        win.location.replace(str);
        return true;
      }

      if (/^https?:\/\//i.test(str)) {
        // An S3 presigned URL's signature covers its exact query string —
        // appending a cache-busting param here would invalidate it and turn
        // every "View Report" click into a SignatureDoesNotMatch error. Such
        // URLs are already unique per request (fresh signature + short
        // expiry), so no cache-busting is needed for them anyway.
        const isPresigned = /[?&]X-Amz-Signature=/.test(str);
        const finalUrl = isPresigned
          ? str
          : `${str}${str.includes("?") ? "&" : "?"}v=${Date.now()}`;
        win.location.replace(finalUrl);
        return true;
      }

      if (str.startsWith("data:application/pdf")) {
        const parts = str.split(",");
        if (parts.length < 2) {
          win.close();
          return false;
        }

        const mimeMatch = parts[0].match(/data:(.*?);base64/);
        const mime = mimeMatch ? mimeMatch[1] : "application/pdf";
        const byteChars = atob(parts[1]);
        const byteNumbers = new Array(byteChars.length);

        for (let i = 0; i < byteChars.length; i++) {
          byteNumbers[i] = byteChars.charCodeAt(i);
        }

        const byteArray = new Uint8Array(byteNumbers);
        const blob = new Blob([byteArray], { type: mime });
        const blobUrl = URL.createObjectURL(blob);

        win.location.replace(blobUrl);

        setTimeout(() => {
          try { URL.revokeObjectURL(blobUrl); } catch (_) {}
        }, 60000);

        return true;
      }

      const sep = str.includes("?") ? "&" : "?";
      win.location.replace(`${str}${sep}v=${Date.now()}`);
      return true;
    } catch (err) {
      console.error("openPdfSource failed:", err);
      return false;
    }
  }, []);

  // eslint-disable-next-line react-hooks/exhaustive-deps
  const getReport = useCallback((row, idx) => {
    const store = loadReportStore();
    const scopedKey = getScopedKey(row, idx);

    const exact = store[scopedKey];
    if (exact?.pdfDataUrl || exact?.reportFile) return exact;

    if (row?._reportKey && row._reportKey === scopedKey && store[row._reportKey]?.pdfDataUrl) {
      return store[row._reportKey];
    }

    if (row?.rawData?._reportKey && row.rawData._reportKey === scopedKey && store[row.rawData._reportKey]?.pdfDataUrl) {
      return store[row.rawData._reportKey];
    }

    if (row?.pdfDataUrl) return { pdfDataUrl: row.pdfDataUrl, reportFile: row.reportFile };
    if (row?.rawData?.pdfDataUrl) return { pdfDataUrl: row.rawData.pdfDataUrl, reportFile: row.rawData.reportFile };

    if (row?.reportFile) return { reportFile: row.reportFile };
    if (row?.rawData?.reportFile) return { reportFile: row.rawData.reportFile };

    return null;
  }, [getScopedKey, rptRefresh]);

  /* Real-time report sync — polls /upload/report-status every 10 s so other
     users (e.g. super admin) see a freshly-uploaded report without refreshing. */
  const reportPollSinceRef = useRef(new Date().toISOString());
  // recordId -> timestamp of the most recent LOCAL manual status change
  // (onStatus). The report-status poll below also syncs `status` from the
  // server so other users see status changes without refreshing — but if it
  // fires shortly after this user's own edit, it can re-apply a
  // just-superseded server value on top of the fresh local one, making the
  // edit look like it silently reverted. Skip re-applying status for a
  // record that was edited locally in roughly the last poll cycle; after
  // that window the server's own copy has had time to catch up and is safe
  // to trust again.
  const locallyEditedStatusRef = useRef(new Map());
  const STATUS_POLL_GUARD_MS = 25000;
  useEffect(() => {
    const poll = async () => {
      try {
        const { updates, serverTime } = await uploadAPI.getReportStatus(reportPollSinceRef.current);
        if (serverTime) reportPollSinceRef.current = serverTime;
        if (!Array.isArray(updates) || updates.length === 0) return;

        const wasEditedLocallyRecently = (id) => {
          const editedAt = locallyEditedStatusRef.current.get(String(id));
          return editedAt !== undefined && (Date.now() - editedAt) < STATUS_POLL_GUARD_MS;
        };

        setData(prev => {
          if (!Array.isArray(prev)) return prev;
          let changed = false;
          const nd = prev.map(row => {
            const u = updates.find(u => String(u._id) === String(getRecordMongoId(row)));
            if (!u) return row;
            changed = true;
            const includeStatus = u.status !== undefined && !wasEditedLocallyRecently(u._id);
            const patch = {
              reportFile: u.reportFile,
              reportFileName: u.reportFileName,
              reportUploaded: u.reportUploaded,
              reportUploadedAt: u.reportUploadedAt,
              reportUploadedBy: u.reportUploadedBy,
              ...(includeStatus ? { status: u.status, Status: u.status } : {}),
            };
            return { ...row, ...patch, rawData: { ...(row.rawData || {}), ...patch } };
          });
          return changed ? nd : prev;
        });

        updates.forEach(u => {
          if (!normRef.current) return;
          const idx = normRef.current.findIndex(r => String(getRecordMongoId(r)) === String(u._id));
          if (idx < 0) return;
          const includeStatus = u.status !== undefined && !wasEditedLocallyRecently(u._id);
          const patch = {
            reportFile: u.reportFile,
            reportFileName: u.reportFileName,
            reportUploaded: u.reportUploaded,
            reportUploadedAt: u.reportUploadedAt,
            reportUploadedBy: u.reportUploadedBy,
            ...(includeStatus ? { status: u.status, Status: u.status } : {}),
          };
          normRef.current[idx] = { ...normRef.current[idx], ...patch, rawData: { ...(normRef.current[idx].rawData || {}), ...patch } };
        });

        setRptRefresh(v => v + 1);
      } catch {
        // silent — polling is best-effort
      }
    };

    const id = setInterval(poll, 20000); // 20s — was 10s, reduced to halve collision rate with App.jsx 90s poll
    return () => clearInterval(id);
  }, []); // eslint-disable-line react-hooks/exhaustive-deps

  /* Worker — deliberately disabled. The worker's own cached copy of the
     dataset (kept to avoid re-cloning it on every keystroke) turned out to be
     a second, permanently-resident, fully-duplicated copy of the whole
     dataset in a separate memory space (structured clone across a worker
     boundary is a real copy, not a shared reference) — on lower-RAM devices
     this was enough on its own to cause out-of-memory tab crashes. The
     synchronous fallback below (originally written for browsers without
     Worker support) does a plain scan with no extra copy and no clone cost;
     for a few thousand rows that scan is a few tens of milliseconds, nowhere
     near the freeze the original clone-per-keystroke bug caused. */
  useEffect(() => {
    workerRef.current = null;
    if (workerRef.current) {
      workerRef.current.onmessage = e => {
        if (e.data.type !== "RESULT") return;
        const next = Array.from(e.data.indices);
        startTransition(() => {
          setFilteredIdx(prev => {
            if (
              Array.isArray(prev) &&
              prev.length === next.length &&
              prev.every((v, i) => v === next[i])
            ) {
              return prev;
            }
            return next;
          });
          setIsFiltering(false);
        });
      };
    }
    return () => workerRef.current?.terminate();
  }, []);

  /* Lazy-load the saved-report cache in the background the FIRST time the table
     mounts, instead of on app startup. This keeps every other page fast and lets
     the table paint first. The refresh tick fires only ONCE for the whole
     session (guarded by _reportCachePrimed), so navigating back to Records later
     never re-bumps and never causes the table to flicker/"dance". Server-stored
     reports work regardless. */
  useEffect(() => {
    if (_reportCachePrimed) return; // already primed once — do nothing on later mounts
    let alive = true;
    ensureReportCacheLoaded().then(() => {
      _reportCachePrimed = true;
      if (alive) setRptRefresh((v) => v + 1);
    });
    return () => { alive = false; };
  }, []);

  useEffect(() => {
    const t = setTimeout(() => setDSearch(search), 300);
    return () => clearTimeout(t);
  }, [search]);

  const showSaving = useCallback(() => {
    setDbStatus("saving");
    clearTimeout(dbTimer.current);
  }, []);
  const showSaved = useCallback(() => {
    setDbStatus("saved");
    dbTimer.current = setTimeout(() => setDbStatus(null), 2000);
  }, []);

  const triggerFilter = useCallback(() => {
    // Server-paginated mode: the server already applies search/filter/status
    // and returns exactly the matching page, so there is nothing to filter
    // client-side. This also stops the (expensive) worker/main-thread scan
    // path below from ever running for Admin/SA.
    if (serverPaginated) { setIsFiltering(false); return; }
    if (!normRef.current.length) { setFilteredIdx(null); setIsFiltering(false); return; }

    // No active filter → show all rows immediately without a worker round-trip.
    // This eliminates the structured-clone cost on every progressive batch load
    // and every data change when the user has not typed or selected any filter.
    const hasActiveFilter =
      !!dSearch?.trim() ||
      (Array.isArray(filters) && filters.length > 0) ||
      !!statusFilter ||
      (tierFilter && tierFilter !== "All");

    if (!hasActiveFilter) {
      setFilteredIdx(null);
      setIsFiltering(false);
      return;
    }

    setIsFiltering(true);
    if (workerRef.current) {
      // The worker already has the current dataset cached (kept in sync by
      // the SET_DATA effect below) — only the small filter parameters are
      // sent here, not the full dataset. Previously this re-sent the entire
      // normalized dataset (6000+ rows) on every keystroke; postMessage has
      // to structured-clone its payload synchronously on the main thread
      // before handing off to the worker, so that clone alone was enough to
      // freeze the page on every search as the dataset grew.
      workerRef.current.postMessage({
        type: "FILTER",
        search: dSearch, filters, logic, statusFilter,
        tierFilter: null,
      });
    } else {
      const result = [];
      const sl  = (dSearch || "").toLowerCase();
      const sfl = statusFilter ? statusFilter.toLowerCase().trim() : null;
      const tfl = tierFilter !== "All" ? tierFilter.toLowerCase().replace(/[^a-z0-9]/g, "") : null;
      for (let i = 0; i < normRef.current.length; i++) {
        const row = normRef.current[i];
        if (sfl && getRowStatus(row).toLowerCase().trim() !== sfl) continue;
        if (tfl) {
          const rt = (row["Tier"] || row["tier"] || "").toLowerCase().replace(/[^a-z0-9]/g, "");
          if (rt !== tfl) continue;
        }
        if (sl) {
          let f = false;
          for (const v of Object.values(row)) {
            if (v && typeof v !== "object" && String(v).toLowerCase().includes(sl)) { f = true; break; }
          }
          if (!f) continue;
        }
        if (filters.length > 0) {
          const pass = logic === "AND"
            ? filters.every(f => {
                const c = String(row[f.column] || "").toLowerCase();
                const v = String(f.value || "").toLowerCase();
                switch (f.condition) {
                  case "equals":   return c === v;
                  case "contains": return c.includes(v);
                  case "starts":   return c.startsWith(v);
                  case "ends":     return c.endsWith(v);
                  case "gt":       return Number(c) > Number(v);
                  case "lt":       return Number(c) < Number(v);
                  default:         return true;
                }
              })
            : filters.some(f => {
                const c = String(row[f.column] || "").toLowerCase();
                const v = String(f.value || "").toLowerCase();
                return c.includes(v);
              });
          if (!pass) continue;
        }
        result.push(i);
      }
      setFilteredIdx(prev => {
        if (
          Array.isArray(prev) &&
          prev.length === result.length &&
          prev.every((v, i) => v === result[i])
        ) {
          return prev;
        }
        return result;
      });
      setIsFiltering(false);
    }
  }, [dSearch, filters, logic, statusFilter, tierFilter, serverPaginated]);

  useEffect(() => {
    if (!Array.isArray(data) || data.length === 0) {
      setFilteredIdx([]);
      return;
    }
    triggerFilter();
  }, [data, triggerFilter]);
  useEffect(() => { triggerFilter(); }, [triggerFilter]);

  // Fetches exactly one page from the server whenever the page/search/filter/
  // status/client changes. Runs only for Admin/SA (serverPaginated); team
  // members never reach this effect — their existing behavior below is
  // completely untouched.
  useEffect(() => {
    if (!serverPaginated) return;
    const myFetchId = ++serverFetchIdRef.current;
    setServerLoading(true);

    const token = getAuthToken();
    const API_BASE =
      window.location.hostname === "localhost"
        ? "http://localhost:5002/api"
        : "https://profeix.info/api";

    const params = new URLSearchParams();
    params.set("page", String(page));
    params.set("limit", String(PAGE_SIZE));
    params.set("includeCount", "true");

    const searchTerm = dSearch?.trim();
    if (searchTerm) params.set("search", searchTerm);

    if (Array.isArray(filters) && filters.length > 0) {
      params.set("filters", JSON.stringify(filters));
      params.set("filterLogic", logic);
    }

    if (statusFilter) params.set("status", statusFilter);
    if (rawSelectedClient) params.set("clientName", rawSelectedClient);

    // Mirrors the eager-loader's own scope params: SA's own default view
    // sends no tenantId; a company admin's tenantId is already derived
    // server-side from their token, so it only needs to be sent when
    // explicitly viewing a specific tenant.
    const isSuperAdminUser = String(currentUser?.role || "").trim().toLowerCase() === "superadmin";
    if (!isSuperAdminUser && tenantId) params.set("tenantId", tenantId);

    // Team members: resolve their allocated clients/vendors/check-types
    // server-side (via the backend's existing buildAllocationScopeFilter)
    // instead of fetching everything in scope and filtering client-side —
    // that full-dataset fetch was the confirmed cause of repeated OOM
    // crashes on team member accounts as data grew.
    if (isTeam) params.set("scopeToAllocations", "true");

    fetch(`${API_BASE}/upload/records?${params.toString()}`, {
      headers: { Authorization: `Bearer ${token}` },
    })
      .then(async (res) => {
        if (serverFetchIdRef.current !== myFetchId) return; // superseded by a newer request
        const rows = await res.json();
        const totalHeader = res.headers.get("X-Total-Count");
        const safeRows = Array.isArray(rows) ? rows.map(normalizeRow) : [];
        // This is the array the table actually renders (pagedData ===
        // serverRows). This fetch can fire very frequently — a plain
        // overwrite here would stomp a status change the instant the user
        // makes it, before the guard below (which only protected `data`,
        // used for exports/bulk ops, not what's on screen) could help. Keep
        // the locally-edited status for a row edited in roughly the last
        // poll cycle; take everything else from the server as normal.
        setServerRows(prevServerRows => {
          const prevById = new Map(
            (Array.isArray(prevServerRows) ? prevServerRows : [])
              .map(r => [getRecordMongoId(r), r])
              .filter(([id]) => id)
          );
          return safeRows.map(r => {
            const id = getRecordMongoId(r);
            const editedAt = id ? locallyEditedStatusRef.current.get(String(id)) : undefined;
            if (editedAt !== undefined && (Date.now() - editedAt) < STATUS_POLL_GUARD_MS) {
              const prevRow = prevById.get(id);
              if (prevRow) {
                return {
                  ...r,
                  status: prevRow.status,
                  Status: prevRow.Status,
                  rawData: { ...(r.rawData || {}), status: prevRow.rawData?.status, Status: prevRow.rawData?.Status },
                };
              }
            }
            return r;
          });
        });
        setServerTotal(totalHeader ? Number(totalHeader) : safeRows.length);
        setServerLoading(false);

        // Merge freshly-fetched rows into the working dataset by id so every
        // edit handler (already id-verified via resolveRowIndex) can always
        // find its target. A fetched row REPLACES a matching row already in
        // the cache — every edit path in this table (onBlur, onStatus, bulk
        // update, etc.) persists to the server immediately rather than
        // holding an unsaved local-only draft, so the server's copy is
        // always the current truth. Without this, a record already cached
        // from earlier browsing would keep showing its stale pre-edit value
        // forever after being changed by something other than this exact
        // row's own handler (e.g. Bulk Update by Excel), since a fetch could
        // never overwrite it.
        if (safeRows.length > 0) {
          setData((prev) => {
            const base = Array.isArray(prev) ? prev : [];
            const freshById = new Map(
              safeRows.map((r) => [getRecordMongoId(r), r]).filter(([id]) => id)
            );
            const merged = base.map((r) => {
              const id = getRecordMongoId(r);
              if (!id || !freshById.has(id)) return r;
              const fresh = freshById.get(id);
              // This page fetch can be in flight (or re-fire) around the same
              // moment a user manually changes a row's status locally. If the
              // fetch resolves after the local edit but was requested before
              // the server recorded it, it carries the server's pre-edit
              // status — applying it wholesale would silently revert the
              // user's own just-made change. Keep the local status/Status for
              // a row edited in roughly the last poll cycle; take everything
              // else (report fields, etc.) fresh as normal.
              const editedAt = locallyEditedStatusRef.current.get(String(id));
              if (editedAt !== undefined && (Date.now() - editedAt) < STATUS_POLL_GUARD_MS) {
                return {
                  ...fresh,
                  status: r.status,
                  Status: r.Status,
                  rawData: { ...(fresh.rawData || {}), status: r.rawData?.status, Status: r.rawData?.Status },
                };
              }
              return fresh;
            });
            const knownIds = new Set(base.map((r) => getRecordMongoId(r)).filter(Boolean));
            const additions = safeRows.filter((r) => {
              const id = getRecordMongoId(r);
              return id && !knownIds.has(id);
            });
            return additions.length > 0 ? [...merged, ...additions] : merged;
          });
        }
      })
      .catch((err) => {
        if (serverFetchIdRef.current !== myFetchId) return;
        console.warn("Server page fetch failed:", err.message);
        setServerLoading(false);
      });
  }, [serverPaginated, page, dSearch, filters, logic, statusFilter, rawSelectedClient, tenantId, currentUser?.role, isTeam]);

  // Normalize every row ONCE per data change and reuse it. Previously this ran
  // on every search keystroke, filter change, and background sync — re-processing
  // all 12k+ rows each time, which caused stutter/freezes on large datasets.
  const normalizedData = useMemo(() => {
    if (!Array.isArray(data)) return [];
    return data.map(row => {
      // Return the cached normalized object if the source row hasn't changed.
      // Preserves reference identity so memo(TRow) can skip unchanged rows.
      const hit = normCacheRef.current.get(row);
      if (hit) return hit;
      const n = normalizeRow(row);
      normCacheRef.current.set(row, n);
      return n;
    });
  }, [data]);
  normRef.current = normalizedData;

  // Push the dataset into the worker only when it actually changes (new
  // records loaded/edited), not on every search keystroke — the worker
  // keeps its own cached copy and triggerFilter() only sends small filter
  // parameters from here on.
  useEffect(() => {
    workerRef.current?.postMessage({ type: "SET_DATA", data: normalizedData });
  }, [normalizedData]);

  const filteredData = useMemo(() => {
    // Reuse the already-normalized rows (built once above) instead of
    // re-normalizing the whole dataset on every filter/search change.
    const normalized = normalizedData;

    const withRealIndex = (row, index) => {
      if (!row) return null;
      // Return the same extended object when nothing changed; a new object
      // only when the row reference or its position in the list changed.
      const hit = extCacheRef.current.get(row);
      if (hit && hit._realIdx === index) return hit;
      const extended = { ...row, _realIdx: index };
      extCacheRef.current.set(row, extended);
      return extended;
    };

    // Only built when actually needed (no active filter, or filteredIdx isn't
    // ready yet) — previously this ran unconditionally on every search, doing
    // a full pass over the entire dataset even when the result was discarded
    // because a real filtered subset was about to be returned instead.
    const buildAllRows = () =>
      normalized.map((row, index) => withRealIndex(row, index)).filter(Boolean);

    const hasActiveFilter =
      !!dSearch?.trim() ||
      (Array.isArray(filters) && filters.length > 0) ||
      !!statusFilter ||
      (tierFilter && tierFilter !== "All");

    if (!Array.isArray(filteredIdx)) {
      return buildAllRows();
    }

    if (filteredIdx.length === 0) {
      return hasActiveFilter ? [] : buildAllRows();
    }

    return filteredIdx
      .map(i => withRealIndex(normalized[i], i))
      .filter(Boolean);
  }, [filteredIdx, dSearch, filters, statusFilter, tierFilter, normalizedData]);

  const totalPages = useMemo(
    () => serverPaginated
      ? Math.max(1, Math.ceil(serverTotal / PAGE_SIZE))
      : Math.max(1, Math.ceil(filteredData.length / PAGE_SIZE)),
    [serverPaginated, serverTotal, filteredData.length]
  );

  useEffect(() => {
    setPage(1);
  }, [dSearch, statusFilter, tierFilter, filters, logic, selectedClient, rawSelectedClient]);

  const pagedData = useMemo(() => {
    if (serverPaginated) {
      // Tier is a computed value (not a plain stored field the server can
      // filter on), so it isn't sent as a server query param — narrow the
      // current fetched page by it client-side instead of silently ignoring
      // it. This only narrows the ~50 rows already on this page (the total/
      // pagination count still reflects the unfiltered-by-tier server
      // total) — an acceptable, clearly-scoped gap rather than a silent one.
      if (tierFilter && tierFilter !== "All") {
        const tfl = tierFilter.toLowerCase().replace(/[^a-z0-9]/g, "");
        return serverRows.filter((row) => {
          const rt = (row["Tier"] || row["tier"] || "").toLowerCase().replace(/[^a-z0-9]/g, "");
          return rt === tfl || (getRowTier(row) || "").toLowerCase().replace(/[^a-z0-9]/g, "") === tfl;
        });
      }
      return serverRows;
    }
    const start = (page - 1) * PAGE_SIZE;
    return filteredData.slice(start, start + PAGE_SIZE);
  }, [serverPaginated, serverRows, filteredData, page, tierFilter]);

  // The true count of rows matching the current search/filter — serverTotal
  // (server-computed, accurate) for Admin/SA, filteredData.length (unchanged)
  // for team members. Every "N rows" display and filter-dependent button
  // below reads from this, not filteredData.length directly, so they stay
  // accurate under server pagination instead of reflecting only the small
  // locally-loaded working set.
  const displayTotalRows = serverPaginated ? serverTotal : filteredData.length;

  const selectedData = useMemo(() => {
    if (!selectedRowKeys.size) return [];
    // Use the full normalizedData (not filteredData) so selections made across
    // different searches are all included in bulk operations.
    return normalizedData.filter((row, idx) =>
      selectedRowKeys.has(getRowSelectionKey(row, idx))
    );
  }, [normalizedData, selectedRowKeys]);

  const allVisibleSelected = useMemo(() => (
    pagedData.length > 0 && pagedData.every((row) =>
      selectedRowKeys.has(getRowSelectionKey(row, row?._realIdx))
    )
  ), [pagedData, selectedRowKeys]);

  const handleSelectRow = useCallback((row, idx) => {
    const key = getRowSelectionKey(row, idx);
    setSelectedRowKeys(prev => {
      const next = new Set(prev);
      if (next.has(key)) next.delete(key);
      else next.add(key);
      return next;
    });
  }, []);

  const handleSelectAllVisible = useCallback(() => {
    setSelectedRowKeys(prev => {
      const next = new Set(prev);
      const visibleKeys = pagedData.map((row) => getRowSelectionKey(row, row?._realIdx));
      const allSelected = visibleKeys.length > 0 && visibleKeys.every(k => next.has(k));
      visibleKeys.forEach(k => {
        if (allSelected) next.delete(k);
        else next.add(k);
      });
      return next;
    });
  }, [pagedData]);

  useEffect(() => {
    setSelectedRowKeys(prev => {
      if (!prev.size) return prev;
      // Prune against the full dataset so filtering/searching never clears
      // selections made on rows that are temporarily out of view.
      const liveKeys = new Set(data.map((row, idx) => getRowSelectionKey(row, idx)));
      const next = new Set([...prev].filter(k => liveKeys.has(k)));
      return next.size === prev.size ? prev : next;
    });
  }, [data]);


  // Server-paginated mode only ever holds one small page of matching rows
  // client-side — Export/Delete-Filtered/bulk-send must still operate on
  // EVERY row matching the current search/filter, not just the visible page.
  // This does an unpaginated fetch (same filters, large limit) to get that
  // full matching set on demand, only when one of those actions is used.
  // Fetches every record matching the current search/filter/client, used by
  // Export/Delete Filtered/bulk-send. Pulled in bounded pages (not one
  // single "limit=100000" request) — as record volume grows toward hundreds
  // of thousands, one giant request risks a slow/timing-out response; paging
  // keeps every individual request small and fast regardless of how large
  // the total matching set gets, while still returning the exact same full
  // result to the caller. onProgress (optional) is called after each page
  // with the running total fetched so far, for a "Loading X…" indicator.
  const fetchAllMatchingFilter = useCallback(async (onProgress) => {
    const token = getAuthToken();
    const API_BASE =
      window.location.hostname === "localhost"
        ? "http://localhost:5002/api"
        : "https://profeix.info/api";

    const isSuperAdminUser = String(currentUser?.role || "").trim().toLowerCase() === "superadmin";
    const searchTerm = dSearch?.trim();
    const hasFilters = Array.isArray(filters) && filters.length > 0;

    const CHUNK_SIZE = 5000;
    let page = 1;
    let all = [];

    while (true) {
      const params = new URLSearchParams();
      params.set("page", String(page));
      params.set("limit", String(CHUNK_SIZE));
      if (searchTerm) params.set("search", searchTerm);
      if (hasFilters) {
        params.set("filters", JSON.stringify(filters));
        params.set("filterLogic", logic);
      }
      if (statusFilter) params.set("status", statusFilter);
      if (rawSelectedClient) params.set("clientName", rawSelectedClient);
      if (!isSuperAdminUser && tenantId) params.set("tenantId", tenantId);
      if (isTeam) params.set("scopeToAllocations", "true");

      // Each page gets its own timeout — a slow overall export (many pages)
      // never fails just from taking a while cumulatively; only a single
      // stuck request does.
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 60000);
      let res;
      try {
        res = await fetch(`${API_BASE}/upload/records?${params.toString()}`, {
          headers: { Authorization: `Bearer ${token}` },
          signal: controller.signal,
        });
      } catch (err) {
        if (err.name === "AbortError") {
          throw new Error(`Timed out loading records (page ${page}, 60s) — please try again.`);
        }
        throw err;
      } finally {
        clearTimeout(timeoutId);
      }
      if (!res.ok) throw new Error(`Failed to fetch matching records (page ${page})`);
      const rows = await res.json();
      const safeRows = Array.isArray(rows) ? rows.map(normalizeRow) : [];

      all = all.concat(safeRows);
      if (onProgress) onProgress(all.length);

      if (safeRows.length < CHUNK_SIZE) break; // last page reached
      page += 1;
    }

    return all;
  }, [dSearch, filters, logic, statusFilter, rawSelectedClient, tenantId, currentUser?.role, isTeam]);

  // Bulk Update by Excel needs to match a few hundred/thousand uploaded rows
  // against every scoped record by Check Id. Fetching the FULL dataset to do
  // that matching in the browser (an earlier version of this) reintroduced
  // exactly the "load everything into the tab" pattern that caused the
  // Records page OOM crashes server pagination was built to eliminate.
  // Instead, the matching itself runs server-side (bulkMatchByCheckId) —
  // only the matched subset comes back, never the full dataset.
  const fetchBulkMatchFromServer = useCallback(async (checkIds) => {
    const token = getAuthToken();
    const API_BASE =
      window.location.hostname === "localhost"
        ? "http://localhost:5002/api"
        : "https://profeix.info/api";

    const isSuperAdminUser = String(currentUser?.role || "").trim().toLowerCase() === "superadmin";
    const qs = !isSuperAdminUser && tenantId ? `?tenantId=${encodeURIComponent(tenantId)}` : "";

    // A hung/very slow request here previously looked exactly like "nothing
    // happened" — no error, no timeout, the file picker just closed and the
    // preview modal never appeared. Bound it explicitly so it always either
    // succeeds or surfaces a clear error within a reasonable time.
    const controller = new AbortController();
    const timeoutId = setTimeout(() => controller.abort(), 45000);
    let res;
    try {
      res = await fetch(`${API_BASE}/upload/bulk-match${qs}`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
        body: JSON.stringify({ checkIds }),
        signal: controller.signal,
      });
    } catch (err) {
      if (err.name === "AbortError") {
        throw new Error("Timed out matching records (45s) — please try again.");
      }
      throw err;
    } finally {
      clearTimeout(timeoutId);
    }
    if (!res.ok) throw new Error("Failed to match records on the server");
    const result = await res.json();
    return {
      matched: Array.isArray(result.matched) ? result.matched.map(normalizeRow) : [],
      unmatchedKeys: Array.isArray(result.unmatchedKeys) ? result.unmatchedKeys : [],
      ambiguousKeys: Array.isArray(result.ambiguousKeys) ? result.ambiguousKeys : [],
    };
  }, [tenantId, currentUser?.role]);

  const handleDeleteFiltered = useCallback(async () => {
    const hasActiveFilter =
      !!String(dSearch || "").trim() ||
      (Array.isArray(filters) && filters.length > 0) ||
      !!statusFilter ||
      (tierFilter && tierFilter !== "All");

    if (!hasActiveFilter) {
      alert("Please apply a filter/search/status filter first, then delete filtered cases.");
      return;
    }

    if (!displayTotalRows) {
      alert("No filtered records to delete.");
      return;
    }

    const ok = window.confirm(
      `Delete ${displayTotalRows} filtered record(s) permanently from DB? This action cannot be undone.`
    );
    if (!ok) return;

    try {
      showSaving();

      const token = getAuthToken();
      const API_BASE =
        window.location.hostname === "localhost"
          ? "http://localhost:5002/api"
          : "https://profeix.info/api";

      const rowsToDelete = serverPaginated
        ? await fetchAllMatchingFilter()
        : (Array.isArray(filteredData) ? [...filteredData] : []);
      const idsToDelete = [
        ...new Set(
          rowsToDelete
            .map((row) => getRecordMongoId(row))
            .filter(Boolean)
        ),
      ];

      if (!idsToDelete.length) {
        setDbStatus(null);
        alert("❌ No MongoDB _id found for selected/filtered records. Please refresh records and try again.");
        return;
      }

      const deleteOneRecord = async (id) => {
        if (typeof uploadAPI.deleteRecord === "function") {
          return uploadAPI.deleteRecord(id);
        }

        if (typeof uploadAPI.removeRecord === "function") {
          return uploadAPI.removeRecord(id);
        }

        const res = await fetch(`${API_BASE}/upload/records/${encodeURIComponent(id)}`, {
          method: "DELETE",
          headers: token ? { Authorization: `Bearer ${token}` } : {},
        });

        if (res.status === 401 || res.status === 403) {
          throw new Error("Login session expired or token invalid. Please logout, clear storage, and login again.");
        }

        if (!res.ok) {
          const errData = await res.json().catch(() => ({}));
          throw new Error(errData.error || errData.message || `Delete failed for record ${id}`);
        }

        return res.json().catch(() => ({}));
      };

      const failed = [];

      for (const id of idsToDelete) {
        try {
          await deleteOneRecord(id);
        } catch (err) {
          failed.push(err?.message || id);
        }
      }

      if (failed.length) {
        console.error("Delete failed rows:", failed);
        setDbStatus(null);
        alert(`❌ Some records were not deleted from DB. Failed: ${failed.length}`);
        return;
      }

      const idSet = new Set(idsToDelete.map(String));
      const deleteIndexes = new Set(
        rowsToDelete
          .map((r) => r?._realIdx)
          .filter((i) => Number.isInteger(i))
      );

      setData((prev) => {
        if (!Array.isArray(prev)) return prev;
        return prev.filter((row, idx) => {
          const rowId = getRecordMongoId(row);
          if (rowId && idSet.has(String(rowId))) return false;
          if (deleteIndexes.has(idx)) return false;
          return true;
        });
      });

      setFilters([]);
      setSearch("");
      setFilteredIdx([]);
      setPage(1);
      showSaved();
      alert(`✅ ${idsToDelete.length} record(s) deleted permanently from DB.`);
    } catch (err) {
      console.error("Delete filtered records failed:", err);
      setDbStatus(null);
      alert(err.message || "Error deleting filtered records");
    }
  }, [dSearch, filters, filteredData, setData, showSaved, showSaving, statusFilter, tierFilter, serverPaginated, fetchAllMatchingFilter, displayTotalRows]);

  useEffect(() => {
    if (page > totalPages) setPage(totalPages);
  }, [page, totalPages]);

  const tierCounts = useMemo(() => {
    const c = { Tier1:0, Tier2:0, Tier3:0, Tier4:0 };
    normRef.current.forEach(row => {
      const t = getRowTier(row);
      if (t && c[t] !== undefined) c[t]++;
    });
    return c;
  // eslint-disable-next-line
  }, [data]);

  /* ── Pricing lookups ── */
  const getCP = useCallback((row) => {
    if (!showPricing) return { autoCP:null, cpSource:null };
    const clientNameKey = (row["Client Name"] || row["Company Name"] || "").trim().toLowerCase();
    const selKey        = (selectedClient || "").toLowerCase();
    const ruleSets = [
      { arr: getRulesForKey(pricingRules, clientNameKey),      src: "client-rule" },
      { arr: getRulesForKey(pricingRules, selectedClient),     src: "client-rule" },
      { arr: getRulesForKey(clientPricing, clientNameKey),     src: "client-rule" },
      { arr: getRulesForKey(clientPricing, selectedClient),    src: "client-rule" },
      { arr: getRulesForKey(pricingRules, GLOBAL_PRICING_KEY), src: "global-rule" },
      { arr: getRulesForKey(clientPricing, GLOBAL_PRICING_KEY),src: "global-rule" },
    ];
    for (const { arr, src } of ruleSets) {
      if (!Array.isArray(arr) || !arr.length) continue;
      const cpRules = arr.filter(r => r.clientPrice !== undefined && r.clientPrice !== null && r.clientPrice !== "");
      const match   = findMatchingRule(cpRules, row);
      if (match) return { autoCP: match.clientPrice, cpSource: src };
    }
    const excelCP = getExcelClientPrice(row);
    if (excelCP !== null) return { autoCP: excelCP, cpSource: "excel" };
    return { autoCP: null, cpSource: null };
