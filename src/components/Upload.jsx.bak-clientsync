        const newRows = [];
        for (let i = 1; i < raw.length; i++) {
          const r    = raw[i];
          const pin  = pinCol  !== -1 ? String(r[pinCol]  || "").trim() : "";
          const dist = distCol !== -1 ? String(r[distCol] || "").trim() : "";
          const rawT = String(r[tierCol] || "").trim();
          const m    = rawT.match(/(\d)/);
          const tier = m ? `Tier${m[1]}` : rawT;
          if ((pin || dist) && tier) newRows.push({ pincode: pin || "", district: dist || "", tier });
        }

        if (!newRows.length) { alert("❌ No valid rows found."); setUploading(false); return; }
        persist([...rows, ...newRows]);
        alert(`✅ Added ${newRows.length} rows to your company pincode sheet!`);
      } catch (err) {
        alert("❌ " + (err.message || "Error reading file"));
      } finally { setUploading(false); }
    };
    reader.onerror = () => { alert("❌ File read failed"); setUploading(false); };
    reader.readAsArrayBuffer(file);
  };

  const handleDrop = (e) => { e.preventDefault(); setDrag(false); const f = e.dataTransfer.files?.[0]; if (f) parseFile(f); };
  const pincodeRows  = rows.filter(r => r.pincode);
  const districtRows = rows.filter(r => r.district);

  const tierCounts = useMemo(() => {
    const c = { Tier1: 0, Tier2: 0, Tier3: 0, Tier4: 0 };
    rows.forEach(r => { if (c[r.tier] !== undefined) c[r.tier]++; });
    return c;
  }, [rows]);

  const filteredPins = useMemo(() => {
    const sl = search.trim().toLowerCase();
    return pincodeRows.filter(r => {
      if (tierFilter !== "All" && r.tier !== tierFilter) return false;
      if (sl && !r.pincode.toLowerCase().includes(sl) && !r.tier.toLowerCase().includes(sl)) return false;
      return true;
    });
  }, [pincodeRows, search, tierFilter]);

  const filteredDists = useMemo(() => {
    const sl = search.trim().toLowerCase();
    return districtRows.filter(r => {
      if (tierFilter !== "All" && r.tier !== tierFilter) return false;
      if (sl && !r.district.toLowerCase().includes(sl) && !r.tier.toLowerCase().includes(sl)) return false;
      return true;
    });
  }, [districtRows, search, tierFilter]);

  const deleteRow = (idx, fromTab) => {
    const newRows = rows.filter((r) => {
      if (fromTab === "pincode")  return !(r.pincode  && pincodeRows.indexOf(r)  === idx);
      if (fromTab === "district") return !(r.district && districtRows.indexOf(r) === idx);
      return true;
    });
    persist(newRows);
  };

  const clearAll = () => {
    if (!window.confirm("Delete ALL rows from your company pincode sheet?")) return;
    persist([]);
  };

  return (
    <div className="pinsheet-glass">
      <div className="pinsheet-header">
        <div className="pinsheet-title">🏢 Company Pincode Sheet</div>
        <div style={{ display: "flex", alignItems: "center", gap: 10, flexWrap: "wrap" }}>
          {rows.length > 0 && (
            <div className="pinsheet-stats">
              {Object.entries(tierCounts).filter(([, c]) => c > 0).map(([t, c]) => {
                const s = TIER_COLORS[t];
                return (
                  <span key={t} className="pinsheet-stat"
                    style={{ background: s.bg, border: `1px solid ${s.border}`, color: s.color }}>
                    {t}: {c.toLocaleString()}
                  </span>
                );
              })}
            </div>
          )}
          {!readOnly && rows.length > 0 && (
            <button className="upl-btn upl-btn-red upl-btn-sm"
              style={{ fontSize: 11, padding: "6px 12px" }} onClick={clearAll}>🗑 Clear All</button>
          )}
          <button className="upl-btn upl-btn-red upl-btn-sm"
            style={{ fontSize: 11, padding: "6px 12px" }} onClick={onClose}>✕ Close</button>
        </div>
      </div>

      {!readOnly && (
        <div style={{ padding: "16px 22px", borderBottom: "1px solid var(--border2)" }}>
          <div className={`cpinsheet-upload-area ${drag ? "drag" : ""}`}
            onDragOver={e => { e.preventDefault(); setDrag(true); }}
            onDragLeave={() => setDrag(false)}
            onDrop={handleDrop}
            onClick={() => fileRef.current?.click()}>
            <input ref={fileRef} type="file" accept=".xlsx,.xls,.csv" style={{ display: "none" }}
              onChange={e => { parseFile(e.target.files?.[0]); e.target.value = null; }} />
            <div className="cpinsheet-upload-icon">📋</div>
            <div className="cpinsheet-upload-text">
              {uploading ? "⏳ Uploading…" : "Drop your pincode Excel here, or click to browse"}
            </div>
            <div className="cpinsheet-upload-sub">Supports .xlsx · .xls · .csv</div>
          </div>
          <div className="cpinsheet-format-note">
            <span style={{ fontSize: 14, flexShrink: 0 }}>ℹ️</span>
            <span>
              Your Excel must have a <strong>Pincode</strong> or <strong>District</strong> column and a <strong>Tier</strong> column
              with values <strong>Tier1</strong> – <strong>Tier4</strong>.
              Uploaded data is visible to your company admin and team members only.
            </span>
          </div>
        </div>
      )}

      {rows.length === 0 && (
        <div className="pinsheet-empty" style={{ padding: "48px 20px" }}>
          <div style={{ fontSize: 40, opacity: 0.25, marginBottom: 10 }}>📋</div>
          <div style={{ fontFamily: "var(--head)", fontSize: 14, fontWeight: 700, color: "var(--text3)", marginBottom: 6 }}>
            No pincode data yet
          </div>
          <div style={{ fontSize: 12.5, color: "var(--text3)", maxWidth: 340, margin: "0 auto", lineHeight: 1.6 }}>
            {readOnly
              ? "Your admin hasn't uploaded a pincode sheet yet. Contact your administrator."
              : "Upload an Excel file with Pincode + Tier columns above."}
          </div>
        </div>
      )}

      {rows.length > 0 && (
        <>
          <div style={{ display: "flex", gap: 0, borderBottom: "1px solid var(--border2)", background: "rgba(124,58,237,0.02)" }}>
            {[
              { key: "pincode",  label: `📌 By Pincode (${pincodeRows.length.toLocaleString()})` },
              { key: "district", label: `🗺️ By District (${districtRows.length.toLocaleString()})` },
            ].map(({ key, label }) => (
              <button key={key} onClick={() => setTab(key)}
                style={{ fontFamily: "var(--head)", fontSize: 12, fontWeight: 700, padding: "10px 20px", border: "none", cursor: "pointer", borderBottom: tab === key ? "2.5px solid #7c3aed" : "2.5px solid transparent", background: "transparent", color: tab === key ? "#7c3aed" : "var(--text3)", transition: "all 0.15s" }}>
                {label}
              </button>
            ))}
          </div>
          <div className="pinsheet-filters">
            <div style={{ position: "relative", display: "inline-flex", alignItems: "center" }}>
              <span style={{ position: "absolute", left: 10, color: "var(--text3)", fontSize: 13 }}>🔍</span>
              <input className="upl-input" style={{ paddingLeft: 32, width: 200, fontSize: 13 }}
                placeholder={tab === "pincode" ? "Search pincode…" : "Search district…"}
                value={search} onChange={e => setSearch(e.target.value)} />
            </div>
            <div style={{ display: "flex", gap: 6, flexWrap: "wrap" }}>
              {["All", "Tier1", "Tier2", "Tier3", "Tier4"].map(t => {
                const s = t !== "All" ? TIER_COLORS[t] : null;
                return (
                  <button key={t} onClick={() => setTierFilter(t)}
                    style={{ fontFamily: "var(--head)", fontSize: 11.5, fontWeight: 600, padding: "5px 12px", borderRadius: 99, cursor: "pointer", transition: "all 0.14s", background: tierFilter === t ? (s ? s.bg : "rgba(124,58,237,0.10)") : "transparent", border: tierFilter === t ? `1.5px solid ${s ? s.border : "rgba(124,58,237,0.35)"}` : "1.5px solid var(--border2)", color: tierFilter === t ? (s ? s.color : "#7c3aed") : "var(--text3)" }}>
                    {t}
                  </button>
                );
              })}
            </div>
            <span style={{ marginLeft: "auto", fontFamily: "var(--head)", fontSize: 12, color: "var(--text3)" }}>
              {tab === "pincode" ? filteredPins.length.toLocaleString() : filteredDists.length.toLocaleString()} results
            </span>
          </div>
          <div className="pinsheet-body">
            {tab === "pincode" ? (
              filteredPins.length === 0
                ? <div className="pinsheet-empty">No pincodes match your filter.</div>
                : (
                  <table className="pinsheet-table">
                    <thead><tr><th>Pincode</th><th>Tier</th>{!readOnly && <th style={{ width: 50 }}>Del</th>}</tr></thead>
                    <tbody>
                      {filteredPins.map((r, i) => (
                        <tr key={i}>
                          <td style={{ fontFamily: "var(--head)", fontWeight: 600 }}>{r.pincode}</td>
                          <td><TierBadge tier={r.tier} /></td>
                          {!readOnly && (
                            <td>
                              <button onClick={() => deleteRow(i, "pincode")}
                                style={{ background: "none", border: "none", cursor: "pointer", color: "#ef4444", fontSize: 14, padding: "2px 6px", borderRadius: 4 }}
                                title="Delete row">✕</button>
                            </td>
                          )}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )
            ) : (
              filteredDists.length === 0
                ? <div className="pinsheet-empty">No districts match your filter.</div>
                : (
                  <table className="pinsheet-table">
                    <thead><tr><th>District</th><th>Tier</th>{!readOnly && <th style={{ width: 50 }}>Del</th>}</tr></thead>
                    <tbody>
                      {filteredDists.map((r, i) => (
                        <tr key={i}>
                          <td style={{ fontFamily: "var(--head)", fontWeight: 600 }}>{r.district}</td>
                          <td><TierBadge tier={r.tier} /></td>
                          {!readOnly && (
                            <td>
                              <button onClick={() => deleteRow(i, "district")}
                                style={{ background: "none", border: "none", cursor: "pointer", color: "#ef4444", fontSize: 14, padding: "2px 6px", borderRadius: 4 }}
                                title="Delete row">✕</button>
                            </td>
                          )}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                )
            )}
          </div>
        </>
      )}
    </div>
  );
}

/* ══════════════════════════════════════════════════════════════════
   UPLOAD COMPONENT
══════════════════════════════════════════════════════════════════ */
export default function Upload({
  setClientData,
  selectedClient,
  setSelectedClient,
  pricingRules,
  setPricingRules,
  clientPricing,
  setClientPricing,
  isTeam        = false,
  isSuperAdmin  = false,
  isTeamMember  = false,
  allowedClients = null,
  tenantId,
}) {
  const showSAPincodeBtn      = isSuperAdmin || (isTeamMember && !tenantId);
  const showCompanyPincodeBtn = !isSuperAdmin;

  const CLIENT_WORKSPACE_ID = getClientWorkspaceId(tenantId, isSuperAdmin);
  const EFFECTIVE_IS_SUPER_ADMIN = CLIENT_WORKSPACE_ID === "__SUPERADMIN__";

  const CLIENTS_KEY = scopedKey("saved_upload_clients", CLIENT_WORKSPACE_ID);
  const CLIENT_PORTAL_STATE_KEY = `clients_${String(CLIENT_WORKSPACE_ID || "__LOCAL_COMPANY__").replace(/[^a-zA-Z0-9_-]/g, "_")}`;
  const DELETED_CLIENT_PORTAL_STATE_KEY = `deleted_clients_${String(CLIENT_WORKSPACE_ID || "__LOCAL_COMPANY__").replace(/[^a-zA-Z0-9_-]/g, "_")}`;

  /*
    ✅ Vendor scope fix:
    Vendors/pricing must NOT use plain tenantId because Super Admin / Secondary Admin
    can have tenantId empty/null, which makes everyone read same old localStorage key.
    CLIENT_WORKSPACE_ID already resolves to:
    - "__SUPERADMIN__" for Super Admin
    - company tenant/workspace/email for company/secondary admin
  */
  const VENDOR_WORKSPACE_ID = CLIENT_WORKSPACE_ID;
  const VENDOR_SCOPE_SAFE = String(VENDOR_WORKSPACE_ID || "__LOCAL_COMPANY__")
    .replace(/[^a-zA-Z0-9_-]/g, "_");

  const VENDORS_KEY = scopedKey("saved_upload_vendors", VENDOR_WORKSPACE_ID);
  const HISTORY_KEY = scopedKey("upload_file_history",   tenantId);
  const DELETED_CLIENTS_KEY = scopedKey("deleted_upload_clients", CLIENT_WORKSPACE_ID);
  const DELETED_VENDORS_KEY = scopedKey("deleted_upload_vendors", VENDOR_WORKSPACE_ID);

  const [file, setFile]           = useState(null);
  const [clients, setClients]     = useState(() => []);
  const [newClient, setNewClient] = useState("");

  const [clientStateName, setClientStateName]     = useState("");
  const [newLocationPrice, setNewLocationPrice]   = useState("");
  const [clientStateEmail, setClientStateEmail]   = useState("");
  const [clientStateCc, setClientStateCc]         = useState([]);   // array of validated CC emails
  const [clientStateCcInput, setClientStateCcInput] = useState(""); // raw chip input

  // Check-wise client pricing (Super Admin + internal team only) — separate
  // from the state-wise pricing above, does not touch any of it.
  const [checkPriceName, setCheckPriceName]       = useState("");
  const [newCheckPrice, setNewCheckPrice]         = useState("");
  const [checkPriceDropdownOpen, setCheckPriceDropdownOpen] = useState(false);

  const [vendors, setVendors]     = useState(() => safeGet(VENDORS_KEY, []));
  const [newVendor, setNewVendor] = useState("");

  const [stateName, setStateName]   = useState("");
  const [district, setDistrict]     = useState("");
  const [price, setPrice]           = useState("");
  const [vendorName, setVendorName] = useState("");

  const [syncStatus, setSyncStatus]   = useState(null);
  const [syncMsg, setSyncMsg]         = useState("");
  const [isUploading, setIsUploading] = useState(false);

  const [fileHistory, setFileHistory] = useState(() => safeGet(HISTORY_KEY, []));

  /* Pricing persistence state */
  const [pricingLoading, setPricingLoading]   = useState(false);
  const [pricingSaveState, setPricingSaveState] = useState("saved"); // "saving" | "saved" | "error"
  const saveTimerRef = useRef(null);

  const [showSASheet, setShowSASheet]           = useState(false);
  const [showCompanySheet, setShowCompanySheet] = useState(false);
  const [clientDropdownOpen, setClientDropdownOpen] = useState(false);
  const [clientPriceDropdownOpen, setClientPriceDropdownOpen] = useState(false);
  const [vendorListDropdownOpen, setVendorListDropdownOpen] = useState(false);
  const [activeRulesDropdownOpen, setActiveRulesDropdownOpen] = useState(false);
  const [globalRulesDropdownOpen, setGlobalRulesDropdownOpen] = useState(false);
  const [clientRulesDropdownOpen, setClientRulesDropdownOpen] = useState(false);
  const clientDropdownRef = useRef(null);
  const [pricingScope, setPricingScope] = useState("global");

  /*
    ✅ Vendor pricing scope fix:
    Vendor rules are saved in account-specific pricing keys, so Super Admin pricing
    cannot appear inside Company/Secondary Admin accounts.
  */
  const VENDOR_SCOPE_PREFIX = `__VENDOR_PRICING__${VENDOR_SCOPE_SAFE}__`;
  const VENDOR_GLOBAL_PRICING_KEY = `${VENDOR_SCOPE_PREFIX}GLOBAL`;

  const activePricingKey =
    pricingScope === "client" && selectedClient && selectedClient !== MASTER_KEY
      ? `${VENDOR_SCOPE_PREFIX}CLIENT__${nameKey(selectedClient)}`
      : VENDOR_GLOBAL_PRICING_KEY;

  /* Vendor names are shared across laptops using account-scoped portal-state. */
  const VENDOR_PORTAL_STATE_KEY = `vendors_${VENDOR_SCOPE_SAFE}`;

  const saveClientsToPortalState = async (updatedClients = []) => {
    try {
      await fetch(`${apiBaseUrl()}/auth/portal-state/${CLIENT_PORTAL_STATE_KEY}`, {
        method: "PUT",
        headers: getAuthHeaders(true),
        body: JSON.stringify({ value: mergeClientLists(updatedClients) }),
      });
    } catch (err) {
      console.warn("Client portal-state save failed:", err.message);
    }
  };

  const loadClientsFromPortalState = async () => {
    try {
      const res = await fetch(`${apiBaseUrl()}/auth/portal-state/${CLIENT_PORTAL_STATE_KEY}`, {
        headers: getAuthHeaders(),
      });
      const data = await res.json().catch(() => []);
      return Array.isArray(data)
        ? data
        : Array.isArray(data?.value)
          ? data.value
          : Array.isArray(data?.data)
            ? data.data
            : [];
    } catch (err) {
      console.warn("Client portal-state load failed:", err.message);
      return [];
    }
  };

  const saveDeletedClientsToPortalState = async (deletedClients = []) => {
    try {
      await fetch(`${apiBaseUrl()}/auth/portal-state/${DELETED_CLIENT_PORTAL_STATE_KEY}`, {
        method: "PUT",
        headers: getAuthHeaders(true),
        body: JSON.stringify({ value: mergeClientLists(deletedClients) }),
      });
    } catch (err) {
      console.warn("Deleted client portal-state save failed:", err.message);
    }
  };

  const loadDeletedClientsFromPortalState = async () => {
    try {
      const res = await fetch(`${apiBaseUrl()}/auth/portal-state/${DELETED_CLIENT_PORTAL_STATE_KEY}`, {
        headers: getAuthHeaders(),
      });
      const data = await res.json().catch(() => []);
      return Array.isArray(data)
        ? data
        : Array.isArray(data?.value)
          ? data.value
          : Array.isArray(data?.data)
            ? data.data
            : [];
    } catch (err) {
      console.warn("Deleted client portal-state load failed:", err.message);
      return [];
    }
  };

  const saveVendorsToPortalState = async (updatedVendors = []) => {
    try {
      await fetch(`${apiBaseUrl()}/auth/portal-state/${VENDOR_PORTAL_STATE_KEY}`, {
        method: "PUT",
        headers: getAuthHeaders(true),
        body: JSON.stringify({ value: mergeVendorLists(updatedVendors) }),
      });
    } catch (err) {
      console.warn("Vendor portal-state save failed:", err.message);
    }
  };

  /* ── Load pricing from DB on mount ── */
  useEffect(() => {
    if (isTeam) return; // team members don't need to load pricing here
    setPricingLoading(true);
    pricingAPI.getAll()
      .then(data => {
        if (data && typeof data === "object") {
          // Merge DB data into pricingRules (DB is source of truth)
          setPricingRules(prev => ({ ...prev, ...data }));
        }
      })
      .catch(err => console.warn("Could not load pricing from DB:", err.message))
      .finally(() => setPricingLoading(false));
  }, [tenantId]); // re-fetch if tenantId changes


  /* ── Keep vendor list synced from portal-state + pricing DB across all laptops ── */
  useEffect(() => {
    let alive = true;

    async function loadVendorsFromPortalState() {
      const localDeletedVendors = safeGet(DELETED_VENDORS_KEY, []);

      try {
        const res = await fetch(`${apiBaseUrl()}/auth/portal-state/${VENDOR_PORTAL_STATE_KEY}`, {
          headers: getAuthHeaders(),
        });
        const data = await res.json().catch(() => []);

        const portalVendors = Array.isArray(data)
          ? data
          : Array.isArray(data?.value)
            ? data.value
            : Array.isArray(data?.data)
              ? data.data
              : [];

        /*
          IMPORTANT FIX:
          Do NOT let this laptop's old local deleted-vendors list hide DB vendors.
          If a vendor exists in portal-state, DB is source of truth and it must show on every laptop.
        */
        const cleanedDeletedVendors = removeNamesFromDeleted(portalVendors, localDeletedVendors);
        safeSet(DELETED_VENDORS_KEY, cleanedDeletedVendors);

        const localVendors = safeGet(VENDORS_KEY, []).filter(
          v => !isNameDeleted(v, cleanedDeletedVendors)
        );

        const currentVendorPricingRules = Object.fromEntries(
          Object.entries(pricingRules || {}).filter(([k]) =>
            String(k || "").startsWith(VENDOR_SCOPE_PREFIX)
          )
        );

        const pricingVendors = extractVendorNamesFromPricingRules(currentVendorPricingRules).filter(
          v => !isNameDeleted(v, cleanedDeletedVendors)
        );

        if (!alive) return;

const merged = mergeVendorLists(portalVendors, pricingVendors);

        setVendors(merged);
        safeSet(VENDORS_KEY, merged);

        // Backfill portal-state when old pricing rules/localStorage contain vendor names but portal-state is incomplete.
        if (merged.length && portalVendors.length !== merged.length) {
          saveVendorsToPortalState(merged);
        }
      } catch (err) {
        console.warn("Could not load vendors from portal-state:", err.message);
        if (!alive) return;

        const cleanedDeletedVendors = safeGet(DELETED_VENDORS_KEY, []);
        const localVendors = safeGet(VENDORS_KEY, []).filter(
          v => !isNameDeleted(v, cleanedDeletedVendors)
        );
        const currentVendorPricingRules = Object.fromEntries(
          Object.entries(pricingRules || {}).filter(([k]) =>
            String(k || "").startsWith(VENDOR_SCOPE_PREFIX)
          )
        );

        const pricingVendors = extractVendorNamesFromPricingRules(currentVendorPricingRules).filter(
          v => !isNameDeleted(v, cleanedDeletedVendors)
        );

     const merged = mergeVendorLists(pricingVendors);
        setVendors(merged);
        safeSet(VENDORS_KEY, merged);
      }
    }

    loadVendorsFromPortalState();

    return () => { alive = false; };
  }, [pricingRules, VENDORS_KEY, DELETED_VENDORS_KEY]);

  /* ── Persist a single scope key to DB (debounced 400ms) ── */
  const persistScope = useCallback((scopeKey, rules) => {
    if (isTeam) return;
    setPricingSaveState("saving");
    if (saveTimerRef.current) clearTimeout(saveTimerRef.current);
    saveTimerRef.current = setTimeout(() => {
      pricingAPI.saveScope(scopeKey, rules)
        .then(() => setPricingSaveState("saved"))
        .catch(err => {
          console.error("Pricing save failed:", err.message);
          setPricingSaveState("error");
        });
    }, 400);
  }, [isTeam]);

  useEffect(() => {
    let alive = true;

    const deletedVendors = safeGet(DELETED_VENDORS_KEY, []);

    // Cross-laptop client fix:
    // Do NOT preload clients from localStorage. Another laptop may still have old
    // secondary-admin clients cached under the Super Admin login. Clients below are
    // loaded only from workspace-scoped portal-state/DB and then cached again.
    const localClients = [];
    const localVendors = safeGet(VENDORS_KEY, []).filter(v => !isNameDeleted(v, deletedVendors));
    setClients([]);
setVendors([]);
    safeSet(CLIENTS_KEY, []);
    safeSet(VENDORS_KEY, localVendors);
    setFileHistory([]); // keep upload page fresh; do not show old laptop-only history

    async function loadClientsFromServer() {
      try {
        const portalClients = await loadClientsFromPortalState();
        let dbClients = [];

        try {
          const data = await clientAPI.getAll();
          const scopedClientRecords = filterClientRecordsByWorkspace(data, CLIENT_WORKSPACE_ID, EFFECTIVE_IS_SUPER_ADMIN);
          dbClients = extractClientNamesFromApi(scopedClientRecords);
        } catch (dbErr) {
          console.warn("Could not load clients from DB:", dbErr.message);
        }

        if (!alive) return;

        // Portal-state is used as the reliable workspace-scoped source for Company/Secondary Admins.
        // DB clients are still merged when available, but Super Admin clients cannot leak into Secondary Admin.
        const sourceClients = mergeClientLists(portalClients, dbClients);

        // Persistent delete protection across all laptops:
        // Deleted clients are stored in workspace-scoped portal-state so another
        // browser/laptop cannot bring them back from old cache or stale DB records.
        const cleanedDeleted = mergeClientLists(
          safeGet(DELETED_CLIENTS_KEY, []),
          await loadDeletedClientsFromPortalState()
        );
        safeSet(DELETED_CLIENTS_KEY, cleanedDeleted);
        await saveDeletedClientsToPortalState(cleanedDeleted);

        const visibleSourceClients = sourceClients.filter(c => !isNameDeleted(c, cleanedDeleted));
        const merged = mergeClientLists(visibleSourceClients);

        setClients(merged);
        safeSet(CLIENTS_KEY, merged);
      } catch (err) {
        console.warn("Could not load clients:", err.message);
        if (alive) setClients([]);
      }
    }

    loadClientsFromServer();

    return () => { alive = false; };
  }, [tenantId, CLIENT_WORKSPACE_ID, isSuperAdmin]);

  useEffect(() => {
    const handleClickOutside = (event) => {
      if (clientDropdownRef.current && !clientDropdownRef.current.contains(event.target)) {
        setClientDropdownOpen(false);
      }
    };
    document.addEventListener("mousedown", handleClickOutside);
    return () => document.removeEventListener("mousedown", handleClickOutside);
  }, []);

  /* ── Client helpers ── */
  const handleClientSelect = (c) => {
    if (c !== selectedClient) setFile(null);
    setSelectedClient(c);
  };
  const addClient = async () => {
    const t = normalizeClientName(newClient);
    if (!t) return;

    const exists = clients.some(c => c.toLowerCase() === t.toLowerCase());
    if (exists) { alert("Client already exists"); return; }

    setSyncStatus("syncing");
    setSyncMsg(`Saving client "${t}"…`);

    const deletedClients = removeNameFromDeleted(t, safeGet(DELETED_CLIENTS_KEY, []));
    safeSet(DELETED_CLIENTS_KEY, deletedClients);
    await saveDeletedClientsToPortalState(deletedClients);

    const updated = mergeClientLists(clients, [t]);
    setClients(updated);
    setNewClient("");
    safeSet(CLIENTS_KEY, updated);

    // Save in account-scoped portal-state first. This prevents Super Admin clients
    // from leaking into Secondary Admin and avoids backend /clients 504 blocking the UI.
    await saveClientsToPortalState(updated);

    // Best-effort MongoDB /clients sync. If this route times out for Secondary Admin,
    // do not block client creation because portal-state already synced the workspace.
    try {
      await syncClientsToBackend([t], CLIENT_WORKSPACE_ID);
    } catch (err) {
      console.warn("Manual client DB sync skipped/failed:", err.message);
    }

    setSyncStatus("ok");
    setSyncMsg(`✅ Client "${t}" saved for this workspace`);
  };
  const removeClient = async (c) => {
    if (!c) return;
    if (!window.confirm(`Permanently remove client "${c}" from this workspace and database?`)) return;

    const deletedClients = mergeClientLists(safeGet(DELETED_CLIENTS_KEY, []), [c]);
    safeSet(DELETED_CLIENTS_KEY, deletedClients);
    await saveDeletedClientsToPortalState(deletedClients);

    const updated = clients.filter(x => nameKey(x) !== nameKey(c));
    setClients(updated);
    if (selectedClient === c) handleClientSelect("");
    safeSet(CLIENTS_KEY, updated);
    await saveClientsToPortalState(updated);

    setPricingRules(prev => {
      const next = { ...prev };
      delete next[c];
      return next;
    });

    setSyncStatus("syncing");
    setSyncMsg(`Removing client "${c}" from database…`);

    await Promise.allSettled([
      deleteClientFromDBByName(c, CLIENT_WORKSPACE_ID, clientAPI),
      deletePricingScopeFromDB(c, pricingAPI),
    ]);

    setSyncStatus("ok");
    setSyncMsg(`✅ Client "${c}" removed permanently`);
  };
  const clearAllClients = async () => {
    if (!window.confirm("Permanently remove ALL saved clients for this workspace?")) return;
    const toDelete = [...clients];
    const deletedClients = mergeClientLists(safeGet(DELETED_CLIENTS_KEY, []), toDelete);
    safeSet(DELETED_CLIENTS_KEY, deletedClients);
    await saveDeletedClientsToPortalState(deletedClients);

    setClients([]);
    handleClientSelect("");
    localStorage.removeItem(CLIENTS_KEY);
    await saveClientsToPortalState([]);

    setPricingRules(prev => {
      const next = { ...prev };
      toDelete.forEach(c => delete next[c]);
      return next;
    });

    setSyncStatus("syncing");
    setSyncMsg("Removing clients from this workspace…");
    await Promise.allSettled(toDelete.flatMap(c => [
      deleteClientFromDBByName(c, CLIENT_WORKSPACE_ID, clientAPI),
      deletePricingScopeFromDB(c, pricingAPI),
    ]));
    setSyncStatus("ok");
    setSyncMsg("✅ All saved clients removed permanently");
  };

  /* ── Vendor helpers ── */
  const addVendor = async () => {
    const t = normalizeVendorName(newVendor);
    if (!t) return;
    if (vendors.some(v => nameKey(v) === nameKey(t))) { alert("Vendor already exists"); return; }

    const deletedVendors = removeNameFromDeleted(t, safeGet(DELETED_VENDORS_KEY, []));
    safeSet(DELETED_VENDORS_KEY, deletedVendors);

    const updated = mergeVendorLists(vendors, [t]);
    setVendors(updated);
    setNewVendor("");
    safeSet(VENDORS_KEY, updated);
    await saveVendorsToPortalState(updated);

    // Save vendor name marker in DB so vendor list appears on every laptop.
    // This marker has no rate, so it does NOT affect pricing calculations.
    setPricingRules(prev => {
      const existingRules = Array.isArray(prev[VENDOR_GLOBAL_PRICING_KEY]) ? prev[VENDOR_GLOBAL_PRICING_KEY] : [];
      const alreadyExists = existingRules.some(r => nameKey(r?.vendorName) === nameKey(t));
      if (alreadyExists) return prev;

      const nextRules = [
        ...existingRules,
        {
          vendorName: t,
          state: "",
          district: "",
          _vendorOnly: true,
        },
      ];

      persistScope(VENDOR_GLOBAL_PRICING_KEY, nextRules);
      return { ...prev, [VENDOR_GLOBAL_PRICING_KEY]: nextRules };
    });
  };
  const removeVendor = async (v) => {
    if (!v) return;
    if (!window.confirm(`Permanently remove vendor "${v}" and all its pricing rules?`)) return;

    const deletedVendors = mergeVendorLists(safeGet(DELETED_VENDORS_KEY, []), [v]);
    safeSet(DELETED_VENDORS_KEY, deletedVendors);

    const updated = vendors.filter(x => nameKey(x) !== nameKey(v));
    setVendors(updated);
    if (nameKey(vendorName) === nameKey(v)) setVendorName("");
    safeSet(VENDORS_KEY, updated);
    await saveVendorsToPortalState(updated);

    setSyncStatus("syncing");
    setSyncMsg(`Removing vendor "${v}" from pricing database…`);

    setPricingRules(prev => {
      const next = { ...prev };
      Object.keys(next).forEach(scopeKey => {
        // ✅ Remove only this account's vendor rules. Do not touch Super Admin/other admin scopes.
        if (!String(scopeKey || "").startsWith(VENDOR_SCOPE_PREFIX)) return;

        const rules = Array.isArray(next[scopeKey]) ? next[scopeKey] : [];
        const filtered = rules.filter(r => nameKey(r?.vendorName) !== nameKey(v));
        if (filtered.length !== rules.length) {
          next[scopeKey] = filtered;
          persistScope(scopeKey, filtered);
        }
      });
      return next;
    });

    setSyncStatus("ok");
    setSyncMsg(`✅ Vendor "${v}" removed permanently`);
  };

  /* ── Helper: update pricingRules state + persist to DB ── */
  const updatePricingRules = useCallback((scopeKey, newRules) => {
    setPricingRules(prev => {
      const updated = { ...prev, [scopeKey]: newRules };
      persistScope(scopeKey, newRules);
      return updated;
    });
  }, [setPricingRules, persistScope]);

  /* ── Client location pricing (STATE-WISE ONLY) ── */
  const handleAddClientLocationPrice = () => {
    const targetClient = selectedClient && selectedClient !== MASTER_KEY ? selectedClient : null;
    if (!targetClient) return alert("Please select a specific client first");

    const st = clientStateName.trim();
    const pv = Number(newLocationPrice);

    if (!st || !pv) return alert("Please enter state and price");

    const stateKey = st.toLowerCase();
    const cr = pricingRules[targetClient] || [];
    const existing = cr.find(r =>
      String(r.state || "").trim().toLowerCase() === stateKey &&
      r.clientPrice !== undefined
    ) || {};

    // Validate and clean email/CC
    const emailVal = clientStateEmail.trim().toLowerCase();
    const isValidE = (e) => /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e);
    const cleanEmail = emailVal && isValidE(emailVal) ? emailVal : "";
    // also flush any pending raw CC input
    const pendingCc = clientStateCcInput.trim()
      ? clientStateCcInput.split(/[,;]+/).map(s => s.trim().toLowerCase()).filter(isValidE)
      : [];
    const cleanCc = [...clientStateCc, ...pendingCc];

    const upd = [
      ...cr.filter(r => !(
        String(r.state || "").trim().toLowerCase() === stateKey &&
        r.clientPrice !== undefined
      )),
      {
        ...existing,
        state: st,
        district: "",
        clientPrice: pv,
        email:  cleanEmail,
        ccList: cleanCc,
      },
    ];

    updatePricingRules(targetClient, upd);
    setClientStateName("");
    setNewLocationPrice("");
    setClientStateEmail("");
    setClientStateCc([]);
    setClientStateCcInput("");
  };

  const removeClientLocationPrice = (ck, stateToRemove) => {
    const upd = (pricingRules[ck] || [])
      .map(r => {
        const sameState =
          String(r.state || "").trim().toLowerCase() ===
          String(stateToRemove || "").trim().toLowerCase();
        if (!(sameState && r.clientPrice !== undefined)) return r;
        const { clientPrice, ...rest } = r;
        return rest;
      })
      .filter(r => r.rate !== undefined || r.clientPrice !== undefined);
    updatePricingRules(ck, upd);
  };

  /* ── Client check-wise pricing (Super Admin + internal team only) ── */
  const handleAddClientCheckPrice = () => {
    const targetClient = selectedClient && selectedClient !== MASTER_KEY ? selectedClient : null;
    if (!targetClient) return alert("Please select a specific client first");

    const ck = checkPriceName.trim();
    const pv = Number(newCheckPrice);

    if (!ck || !pv) return alert("Please enter check name and price");

    const checkKey = ck.toLowerCase();
    const cr = pricingRules[targetClient] || [];
    const existing = cr.find(r =>
      String(r.checkName || "").trim().toLowerCase() === checkKey &&
      r.clientPrice !== undefined
    ) || {};

    const upd = [
      ...cr.filter(r => !(
        String(r.checkName || "").trim().toLowerCase() === checkKey &&
        r.clientPrice !== undefined
      )),
      {
        ...existing,
        checkName: ck,
        state: "",
        district: "",
        clientPrice: pv,
      },
    ];

    updatePricingRules(targetClient, upd);
    setCheckPriceName("");
    setNewCheckPrice("");
  };

  const removeClientCheckPrice = (ck, checkToRemove) => {
    const upd = (pricingRules[ck] || [])
      .map(r => {
        const sameCheck =
          String(r.checkName || "").trim().toLowerCase() ===
          String(checkToRemove || "").trim().toLowerCase();
        if (!(sameCheck && r.clientPrice !== undefined)) return r;
        const { clientPrice, ...rest } = r;
        return rest;
      })
      .filter(r => r.rate !== undefined || r.clientPrice !== undefined);
    updatePricingRules(ck, upd);
  };

  /* ── Vendor pricing helpers (STATE-WISE ONLY + VENDOR-WISE) ── */
  const vendorKey = (v = "") => String(v || "").trim().toLowerCase();

  const isSameVendorRule = (ruleVendor, selectedVendor) => {
    const rv = vendorKey(ruleVendor);
    const sv = vendorKey(selectedVendor);
    return sv ? rv === sv : !rv;
  };

  const handleVendorStateChange = (e) => {
    const val = e.target.value;
    setStateName(val);

    const stateKey = val.trim().toLowerCase();
    const selectedVendorKey = vendorKey(vendorName);
    const existing = (pricingRules[activePricingKey] || []).find(
      r =>
        r.rate !== undefined &&
        String(r.state || "").trim().toLowerCase() === stateKey &&
        isSameVendorRule(r.vendorName, selectedVendorKey)
    );

    if (existing) {
      if (existing.rate) setPrice(existing.rate);
      if (existing.vendorName) setVendorName(existing.vendorName);
    }
  };

  const applyPricing = () => {
    if (!vendorName.trim()) return alert("Please select vendor name first");
    if (!stateName || !price) return alert("Enter state & price");

    const st = stateName.trim();
    const rp = Number(price);
    const vn = vendorName.trim();
    const stateKey = st.toLowerCase();
    const selectedVendorKey = vendorKey(vn);
    const cr = pricingRules[activePricingKey] || [];

    const ex = cr.find(r =>
      r.rate !== undefined &&
      String(r.state || "").trim().toLowerCase() === stateKey &&
      vendorKey(r.vendorName) === selectedVendorKey
    ) || {};

    const upd = [
      ...cr.filter(r => !(
        r.rate !== undefined &&
        String(r.state || "").trim().toLowerCase() === stateKey &&
        vendorKey(r.vendorName) === selectedVendorKey
      )),
      {
        ...ex,
        state: st,
        district: "",
        rate: rp,
        vendorName: vn,
      },
    ];

    updatePricingRules(activePricingKey, upd);
    setStateName("");
    setDistrict("");
    setPrice("");
  };

  const deleteRule = (key, stateToRemove, vendorToRemove = "") => {
    const stateKey = String(stateToRemove || "").trim().toLowerCase();
    const selectedVendorKey = vendorKey(vendorToRemove);

    const upd = (pricingRules[key] || [])
      .map(r => {
        const sameState =
          r.rate !== undefined &&
          String(r.state || "").trim().toLowerCase() === stateKey;
        const sameVendor = selectedVendorKey
          ? vendorKey(r.vendorName) === selectedVendorKey
          : true;

        if (!(sameState && sameVendor)) return r;

        const { rate, state, district: _district, vendorName: vn, ...rest } = r;
        return rest;
      })
      .filter(r => r.rate !== undefined || r.clientPrice !== undefined);

    updatePricingRules(key, upd);
  };
  /* ── Excel select: manual client/vendor only (NO client/vendor auto-detect) ── */
  const handleExcelFileSelect = (selectedFile) => {
    setFile(selectedFile || null);
    if (selectedFile) {
      setSyncStatus("ok");
      setSyncMsg("✅ Excel selected — Client Name column must match saved clients");
    } else {
      setSyncStatus(null);
      setSyncMsg("");
    }
  };

  /* ── Upload handler ── */
  const handleUpload = async () => {
    if (!file) { alert("Please select an Excel file to upload"); return; }
    setIsUploading(true); setSyncStatus("syncing"); setSyncMsg("Parsing Excel…");

    const reader = new FileReader();
    reader.onload = async (e) => {
      try {
        const buffer   = new Uint8Array(e.target.result);
        const workbook = XLSX.read(buffer, { type: "array" });
        const sheetName = workbook.SheetNames[0];
        if (!sheetName) { alert("❌ No sheet found"); setIsUploading(false); setSyncStatus(null); return; }
        const sheet   = workbook.Sheets[sheetName];
        const rawData = XLSX.utils.sheet_to_json(sheet, { header: 1, raw: false, dateNF: "dd/mm/yyyy", cellDates: true });
        if (!rawData || rawData.length === 0) { alert("❌ Excel is empty"); setIsUploading(false); setSyncStatus(null); return; }

        const headers = rawData[0];

        // ✅ Client validation for huge uploads:
        // No need to manually select one client.
        // Excel must have Client Name column and every Client Name must already exist in saved clients.
        const clientColIndex = headers.findIndex((h) => {
          const key = String(h || "").trim().toLowerCase();
          return (
            key === "client name" ||
            key === "client" ||
            key === "company name"
          );
        });

        if (clientColIndex === -1) {
          alert("❌ Excel rejected. Excel must have a Client Name column.");
          setIsUploading(false);
          setSyncStatus(null);
          return;
        }

        const deletedClients = mergeClientLists(
          safeGet(DELETED_CLIENTS_KEY, []),
          await loadDeletedClientsFromPortalState()
        );
        safeSet(DELETED_CLIENTS_KEY, deletedClients);

        // CLIENT MATCH FIX + cross-laptop isolation:
        // Use the freshest workspace clients from React state + portal-state + DB only.
        // Do NOT read saved_upload_clients localStorage here because another laptop can
        // still have old secondary-admin clients cached under Super Admin login.
        let latestPortalClients = [];
        let latestDbClients = [];

        try {
          latestPortalClients = await loadClientsFromPortalState();
        } catch (portalErr) {
          console.warn("Client portal-state refresh before upload failed:", portalErr.message);
        }

        try {
          const dbClientData = await clientAPI.getAll();
          const scopedClientRecords = filterClientRecordsByWorkspace(dbClientData, CLIENT_WORKSPACE_ID, EFFECTIVE_IS_SUPER_ADMIN);
          latestDbClients = extractClientNamesFromApi(scopedClientRecords);
        } catch (dbErr) {
          console.warn("Client DB refresh before upload failed:", dbErr.message);
        }

        const activeClients = mergeClientLists(
          clients,
          latestPortalClients,
          latestDbClients
        ).filter(c => !isNameDeleted(c, deletedClients));

        if (activeClients.length) {
          setClients(activeClients);
          safeSet(CLIENTS_KEY, activeClients);
        }

        const clientMap = new Map(activeClients.map(c => [strictClientKey(c), c]));

        if (clientMap.size === 0) {
          alert("❌ No saved clients found. Please add clients first, then upload Excel.");
          setIsUploading(false);
          setSyncStatus(null);
          return;
        }

        const invalidClientRows = [];
        const usedClientMap = new Map();

        rawData.slice(1).forEach((row, idx) => {
          if (!row || row.length === 0) return;

          const excelClient = row[clientColIndex] === undefined || row[clientColIndex] === null
            ? ""
            : normalizeClientName(row[clientColIndex]);

          const existingClient = clientMap.get(strictClientKey(excelClient));

          if (!excelClient || !existingClient) {
            invalidClientRows.push({ rowNo: idx + 2, excelClient: excelClient || "Blank" });
            return;
          }

          usedClientMap.set(strictClientKey(excelClient), existingClient);
        });

        if (invalidClientRows.length > 0) {
          const sample = invalidClientRows
            .slice(0, 8)
            .map((r) => `Row ${r.rowNo}: ${r.excelClient}`)
            .join("\n");

          alert(
            `❌ Excel rejected.\n\nEvery Client Name in Excel must already exist in your saved client list.\n\nInvalid/blank client rows: ${invalidClientRows.length}${sample ? `\n\n${sample}` : ""}`
          );
          setIsUploading(false);
          setSyncStatus(null);
          return;
        }

        let tierAssigned = 0;

        const finalData = rawData
          .slice(1)
          .filter(r => r && r.length > 0)
          .map(row => {
            const obj = {};
            headers.forEach((key, idx) => {
              if (!key) return;
              if (String(key).toLowerCase().includes("assign date")) return;
              obj[key] = cleanCell(row[idx]);
            });

            // ✅ Keep same normalized client mapping while creating final data
            const excelClient = row[clientColIndex] === undefined || row[clientColIndex] === null
              ? ""
              : normalizeClientName(row[clientColIndex]);
            const resolvedClient = clientMap.get(strictClientKey(excelClient)) || excelClient;

            const rawStatus =
              obj["Status"] || obj["status"] || obj["STATUS"] ||
              obj["Case Status"] || obj["case status"] || obj["BGV Status"] ||
              obj["bgv status"] || obj["Verification Status"] || obj["verification status"] ||
              obj["Current Status"] || obj["current status"] || "";
            obj["Status"] = normaliseStatus(rawStatus);
            obj["status"] = obj["Status"];

            const existingTier =
              obj["Tier"] || obj["tier"] || obj["TIER"] ||
              obj["Tier Type"] || obj["tier type"] || obj["TierType"] || "";
            if (!existingTier) {
              const autoTier = getTierForRow(obj);
              if (autoTier) { obj["Tier"] = autoTier; tierAssigned++; }
            } else {
              const t = String(existingTier).trim();
              const match = t.match(/(\d)/);
              if (match) obj["Tier"] = `Tier${match[1]}`;
            }

            return {
              rate: 0,
              agent: "",
              assignDate: "",
              ...obj,
              // Client is taken from Excel only if it already exists in saved clients.
              "Client Name": resolvedClient,
              Client: resolvedClient,
              clientName: resolvedClient,
              // Vendor is still manual only. Excel vendor columns are ignored/overwritten.
              "Vendor Name": vendorName || "",
              Vendor: vendorName || "",
              vendorName: vendorName || "",
            };
          });

        if (finalData.length === 0) { alert("❌ No valid data found"); setIsUploading(false); setSyncStatus(null); return; }

        const groupedData = {};
        finalData.forEach(row => {
          const c = normalizeClientName(row.clientName || row["Client Name"] || row.Client || "General");
          if (!groupedData[c]) groupedData[c] = [];
          groupedData[c].push(row);
        });
        groupedData[MASTER_KEY] = finalData;

        const usedClients = Array.from(usedClientMap.values());
        setClientData(prev => ({ ...prev, ...groupedData }));
        setSelectedClient(MASTER_KEY);

        // Keep this upload page fresh for client handover: no old laptop-only upload history.
        setFileHistory([]);
        localStorage.removeItem(HISTORY_KEY);
        localStorage.removeItem(scopedKey("lastUploadedFileName", tenantId));
        localStorage.removeItem(scopedKey("lastUploadedFileRows", tenantId));

        setSyncMsg("Saving records to database…");
        try {
          // Do not auto-create clients here. Upload is allowed only for clients that already exist.
          const dbClientParam = selectedClient && selectedClient !== MASTER_KEY ? selectedClient : "";
          const result = await uploadAPI.uploadExcel(file, dbClientParam, tenantId);
          setSyncStatus("ok");
          setSyncMsg(`✅ ${result.count || finalData.length} records saved to MongoDB`);
        } catch (syncErr) {
          setSyncStatus("error");
          setSyncMsg(`⚠️ Local save OK — DB sync failed: ${syncErr.message}`);
        }

        alert(
          `✅ Upload successful!\n\nTotal rows: ${finalData.length}\nTier auto-assigned: ${tierAssigned} rows\n` +
          `Clients found: ${usedClients.join(", ")}\n` +
          `Workspace: ${tenantId || "default"}`
        );
      } catch (err) {
        alert(err.message || "❌ Error processing Excel file");
        setSyncStatus("error"); setSyncMsg(err.message);
      } finally {
        setIsUploading(false);
      }
    };
    reader.onerror = () => { alert("❌ File reading failed"); setIsUploading(false); setSyncStatus(null); };
    reader.readAsArrayBuffer(file);
  };

  /* ── Derived ── */
  const isReady            = !!file && !isUploading;
  const activeRules        = pricingRules[activePricingKey] || [];
  const selectedVendorKeyForRules = String(vendorName || "").trim().toLowerCase();
  const activeVendorRules  = selectedVendorKeyForRules
    ? activeRules.filter(r =>
        r.rate !== undefined &&
        String(r.vendorName || "").trim().toLowerCase() === selectedVendorKeyForRules
      )
    : [];
  const clientForLocation  = selectedClient && selectedClient !== MASTER_KEY ? selectedClient : null;
  const clientLocationRules = clientForLocation
    ? (pricingRules[clientForLocation] || []).filter(r => r.clientPrice !== undefined && !r.checkName)
    : [];
  const clientCheckRules = clientForLocation
    ? (pricingRules[clientForLocation] || []).filter(r => r.clientPrice !== undefined && r.checkName)
    : [];
  const totalVendorRules = Object.entries(pricingRules || {})
    .filter(([k]) => String(k || "").startsWith(VENDOR_SCOPE_PREFIX))
    .reduce((sum, [, arr]) => sum + (Array.isArray(arr) ? arr.filter(r => r.rate !== undefined).length : 0), 0);

  /* ═══════════════════════ RENDER ═══════════════════════ */
  return (
    <div className="upl-root">
      <div className="upl-wrap">

        {/* Top bar */}
        <div className="upl-topbar">
          <div>
            <div className="upl-title">Data Upload</div>
            <div className="upl-subtitle">
              {isTeam ? "Select client and upload your Excel file" : "Upload Excel — Client Name must exist; Tier auto-detected"}
            </div>
          </div>
          <div style={{ display: "flex", alignItems: "center", gap: 10, flexWrap: "wrap" }}>
            {tenantId && (
              <span className="workspace-badge">
                🗂️ {String(tenantId).slice(0, 16)}{tenantId.length > 16 ? "…" : ""}
              </span>
            )}

            {showSAPincodeBtn && (
              <button className="upl-btn upl-btn-purple upl-btn-sm"
                onClick={() => { setShowSASheet(v => !v); setShowCompanySheet(false); }}
                style={{ gap: 7 }}>
                👑 {showSASheet ? "Hide" : "View"} Master Pincode Sheet
              </button>
            )}
            {showCompanyPincodeBtn && (
              <button
                onClick={() => { setShowCompanySheet(v => !v); setShowSASheet(false); }}
                style={{
                  fontFamily: "var(--head)", fontSize: 13, fontWeight: 600,
                  padding: "8px 16px", borderRadius: "var(--r8)", cursor: "pointer",
                  transition: "all 0.18s var(--ease)", whiteSpace: "nowrap",
                  background: showCompanySheet ? "linear-gradient(135deg,#7c3aed,#a78bfa)" : "rgba(124,58,237,0.08)",
                  border: "1.5px solid rgba(124,58,237,0.35)",
                  color: showCompanySheet ? "#fff" : "#7c3aed",
                  boxShadow: showCompanySheet ? "0 4px 12px rgba(124,58,237,0.28)" : "none",
                  display: "inline-flex", alignItems: "center", gap: 7,
                }}>
                🏢 {showCompanySheet ? "Hide" : "View"} Company Pincode Sheet
                {isTeam && (
