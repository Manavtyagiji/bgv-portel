function getAuthHeaders(json = false) {
  let token = "";
  try {
    const cu = JSON.parse(sessionStorage.getItem("currentUser") || "{}");
    token = cu?.token || sessionStorage.getItem("token") || sessionStorage.getItem("authToken") || sessionStorage.getItem("jwt") || "";
  } catch {
    token = sessionStorage.getItem("token") || sessionStorage.getItem("authToken") || sessionStorage.getItem("jwt") || "";
