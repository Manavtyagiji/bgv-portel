                    ? `${activeVendorRules.length} workspace rule${activeVendorRules.length !== 1 ? "s" : ""}`
                    : `${activeVendorRules.length} rule${activeVendorRules.length !== 1 ? "s" : ""} for ${selectedClient}`}
              </span>
            </div>
            <div className="pricing-body">
              <div className="vendor-name-section">
                <div className="vendor-name-label">🏪 Vendor Company Name</div>
                <div className="upl-inline" style={{ maxWidth: 340 }}>
                  <select className="upl-select" value={vendorName} onChange={e => setVendorName(e.target.value)}>
                    <option value="">Select vendor…</option>
                    {vendors.map((v, i) => <option key={i}>{v}</option>)}
                  </select>
                </div>
                <div className="upl-inline" style={{ maxWidth: 340, marginTop: 6 }}>
                  <input className="upl-input" placeholder="New vendor name…" value={newVendor}
                    onChange={e => setNewVendor(e.target.value)} onKeyDown={e => e.key === "Enter" && addVendor()} />
                  <button className="upl-btn upl-btn-cyan upl-btn-sm" onClick={addVendor}>+ Add</button>
                </div>
                {vendors.length > 0 && (
                  <div className="upl-dropdown-box">
                    <button type="button" className="upl-dropdown-btn" onClick={() => setVendorListDropdownOpen(v => !v)}>
                      <span>🏪 Saved Vendors ({vendors.length})</span>
                      <span>{vendorListDropdownOpen ? "▲" : "▼"}</span>
                    </button>
                    {vendorListDropdownOpen && (
                      <div className="upl-dropdown-panel">
                        {vendors.map((v, i) => (
                          <div key={i} className={`upl-dropdown-row ${vendorName === v ? "active" : ""}`} onClick={() => { setVendorName(v); setVendorListDropdownOpen(false); }}>
                            <span>{v}</span>
                            <button type="button" className="upl-dropdown-del" onClick={ex => { ex.stopPropagation(); removeVendor(v); }}>✕</button>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                )}
              </div>
              <div className="pricing-divider" style={{ marginTop: 4, marginBottom: 4 }} />
              <div className="pricing-vendor-section">
                <div className="pricing-vendor-label">🗺️ Add / Update Vendor Location Rule</div>
                <div className="pricing-vendor-inputs">
                  <input className="upl-input" placeholder="State" value={stateName} onChange={handleVendorStateChange} style={{ maxWidth: 220 }} />
                  <input className="upl-input" type="number" placeholder="Price ₹" value={price} onChange={e => setPrice(e.target.value)} style={{ maxWidth: 150 }} />
                  <button className="upl-btn upl-btn-amber" onClick={applyPricing}>✦ Save Rule</button>
                </div>
                <div style={{ fontSize: 11.5, color: "var(--text3)", fontFamily: "var(--head)", marginTop: 4 }}>
                  {activePricingKey === VENDOR_GLOBAL_PRICING_KEY
                    ? `💡 These rules apply to ALL clients in this workspace${vendorName ? ` for vendor "${vendorName}"` : ""} — rows will show the vendor price in the table when state matches.`
                    : `💡 These rules apply only to client "${selectedClient}"${vendorName ? ` and vendor "${vendorName}"` : ""}.`}
                </div>
              </div>

              {activeVendorRules.length > 0 && (
                <div>
                  <div className="pricing-vendor-label" style={{ marginBottom: 8, marginTop: 4 }}>
                    ✅ Active Rules {vendorName ? ` — ${vendorName}` : (activePricingKey === VENDOR_GLOBAL_PRICING_KEY ? " (Workspace — all clients)" : ` — ${selectedClient}`)}
                  </div>
                  <div className="upl-dropdown-box" style={{ maxWidth: 560 }}>
                    <button type="button" className="upl-dropdown-btn" onClick={() => setActiveRulesDropdownOpen(v => !v)}>
                      <span>✅ View Active Rules ({activeVendorRules.length})</span>
                      <span>{activeRulesDropdownOpen ? "▲" : "▼"}</span>
                    </button>
                    {activeRulesDropdownOpen && (
                      <div className="upl-dropdown-panel">
                        {activeVendorRules.map((r, i) => (
                          <div key={i} className="upl-dropdown-row" onClick={() => { if (r.state) setStateName(r.state); setDistrict(""); setPrice(r.rate); if (r.vendorName) setVendorName(r.vendorName); setActiveRulesDropdownOpen(false); }}>
                            <span>{r.vendorName && `${r.vendorName} · `}{r.state || "State"} → ₹{r.rate}</span>
                            <button type="button" className="upl-dropdown-del" onClick={ex => { ex.stopPropagation(); deleteRule(activePricingKey, r.state, r.vendorName); }}>✕</button>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              )}

              {false && pricingScope === "client" && (pricingRules[GLOBAL_PRICING_KEY] || []).filter(r => r.rate !== undefined).length > 0 && (
                <div>
                  <div className="pricing-divider" style={{ margin: "8px 0" }} />
                  <div className="pricing-vendor-label" style={{ marginBottom: 8 }}>🌐 Global rules (also apply to this client)</div>
                  <div className="upl-dropdown-box" style={{ maxWidth: 560 }}>
                    <button type="button" className="upl-dropdown-btn" onClick={() => setGlobalRulesDropdownOpen(v => !v)}>
                      <span>🌐 View Global Rules ({(pricingRules[GLOBAL_PRICING_KEY] || []).filter(r => r.rate !== undefined).length})</span>
                      <span>{globalRulesDropdownOpen ? "▲" : "▼"}</span>
                    </button>
                    {globalRulesDropdownOpen && (
                      <div className="upl-dropdown-panel">
                        {(pricingRules[GLOBAL_PRICING_KEY] || []).filter(r => r.rate !== undefined).map((r, i) => (
                          <div key={i} className="upl-dropdown-row">
                            <span>{r.vendorName && `${r.vendorName} · `}{r.state || "State"} → ₹{r.rate}</span>
                            <button type="button" className="upl-dropdown-del" onClick={ex => { ex.stopPropagation(); deleteRule(GLOBAL_PRICING_KEY, r.state, r.vendorName); }}>✕</button>
                          </div>
                        ))}
                      </div>
                    )}
                  </div>
                </div>
              )}

              {false && pricingScope === "global" && Object.keys(pricingRules).filter(k => k !== GLOBAL_PRICING_KEY && k !== MASTER_KEY && (pricingRules[k] || []).filter(r => r.rate !== undefined).length > 0).length > 0 && (
                <div>
                  <div className="pricing-divider" style={{ margin: "8px 0" }} />
                  <div className="pricing-vendor-label" style={{ marginBottom: 8 }}>Client-specific rules</div>
                  <div className="upl-dropdown-box" style={{ maxWidth: 560 }}>
                    <button type="button" className="upl-dropdown-btn" onClick={() => setClientRulesDropdownOpen(v => !v)}>
                      <span>🏢 View Client-Specific Rules</span>
                      <span>{clientRulesDropdownOpen ? "▲" : "▼"}</span>
                    </button>
                    {clientRulesDropdownOpen && (
                      <div className="upl-dropdown-panel">
                        {Object.entries(pricingRules)
                          .filter(([k, v]) => k !== GLOBAL_PRICING_KEY && k !== MASTER_KEY && v.filter(r => r.rate !== undefined).length > 0)
                          .map(([ck, rules]) => rules.filter(r => r.rate !== undefined).map((r, i) => (
                            <div key={`${ck}-${i}`} className="upl-dropdown-row">
                              <span>{ck} · {r.state || "State"} → ₹{r.rate}</span>
                              <button type="button" className="upl-dropdown-del" onClick={ex => { ex.stopPropagation(); deleteRule(ck, r.state); }}>✕</button>
                            </div>
                          )))}
                      </div>
                    )}
                  </div>
                </div>
              )}

              {totalVendorRules === 0 && !pricingLoading && (
                <div style={{ textAlign: "center", padding: "20px", background: "rgba(245,158,11,0.04)", border: "1.5px dashed rgba(245,158,11,0.25)", borderRadius: "var(--r12)", fontSize: 13, color: "var(--text3)", lineHeight: 1.7 }}>
                  <div style={{ fontSize: 28, marginBottom: 8, opacity: 0.4 }}>📍</div>
                  No vendor pricing rules yet.<br />
                  Enter a <strong>State</strong>, <strong>District</strong> and <strong>Price</strong> above and click <strong>Save Rule</strong>.
                </div>
              )}
              {pricingLoading && (
                <div style={{ textAlign: "center", padding: "20px", color: "var(--text3)", fontFamily: "var(--head)", fontSize: 13 }}>
                  <span className="sync-spin" style={{ display: "inline-block", marginRight: 8 }} />
                  Loading saved pricing rules…
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    </div>
  );
}
 