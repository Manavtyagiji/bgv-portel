function filterClientRecordsByWorkspace(data, workspaceId, isSuperAdmin = false) {
  const arr = getClientArrayFromApi(data);
  const ws = String(workspaceId || "").trim();
  const wsLower = ws.toLowerCase();
  const effectiveSuperAdmin = isSuperAdmin === true && ws === "__SUPERADMIN__";

  return arr.filter((client) => {
    // ✅ Strict workspace isolation:
    // Plain string clients are old/unscoped records. Do not load them from DB,
    // because they can leak secondary/company clients into Super Admin.
    // Current workspace clients are loaded from scoped portal-state/local keys.
    if (typeof client === "string") return false;

    const scope = getClientRecordScope(client);
    const scopeLower = String(scope || "").trim().toLowerCase();

    if (effectiveSuperAdmin) {
      return scopeLower === "__superadmin__" || scopeLower === "superadmin";
    }

    // Company Admin / Secondary Admin / Team: only exact workspace match.
    return !!scopeLower && scopeLower === wsLower;
  });
}

