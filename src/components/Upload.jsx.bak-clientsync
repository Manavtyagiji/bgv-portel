}
async function safeFetchDelete(url) {
  try {
    const res = await fetch(url, { method: "DELETE", headers: getAuthHeaders() });
    if (res.ok || res.status === 404) return true;
    const data = await res.json().catch(() => ({}));
    console.warn("Delete request failed:", url, data.message || data.error || res.status);
    return false;
  } catch (err) {
    console.warn("Delete request error:", url, err.message);
    return false;
  }
}
async function deletePricingScopeFromDB(scopeKey, pricingAPIRef) {
  if (!scopeKey) return;
  try {
    if (pricingAPIRef?.deleteScope) {
      await pricingAPIRef.deleteScope(scopeKey);
