function getClientWorkspaceId(tenantId, isSuperAdmin = false) {
  const cu = getCurrentUserSafe();
  const role = String(cu.role || "").trim().toLowerCase();
  const email = String(cu.email || "").trim().toLowerCase();
  const ownerAdminEmail = String(cu.ownerAdminEmail || "").trim().toLowerCase();

  // ✅ Strict company isolation fix:
  // Do NOT trust only the prop isSuperAdmin, because secondary/company admins can
  // accidentally receive that prop from parent state. Super Admin workspace is used
  // only when the logged-in user role is actually superadmin. If currentUser is not
  // loaded yet, then the prop fallback still keeps old behaviour.
  // Manager/TL are super admin's own internal-staff roles (not separate tenants) and
  // must work on the SAME client workspace super admin uses, not an isolated one.
  const actualSuperAdmin =
    role === "superadmin" ||
    role === "manager" ||
    role === "tl" ||
    (!role && isSuperAdmin === true);

  // Super Admin clients must stay in their own bucket.
  // This prevents Super Admin clients from appearing in company/secondary admin accounts.
  if (actualSuperAdmin) return "__SUPERADMIN__";

  // Company Admin / Secondary Admin must have their own workspace.
  // Prefer tenantId if present. If tenantId is missing, use logged-in admin email.
  if (tenantId || cu.tenantId || cu.subTenantId) {
    return String(tenantId || cu.tenantId || cu.subTenantId).trim();
  }

  if (role === "admin" || role === "secondary_admin") {
    return email ? `ADMIN__${email}` : "__UNKNOWN_ADMIN__";
  }

  // Company team users read their company/admin bucket.
  if (role === "team") {
    if (cu.tenantId || cu.subTenantId) return String(cu.tenantId || cu.subTenantId).trim();
    if (ownerAdminEmail) return `ADMIN__${ownerAdminEmail}`;
  }

  // Final fallback is user email, never a shared/global bucket.
  return email ? `USER__${email}` : "__LOCAL_COMPANY__";
}

function getClientRecordScope(client = {}) {
  if (!client || typeof client !== "object") return "";
  return String(
    client.tenantId ||
    client.companyTenantId ||
    client.workspaceId ||
    client.clientWorkspaceId ||
    client.scopeKey ||
    client.scope ||
    client.companyId ||
    client.tenantCode ||
    client.companyCode ||
    client.companyName ||
    client.company ||
    client.ownerAdminEmail ||
    client.adminEmail ||
    client.createdByEmail ||
    client.createdBy ||
    ""
  ).trim();
}

function getClientArrayFromApi(data) {
