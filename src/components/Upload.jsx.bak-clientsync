  await safeFetchDelete(`${apiBaseUrl()}/pricing/${encodeURIComponent(scopeKey)}`);
}
async function deleteClientFromDBByName(clientName, tenantId, clientAPIRef) {
  const target = nameKey(clientName);
  const workspace = String(tenantId || "").trim();
  const workspaceLower = workspace.toLowerCase();
  if (!target) return false;

  let matchedId = "";
  try {
    const data = await clientAPIRef.getAll();
    const arr = Array.isArray(data) ? data : Array.isArray(data?.clients) ? data.clients : Array.isArray(data?.data) ? data.data : [];
    const match = arr.find(c => {
      const nm = nameKey(typeof c === "string" ? c : c?.name || c?.clientName || c?.companyName || c?.label);
      if (nm !== target) return false;

      // Never delete another workspace's client with the same name.
      if (!workspaceLower) return false;
      if (typeof c === "string") return workspace === "__SUPERADMIN__";
      const scope = getClientRecordScope(c);
      const scopeLower = String(scope || "").trim().toLowerCase();
      if (workspace === "__SUPERADMIN__") return !scopeLower || scopeLower === "__superadmin__" || scopeLower === "superadmin";
      return scopeLower === workspaceLower;
    });
    matchedId = String(match?._id || match?.id || match?.clientId || "").trim();
  } catch (err) {
    console.warn("Client lookup before delete failed:", err.message);
  }

  try {
    if (matchedId && clientAPIRef?.delete) { await clientAPIRef.delete(matchedId); return true; }
    if (matchedId && clientAPIRef?.remove) { await clientAPIRef.remove(matchedId); return true; }
    if (clientAPIRef?.deleteByName) { await clientAPIRef.deleteByName(clientName, tenantId); return true; }
  } catch (err) {
    console.warn("Client API delete failed:", err.message);
  }

  const base = apiBaseUrl();
  const qs = `name=${encodeURIComponent(clientName)}${tenantId ? `&tenantId=${encodeURIComponent(tenantId)}` : ""}`;
  const attempts = [];
  if (matchedId) attempts.push(`${base}/clients/${encodeURIComponent(matchedId)}`);
  attempts.push(`${base}/clients/by-name/${encodeURIComponent(clientName)}`);
  attempts.push(`${base}/clients?${qs}`);

  let ok = false;
  for (const url of attempts) ok = (await safeFetchDelete(url)) || ok;
  return ok;
}

function normalizeClientName(v) {
  return String(v || "").replace(/\s+/g, " ").trim();
}

function normalizeVendorName(v) {
  return String(v || "").replace(/\s+/g, " ").trim();
}

function extractVendorNameFromRow(row = {}) {
  const source = {
    ...(row?.rawData && typeof row.rawData === "object" ? row.rawData : {}),
    ...(row && typeof row === "object" ? row : {}),
  };

  const exactKeys = [
    "Vendor Company Name", "Vendor Company", "Vendor Name", "VendorName",
    "Vendor", "vendor company name", "vendor company", "vendor name",
    "vendor", "Agent Vendor", "Vendor Agency", "Vendor Partner",
    "Agency Name", "Agency", "Field Vendor", "Vendor Assigned",
  ];

  for (const key of exactKeys) {
    const val = normalizeVendorName(source?.[key]);
    if (val) return val;
  }

  // Flexible header support: handles Excel headers like
  // "Vendor company", "VENDOR_NAME", "Vendor/Agency", etc.
  const blocked = /(price|rate|amount|status|date|tat|sent|close|closed|completed|mobile|phone|email|id|code)/i;

  for (const key of Object.keys(source || {})) {
    const cleanKey = String(key || "").trim();
    const compact = cleanKey.toLowerCase().replace(/[^a-z0-9]/g, "");

    const looksLikeVendorName =
      compact === "vendor" ||
      compact === "vendorname" ||
      compact === "vendorcompany" ||
      compact === "vendorcompanyname" ||
      compact === "agency" ||
      compact === "agencyname" ||
      (compact.includes("vendor") &&
        (compact.includes("name") || compact.includes("company") || compact.includes("agency")));

    if (!looksLikeVendorName || blocked.test(cleanKey)) continue;

    const val = normalizeVendorName(source[cleanKey]);
    if (val) return val;
  }

  return "";
}

function extractVendorNamesFromRows(rows = []) {
  const found = [];
  (Array.isArray(rows) ? rows : []).forEach((row) => {
    const v = extractVendorNameFromRow(row);
    if (v) found.push(v);
  });
  return mergeVendorLists(found);
}

function extractVendorNamesFromPricingRules(rulesObj = {}, scopePrefix = "") {
  const found = [];

  if (!rulesObj || typeof rulesObj !== "object") return [];

  Object.entries(rulesObj).forEach(([key, rules]) => {
    if (scopePrefix && !String(key).startsWith(scopePrefix)) return;
    if (!Array.isArray(rules)) return;

    rules.forEach((rule) => {
      const v = normalizeVendorName(rule?.vendorName);
      if (v) found.push(v);
    });
  });

  return mergeVendorLists(found);
}
function mergeVendorLists(...lists) {
  const map = new Map();

  lists.flat().forEach((item) => {
    const name = normalizeVendorName(item);
    if (!name) return;
    const key = name.toLowerCase();
    if (!map.has(key)) map.set(key, name);
  });

  return Array.from(map.values()).sort((a, b) =>
    a.localeCompare(b, undefined, { sensitivity: "base" })
  );
}

function mergeClientLists(...lists) {
  const map = new Map();

  lists.flat().forEach((item) => {
    const name = normalizeClientName(item);
    if (!name || name === MASTER_KEY) return;
    const key = name.toLowerCase();
    if (!map.has(key)) map.set(key, name);
  });

  return Array.from(map.values()).sort((a, b) =>
    a.localeCompare(b, undefined, { sensitivity: "base" })
  );
}

function extractClientNamesFromApi(data) {
  const arr = Array.isArray(data)
    ? data
    : Array.isArray(data?.clients)
      ? data.clients
      : Array.isArray(data?.data)
        ? data.data
        : [];

  return arr
    .map((c) =>
      normalizeClientName(
        typeof c === "string"
          ? c
          : c?.name || c?.clientName || c?.companyName || c?.label
      )
    )
    .filter(Boolean);
}

async function syncClientsToBackend(clientNames, tenantId) {
  const names = mergeClientLists(clientNames);
  if (!names.length) return [];

  const workspaceId = String(tenantId || "").trim();
  const cu = getCurrentUserSafe();
  const userEmail = String(cu.email || "").trim().toLowerCase();

  const results = await Promise.allSettled(
    names.map((name) =>
      clientAPI.create({
        name,
        clientName: name,
        tenantId: workspaceId || null,
        workspaceId: workspaceId || null,
        clientWorkspaceId: workspaceId || null,
        companyTenantId: workspaceId || null,
        companyId: workspaceId || null,
        scopeKey: workspaceId || null,
        createdByEmail: userEmail || "",
        ownerAdminEmail: userEmail || "",
      })
    )
  );

  const failed = results.filter((r) => r.status === "rejected");
  if (failed.length) {
    console.warn(
      `Client sync skipped/failed for ${failed.length} client(s):`,
      failed.map((r) => r.reason?.message || r.reason)
    );
  }

  // Important: do not silently save only in localStorage.
  // If DB save fails, another laptop will never see the client.
  if (failed.length === results.length) {
    throw new Error(failed[0]?.reason?.message || "Client DB sync failed");
  }

  return names;
}

