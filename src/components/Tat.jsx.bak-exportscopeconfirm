export default function TAT({ selectedClient = "", currentUser = null }) {
  const [tatMode, setTatMode] = useState("vendor");

  // Fetches only Pending records directly from the server — TAT only ever
  // tracks Pending cases (see file header), so it never needed Sent/Closed/
  // Insuff/Hold/Stop rows at all. Avoids depending on the full eager-loaded
  // dataset, which doesn't scale as record volume grows. Grouped into the
  // same {[clientName]: rows[], [MASTER_KEY]: rows[]} shape the rest of this
  // file already expects, so none of the calculation logic below changes.
  const [clientsData, setClientsData] = useState({});
  const [tatLoading, setTatLoading] = useState(true);

  useEffect(() => {
    let cancelled = false;
    setTatLoading(true);
    // Team members (including vendor-only-allocated ones) get server-side
    // allocation scoping here, same mechanism Records already uses — without
    // it, TAT Tracker showed every vendor/client's pending cases to everyone,
    // regardless of what was actually allocated to them.
    const isTeamRole = String(currentUser?.role || "").trim().toLowerCase() === "team";
    uploadAPI.getRecords({
      status: "pending",
      limit: 100000,
      ...(isTeamRole ? { scopeToAllocations: "true" } : {}),
    })
      .then(rows => {
        if (cancelled) return;
        const grouped = {};
        const all = Array.isArray(rows) ? rows : [];
        all.forEach(row => {
          const clientName = String(row["Company Name"] || row["Client Name"] || "Unknown").trim() || "Unknown";
          if (!grouped[clientName]) grouped[clientName] = [];
          grouped[clientName].push(row);
        });
        grouped[MASTER_KEY] = all;
        setClientsData(grouped);
      })
      .catch(err => console.warn("TAT fetch failed:", err.message))
      .finally(() => { if (!cancelled) setTatLoading(false); });
    return () => { cancelled = true; };
  }, []);

  const [search, setSearch] = useState("");
  const [dSearch, setDSearch] = useState("");
  const [pf, setPf] = useState("all");
  const [cf, setCf] = useState("all");
  const [vf, setVf] = useState("all");
  const [sc, setSc] = useState("tatDays");
  const [sd, setSd] = useState("desc");
  const [pageSize, setPageSize] = useState(25);
  const [currentPage, setCurrentPage] = useState(1);

  const [allRows, setAllRows] = useState([]);
  const [visIdx, setVisIdx] = useState([]);
  const [building, setBuilding] = useState(false);
  const [filtering, setFiltering] = useState(false);

  const workerRef = useRef(null);
  const idleRef = useRef(null);
  const dataRef = useRef(clientsData);

  const clientList = useMemo(
    () => Object.keys(clientsData).filter((k) => k !== MASTER_KEY),
    [clientsData]
  );

  const clientCounts = useMemo(() => {
    const m = {};
    clientList.forEach((k) => {
      // Count only pending rows per client
      m[k] = (clientsData[k] || []).filter(r => {
        const s = (r.Status || r.status || r.STATUS || r["Case Status"] || "").toString().trim().toLowerCase();
        return s === "pending";
      }).length;
    });
    return m;
  }, [clientsData, clientList]);

  const vendorCounts = useMemo(() => {
    const m = {};
    allRows.forEach((r) => {
      const vendor = r.chk || "Unassigned";
      m[vendor] = (m[vendor] || 0) + 1;
    });
    return m;
  }, [allRows]);

  const vendorList = useMemo(
    () => Object.keys(vendorCounts).sort((a, b) => a.localeCompare(b)),
    [vendorCounts]
  );

  const day4Count = useMemo(() => allRows.filter((r) => r.isDay4).length, [allRows]);

  const vendorDay4Count = useMemo(() => {
    return buildAllRows(clientsData, "vendor").filter((r) => r.isDay4).length;
  }, [clientsData]);

  const clientDay4Count = useMemo(() => {
    return buildAllRows(clientsData, "client").filter((r) => r.isDay4).length;
  }, [clientsData]);

  useEffect(() => {
    workerRef.current = getWorker();
    if (workerRef.current) {
      workerRef.current.onmessage = (e) => {
        startTransition(() => {
          setVisIdx(e.data);
          setFiltering(false);
        });
      };
    }
  }, []);

  useEffect(() => {
    dataRef.current = clientsData;

    if (idleRef.current) {
      if (typeof cancelIdleCallback !== "undefined") cancelIdleCallback(idleRef.current);
      else clearTimeout(idleRef.current);
    }

    setBuilding(true);

    const run = () => {
      const rows = buildAllRows(dataRef.current, tatMode);
      startTransition(() => {
        setAllRows(rows);
        setBuilding(false);
      });
    };

    if (typeof requestIdleCallback !== "undefined") {
      idleRef.current = requestIdleCallback(run, { timeout: 600 });
    } else {
      idleRef.current = setTimeout(run, 0);
    }

    return () => {
      if (idleRef.current) {
        if (typeof cancelIdleCallback !== "undefined") cancelIdleCallback(idleRef.current);
        else clearTimeout(idleRef.current);
      }
    };
  }, [clientsData, tatMode]);

  useEffect(() => {
    const t = setTimeout(() => setDSearch(search.trim().toLowerCase()), 250);
    return () => clearTimeout(t);
  }, [search]);

  useEffect(() => {
    if (cf !== "all" && !clientList.includes(cf)) setCf("all");
  }, [clientList, cf]);

  useEffect(() => {
    if (vf !== "all" && !vendorList.includes(vf)) setVf("all");
  }, [vendorList, vf]);

  useEffect(() => {
    setVf("all");
  }, [tatMode]);

  useEffect(() => {
    if (selectedClient && selectedClient !== MASTER_KEY && clientList.includes(selectedClient)) {
      setCf(selectedClient);
    } else if (!selectedClient || selectedClient === MASTER_KEY) {
      setCf("all");
    }
  }, [selectedClient, clientList]);

  useEffect(() => {
    if (tatMode === "vendor") {
      setCf("all");
    } else {
      setVf("all");
    }
  }, [tatMode]);

  useEffect(() => {
    setCurrentPage(1);
  }, [dSearch, pf, cf, vf, sc, sd, tatMode, pageSize]);

  useEffect(() => {
    if (!allRows.length) {
      setVisIdx([]);
      return;
    }

    setFiltering(true);

    const slim = allRows.map((r) => ({
      _i: r._i,
      ck: r.ck,
      _search: r._search,
      tatDays: r.tatDays,
      pct: r.pct,
      isOngoing: r.isOngoing,
      isInsuffTAT: r.isInsuffTAT,
      penAmount: r.penAmount,
      amount: r.amount,
      status: r.status,
      cand: r.cand,
      phone: r.phone,
      address: r.address,
      chk: r.chk,
      checkNameOnly: r.checkNameOnly,
      vendorNameOnly: r.vendorNameOnly,
      sentStr: r.sentStr,
      compStr: r.compStr,
    }));

    if (workerRef.current) {
      workerRef.current.postMessage({ rows: slim, q: dSearch, pf, cf: tatMode === "vendor" ? "all" : cf, vf: tatMode === "vendor" ? vf : "all", sc, sd });
    } else {
      let out = allRows;
      if (tatMode !== "vendor" && cf !== "all") out = out.filter((r) => r.ck === cf);
      if (tatMode === "vendor" && vf !== "all") out = out.filter((r) => r.chk === vf);
      if (dSearch) out = out.filter((r) => r._search.includes(dSearch));
      if (pf === "clean") out = out.filter((r) => !r.isOngoing && r.pct === 0 && r.tatDays !== null);
      else if (pf === "10") out = out.filter((r) => r.pct === 10);
      else if (pf === "20") out = out.filter((r) => r.pct === 20);
      else if (pf === "50") out = out.filter((r) => r.pct === 50);
      else if (pf === "open") out = out.filter((r) => r.isOngoing);
      else if (pf === "day4") out = out.filter((r) => r.tatDays === 4);

      out = [...out].sort((a, b) => {
        let av = a[sc];
        let bv = b[sc];
        if (av == null) av = sd === "asc" ? Infinity : -Infinity;
        if (bv == null) bv = sd === "asc" ? Infinity : -Infinity;
        if (typeof av === "string") return sd === "asc" ? av.localeCompare(bv) : bv.localeCompare(av);
        return sd === "asc" ? av - bv : bv - av;
      });

      startTransition(() => {
        setVisIdx(out.map((r) => r._i));
        setFiltering(false);
      });
    }
  }, [allRows, dSearch, pf, cf, vf, sc, sd]);

  const byIdx = useMemo(() => {
    const m = {};
    allRows.forEach((r) => {
      m[r._i] = r;
    });
    return m;
  }, [allRows]);

  const visRows = useMemo(() => visIdx.map((i) => byIdx[i]).filter(Boolean), [visIdx, byIdx]);

  const totalPages = Math.max(1, Math.ceil(visRows.length / pageSize));

  useEffect(() => {
    if (currentPage > totalPages) setCurrentPage(totalPages);
  }, [currentPage, totalPages]);

  const pageStart = (currentPage - 1) * pageSize;
  const pageEnd = Math.min(visRows.length, pageStart + pageSize);
  const pagedRows = useMemo(
    () => visRows.slice(pageStart, pageStart + pageSize),
    [visRows, pageStart, pageSize]
  );

  const PaginationBar = ({ bottom = false }) => (
    <div className="tat-pagebar" style={bottom ? { marginTop: 12, marginBottom: 0 } : {}}>
      <div className="tat-page-left">
        <span className="tat-page-info">
          Showing {visRows.length ? pageStart + 1 : 0}-{pageEnd} of {visRows.length.toLocaleString()} cases
        </span>
        <span className="tat-sheet-note">Paginated sheet view for fast loading</span>
      </div>
      <div className="tat-page-right">
        <select
          className="tat-page-select"
          value={pageSize}
          onChange={(e) => setPageSize(Number(e.target.value))}
        >
          {[25, 50, 100, 200].map((n) => (
            <option key={n} value={n}>{n} / page</option>
          ))}
        </select>
        <button className="tat-page-btn" disabled={currentPage <= 1} onClick={() => setCurrentPage(1)}>First</button>
        <button className="tat-page-btn" disabled={currentPage <= 1} onClick={() => setCurrentPage(p => Math.max(1, p - 1))}>Prev</button>
        <span className="tat-page-info">Page {currentPage} / {totalPages}</span>
        <button className="tat-page-btn" disabled={currentPage >= totalPages} onClick={() => setCurrentPage(p => Math.min(totalPages, p + 1))}>Next</button>
        <button className="tat-page-btn" disabled={currentPage >= totalPages} onClick={() => setCurrentPage(totalPages)}>Last</button>
      </div>
    </div>
  );

  const sendPendingToVendorHostinger = async () => {
    if (!isVendor) return;
    if (!vf || vf === "all") {
      alert("Please select a specific vendor first.");
      return;
    }

    const rowsForVendor = allRows
      .filter((r) => r.chk === vf)
      .sort((a, b) => (b.tatDays || 0) - (a.tatDays || 0));

    if (!rowsForVendor.length) {
      alert("No pending cases found for this vendor.");
      return;
    }

    const fileName = downloadVendorPendingExcel(vf, rowsForVendor);
    const { subject, body } = buildVendorPendingMail(vf, rowsForVendor);
    const fullText = `Subject: ${subject}\n\n${body}\n\nExcel file downloaded: ${fileName}\nPlease attach this Excel file before sending.`;

    try {
      await navigator.clipboard.writeText(fullText);
      alert("Excel file downloaded and mail content copied. Hostinger Mail is opening now. Attach the downloaded Excel file and send it to the vendor.");
    } catch (_) {
      window.prompt("Copy this email content:", fullText);
    }

    window.open("https://mail.hostinger.com", "_blank", "noopener,noreferrer");
  };

  // Export ONLY the out-of-TAT cases (TAT over 5 days) from the current view.
  // Includes both completed-late cases (10/20/50% penalty) and ongoing cases
  // that have already crossed 5 days. Respects the filters currently applied.
  const exportOutOfTatExcel = () => {
    const outRows = visRows.filter((r) => r.tatDays !== null && r.tatDays > 5);

    if (!outRows.length) {
      alert("No out-of-TAT cases to export in the current view.");
      return;
    }

    const today = new Date().toLocaleDateString("en-IN", {
      day: "2-digit",
      month: "short",
      year: "numeric",
    });

    const excelRows = outRows.map((r, i) => ({
      "S.No": i + 1,
      "Candidate Name": cleanMailText(r.cand),
      "Phone": cleanMailText(r.phone),
      "Address": cleanMailText(r.address),
      "Client": cleanMailText(r.ck),
      "Check": cleanMailText(r.checkNameOnly),
      "Vendor": cleanMailText(r.vendorNameOnly),
      "Sent Date": cleanMailText(r.sentStr || "Not sent"),
      "Completed Date": cleanMailText(r.compStr || (r.isOngoing ? "In Progress" : "-")),
      "TAT Days": r.tatDays,
      "TAT State": r.isOngoing ? "Ongoing (Overdue)" : "Completed (Late)",
      "Penalty %": r.label,
      "Case Amount": r.amount || 0,
      "Penalty Amount": r.penAmount || 0,
      "Case Status": r.status || "Pending",
    }));

    const ws = XLSX.utils.json_to_sheet(excelRows);
    ws["!cols"] = [
      { wch: 7 }, { wch: 24 }, { wch: 16 }, { wch: 50 }, { wch: 18 },
      { wch: 16 }, { wch: 16 }, { wch: 14 }, { wch: 16 }, { wch: 10 },
      { wch: 18 }, { wch: 12 }, { wch: 14 }, { wch: 14 }, { wch: 14 },
    ];

    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, "Out of TAT");

    const buffer = XLSX.write(wb, { bookType: "xlsx", type: "array" });
    const blob = new Blob([buffer], {
      type: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
    });
    saveAs(blob, `Out_of_TAT_${tatMode}_${safeFilename(today)}.xlsx`);
  };

  const stats = useMemo(() => {
    let onTime = 0;
    let ongoing = 0;
    let totalPen = 0;
    let totalAmt = 0;
    let tatSum = 0;
    let tatCnt = 0;

    for (const r of allRows) {
      if (r.isOngoing) ongoing++;
      else if (r.tatDays !== null) {
        if (r.pct === 0) onTime++;
        tatSum += r.tatDays;
        tatCnt++;
      }
      totalPen += r.penAmount;
      totalAmt += r.amount;
    }

    return {
      total: allRows.length,
      onTime,
      ongoing,
      totalPen,
      totalAmt,
      avgTat: tatCnt ? (tatSum / tatCnt).toFixed(1) : "—",
    };
  }, [allRows]);

  const sico = (col) => (sc === col ? (sd === "asc" ? "↑" : "↓") : "↕");
  const tog = (col) => () => {
    if (sc === col) setSd((d) => (d === "asc" ? "desc" : "asc"));
    else {
      setSc(col);
      setSd("desc");
    }
  };

  const cols = [
    { l: "Candidate",       fn: tog("cand"),      s: sico("cand"),      w: 180 },
    { l: "Phone Number",    fn: tog("phone"),     s: sico("phone"),     w: 150 },
    { l: "Address",         fn: tog("address"),   s: sico("address"),   w: 360 },
    { l: "Client",          fn: tog("ck"),         s: sico("ck"),        w: 150 },
    { l: "Check",           fn: tog("checkNameOnly"), s: sico("checkNameOnly"), w: 130 },
    { l: "Vendor",          fn: tog("vendorNameOnly"), s: sico("vendorNameOnly"), w: 130 },
    { l: "Sent Date",       fn: tog("sentStr"),    s: sico("sentStr"),   w: 135 },
    { l: "Completed",       fn: tog("compStr"),    s: sico("compStr"),   w: 150 },
    { l: "TAT",             fn: tog("tatDays"),    s: sico("tatDays"),   w: 180 },
    { l: "Penalty %",       fn: tog("pct"),        s: sico("pct"),       w: 120 },
    { l: "Case Amt",        fn: tog("amount"),     s: sico("amount"),    w: 115 },
    { l: "Penalty Amt",     fn: tog("penAmount"),  s: sico("penAmount"), w: 135 },
    { l: "Status",          fn: () => {},           s: "",                w: 130 },
  ];

  const isVendor = tatMode === "vendor";
  const theadCls = isVendor ? "tat-thead-v" : "tat-thead-c";
  const thCls    = isVendor ? "tat-th-v"    : "tat-th-c";
  const twCls    = isVendor ? "tat-tw"      : "tat-tw tat-tw-c";
  const ftCls    = isVendor ? "tat-ft"      : "tat-ft tat-ft-c";

  const PEN_F = [
    { k: "all",   l: "All"             },
    { k: "clean", l: "✅ 0%"           },
    { k: "10",    l: "⚠️ 10% (6–8d)"  },
    { k: "20",    l: "🔶 20% (8–10d)" },
    { k: "50",    l: "🟣 50% (>10d)"  },
    { k: "open",  l: "⏳ Ongoing"      },
  ];

  const handleDay4Click = (mode) => {
    if (tatMode === mode && pf === "day4") {
      setPf("all");
      return;
    }
    setTatMode(mode);
    setPf("day4");
  };

  return (
    <div className="tat">
      <div className="tat-mode-bar">
        <button
          className={`tat-mode-tab ${tatMode === "vendor" ? "active-vendor" : ""}`}
          onClick={() => { setTatMode("vendor"); setPf("all"); }}
        >
          <span className="mode-icon">🏭</span>
          Vendor TAT
          <span className="mode-badge">Pending Cases Only</span>
        </button>

        <div className="tat-mode-div" />

        <button
          className={`tat-mode-tab ${tatMode === "client" ? "active-client" : ""}`}
          onClick={() => { setTatMode("client"); setPf("all"); }}
        >
          <span className="mode-icon">🏢</span>
          Client TAT
          <span className="mode-badge">Pending Cases Only</span>
        </button>
      </div>

      {/* Pending-only notice */}
      <div className="tat-pending-notice">
        <span className="tat-pending-notice-icon">⏳</span>
        <div>
          <div className="tat-pending-notice-text">TAT Tracker — Pending Cases Only</div>
          <div className="tat-pending-notice-sub">Only cases with status "Pending" are included. Sent, Closed, Insuff, Hold and Stop cases are excluded.</div>
        </div>
      </div>

      {clientList.length === 0 && !building && !tatLoading && (
        <div className="tat-nd">
          <span className="tat-ndi">📭</span>
          <div>
            <div className="tat-ndt">No data yet</div>
            <div className="tat-nds">Upload an Excel file to start tracking TAT.</div>
          </div>
        </div>
      )}

      {allRows.length > 0 && (
        <div style={{ display: "flex", gap: 10, marginBottom: 14, flexWrap: "wrap" }}>
          <div
            className={`day4-banner day4-banner-v ${tatMode === "vendor" && pf === "day4" ? "active-d4" : ""}`}
            style={{ flex: 1, minWidth: 220 }}
            onClick={() => handleDay4Click("vendor")}
          >
            <span className="day4-icon">⚡</span>
            <div className="day4-text">
              <div className="day4-title">Vendor — Day 4 Pending Cases</div>
              <div className="day4-sub">Pending cases exactly on 4th day (approaching 6-day threshold)</div>
            </div>
            <div style={{ textAlign: "center", marginRight: 8 }}>
              <div className="day4-ct">{(building || tatLoading) ? "…" : vendorDay4Count}</div>
              <div style={{ fontFamily: "'Space Grotesk',sans-serif", fontSize: 9, color: "#8ba3c0", fontWeight: 600, textTransform: "uppercase" }}>cases</div>
            </div>
            <button className="day4-btn day4-btn-v" onClick={(e) => { e.stopPropagation(); handleDay4Click("vendor"); }}>
              {tatMode === "vendor" && pf === "day4" ? "✕ Clear" : "View Cases →"}
            </button>
          </div>

          <div
            className={`day4-banner day4-banner-c ${tatMode === "client" && pf === "day4" ? "active-d4" : ""}`}
            style={{ flex: 1, minWidth: 220 }}
            onClick={() => handleDay4Click("client")}
          >
            <span className="day4-icon">🔔</span>
            <div className="day4-text">
              <div className="day4-title day4-title-c">Client — Day 4 Pending Cases</div>
              <div className="day4-sub">Pending cases exactly on 4th day (approaching 6-day threshold)</div>
            </div>
            <div style={{ textAlign: "center", marginRight: 8 }}>
              <div className="day4-ct day4-ct-c">{(building || tatLoading) ? "…" : clientDay4Count}</div>
              <div style={{ fontFamily: "'Space Grotesk',sans-serif", fontSize: 9, color: "#8ba3c0", fontWeight: 600, textTransform: "uppercase" }}>cases</div>
            </div>
            <button className="day4-btn day4-btn-c" onClick={(e) => { e.stopPropagation(); handleDay4Click("client"); }}>
              {tatMode === "client" && pf === "day4" ? "✕ Clear" : "View Cases →"}
            </button>
          </div>
        </div>
      )}

      <div className="tat-sum">
        {[
          { i: "⏳", l: "Pending Cases",  v: (building || tatLoading) ? "…" : stats.total,                                           c: "si-a", vc: "sv-a" },
          { i: "✅", l: "On Time (≤5d)",  v: (building || tatLoading) ? "…" : stats.onTime,                                          c: "si-g", vc: "sv-g" },
          { i: "⏱️", l: "Avg TAT (days)", v: (building || tatLoading) ? "…" : stats.avgTat,                                          c: "si-b", vc: "sv-b" },
          { i: "⚠️", l: "10% Penalty",    v: (building || tatLoading) ? "…" : allRows.filter((r) => r.pct === 10).length,            c: "si-a", vc: "sv-a" },
          { i: "🔶", l: "20% Penalty",    v: (building || tatLoading) ? "…" : allRows.filter((r) => r.pct === 20).length,            c: "si-a", vc: "sv-a" },
          { i: "🟣", l: "50% Penalty",    v: (building || tatLoading) ? "…" : allRows.filter((r) => r.pct === 50).length,            c: "si-p", vc: "sv-p" },
          { i: "🔄", l: "Ongoing",        v: (building || tatLoading) ? "…" : stats.ongoing,                                         c: "si-b", vc: "sv-b" },
          { i: "💸", l: "Total Penalty",  v: (building || tatLoading) ? "…" : fmtINR(stats.totalPen), c: "si-r", vc: "sv-r",
            sub: building ? undefined : `of ${fmtINR(stats.totalAmt)}` },
        ].map((s, i) => (
          <div key={i} className={`tat-sc ${isVendor ? "tat-sc-v" : "tat-sc-c"}`}>
            <div className={`tat-si ${s.c}`}>{s.i}</div>
            <div>
              <div className="tat-sl">{s.l}</div>
              <div className={`tat-sv ${s.vc}`}>{s.v}</div>
              {s.sub && <div className="tat-ss">{s.sub}</div>}
            </div>
          </div>
        ))}
      </div>

      {!isVendor && clientList.length > 0 && (
        <div className="tat-client-filter">
          <span className="tat-client-label">Filter by Client:</span>
          <select className="tat-client-select" value={cf} onChange={(e) => setCf(e.target.value)}>
            <option value="all">All Clients ({allRows.length} pending)</option>
            {clientList.map((c) => (
              <option key={c} value={c}>{c} ({clientCounts[c] || 0} pending)</option>
            ))}
          </select>
          {cf !== "all" && (
            <button type="button" className="tat-client-clear" onClick={() => setCf("all")}>✕ Clear</button>
          )}
        </div>
      )}

      {isVendor && vendorList.length > 0 && (
        <div className="tat-client-filter">
          <span className="tat-client-label">Filter by Vendor:</span>
          <select className="tat-client-select" value={vf} onChange={(e) => setVf(e.target.value)}>
            <option value="all">All Vendors ({allRows.length} pending)</option>
            {vendorList.map((v) => (
              <option key={v} value={v}>{v} ({vendorCounts[v] || 0} pending)</option>
            ))}
          </select>
          {vf !== "all" && (
            <button type="button" className="tat-client-clear" onClick={() => setVf("all")}>✕ Clear</button>
          )}
          <button
            type="button"
            className="tat-mail-btn"
            disabled={vf === "all"}
            onClick={sendPendingToVendorHostinger}
            title={vf === "all" ? "Select a vendor first" : `Copy pending cases and open Hostinger Mail for ${vf}`}
          >
            ✉️ Send Pending to Vendor
          </button>
          {vf !== "all" && (
            <span className="tat-mail-note">Copies {vendorCounts[vf] || 0} pending cases</span>
          )}
        </div>
      )}

      <div className="tat-ctrl">
        <div className="tat-sw">
          <span className="tat-sico">🔍</span>
          <input
            className="tat-inp"
            placeholder={isVendor ? "Search candidate / client / vendor…" : "Search candidate / client…"}
            value={search}
            onChange={(e) => setSearch(e.target.value)}
          />
        </div>

        <div className="tat-rdiv" />

        {PEN_F.map((f) => (
          <span
            key={f.k}
            className={`tat-chip ${pf === f.k ? (isVendor ? "on" : "on-p") : ""}`}
            onClick={() => setPf(f.k)}
          >
            {f.l}
          </span>
        ))}

        <span
          className={`tat-chip ${pf === "day4" ? (isVendor ? "on" : "on-p") : ""}`}
          onClick={() => setPf(pf === "day4" ? "all" : "day4")}
        >
          ⚡ Day 4 {day4Count > 0 && `(${day4Count})`}
        </span>

        <button
          type="button"
          onClick={exportOutOfTatExcel}
          title="Download an Excel of out-of-TAT cases (TAT over 5 days) in the current view"
          style={{
            display: "inline-flex",
            alignItems: "center",
            gap: 6,
            fontFamily: "'Space Grotesk',sans-serif",
            fontSize: 12,
            fontWeight: 800,
            border: "none",
            borderRadius: 10,
            padding: "8px 13px",
            cursor: "pointer",
            background: "linear-gradient(135deg,#059669,#10b981)",
            color: "#fff",
            boxShadow: "0 4px 14px rgba(16,185,129,0.24)",
          }}
        >
          ⬇️ Export Out-of-TAT
        </button>

        {(building || filtering) && (
          <span className="tat-proc">
            <span className="ts" />
            {building ? "Building…" : "Filtering…"}
          </span>
        )}

        <span style={{ marginLeft: "auto", fontFamily: "'Space Grotesk',sans-serif", fontSize: 11.5, fontWeight: 700, color: "#8ba3c0" }}>
          {pagedRows.length.toLocaleString()} on page · {visRows.length.toLocaleString()} filtered / {allRows.length.toLocaleString()} pending
        </span>
      </div>

      {visRows.length > 0 && <PaginationBar />}

      <div className={twCls}>
        {visRows.length === 0 ? (
          <div>
            <table className="tat-t">
              <colgroup>
                {cols.map((c, i) => (
                  <col key={i} style={{ width: c.w || c.mw || 130 }} />
                ))}
              </colgroup>
              <thead className={theadCls}>
                <tr>
                  {cols.map((c, i) => (
                    <th key={i} className={`tat-th ${thCls}`} onClick={c.fn}>
                      {c.l} <span className="si-arrow">{c.s}</span>
                    </th>
                  ))}
                </tr>
              </thead>
            </table>
            <div className="tat-empty">
              <div className="tat-ei">{isVendor ? "🏭" : "🏢"}</div>
              <div className="tat-et">
                {building
                  ? "Loading data…"
                  : filtering
                  ? "Filtering…"
                  : pf === "day4"
                  ? "No pending cases are on Day 4 TAT right now"
                  : allRows.length === 0
                  ? "No Pending cases found — TAT tracks Pending cases only"
                  : "No cases match your filters"}
              </div>
            </div>
          </div>
        ) : (
          <VTable rows={pagedRows} cols={cols} theadCls={theadCls} thCls={thCls} />
        )}
      </div>

      {visRows.length > 0 && <PaginationBar bottom />}

      <div className={ftCls}>
        <div>
          <div className="tat-fl">Mode</div>
          <div className="tat-fv" style={{ fontSize: 14, fontWeight: 800, letterSpacing: "0.03em" }}>
            {isVendor ? "🏭 Vendor TAT" : "🏢 Client TAT"}
          </div>
        </div>

        <div>
          <div className="tat-fl">Scope</div>
          <div style={{ display: "inline-flex", alignItems: "center", gap: 5, background: "rgba(245,158,11,0.09)", border: "1px solid rgba(245,158,11,0.25)", color: "#b45309", padding: "4px 12px", borderRadius: 99, fontFamily: "'Space Grotesk',sans-serif", fontSize: 11, fontWeight: 700 }}>
            ⏳ Pending Only
          </div>
        </div>

        {pf === "day4" && (
          <div style={{ background: "rgba(245,158,11,0.10)", border: "1.5px solid rgba(245,158,11,0.30)", borderRadius: 10, padding: "8px 14px" }}>
            <div className="tat-fl">Day-4 Filter Active</div>
            <div className="tat-fv sv-a">{visRows.length} pending cases on Day 4</div>
          </div>
        )}

        <div>
          <div className="tat-fl">Cases Shown</div>
          <div className="tat-fv sv-b">{visRows.length.toLocaleString()}</div>
        </div>

        <div>
          <div className="tat-fl">Total Amount</div>
          <div className="tat-fv sv-b">{fmtINR(visRows.reduce((s, r) => s + r.amount, 0))}</div>
        </div>

        <div>
          <div className="tat-fl">Total Penalty</div>
          <div className="tat-fv sv-r">{fmtINR(visRows.reduce((s, r) => s + r.penAmount, 0))}</div>
        </div>

        <div>
          <div className="tat-fl">Penalty Rules ({isVendor ? "Vendor" : "Client"})</div>
          <div style={{ display: "flex", gap: 4, flexWrap: "wrap", marginTop: 3 }}>
            {[["≤5d: 0%","p0"],["6–8d: 10%","p10"],["8–10d: 20%","p20"],["10d+: 50%","p50"]].map(([l,c]) => (
              <span key={l} className={`pb ${c}`} style={{ fontSize: 9.5, padding: "2px 6px" }}>{l}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
}