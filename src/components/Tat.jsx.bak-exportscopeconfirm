// FINAL TAT DAY LOGIC
// Fix: old Date/timezone calculation was showing 1 day less.
// This uses calendar-date UTC difference only.
// Example: 21 Apr to 30 Apr = 9 days, not 8 and not 10.
function dateOnlyUTC(dt) {
  if (!dt) return null;
  return Date.UTC(dt.getFullYear(), dt.getMonth(), dt.getDate());
}

function todayOnlyUTC() {
  const t = new Date();
  return Date.UTC(t.getFullYear(), t.getMonth(), t.getDate());
}

function calcTatDays(startDate, endDate = null) {
  if (!startDate) return null;
  const start = dateOnlyUTC(startDate);
  const end = endDate ? dateOnlyUTC(endDate) : todayOnlyUTC();
  if (start === null || end === null) return null;

  const diff = Math.floor((end - start) / 86400000);
  return Math.max(0, diff);
}

/* ─────────────────────────── TAT TIER LOGIC ─────────────────────────────── */
function penTier(days, isOngoing) {
  if (isOngoing || days === null) return [0, "—", "p0", "bk", "dlv"];
  if (days <= 5) return [0, "0%", "p0", "bk", "dok"];
  if (days <= 8) return [10, "10%", "p10", "bw1", "dw1"];
  if (days <= 10) return [20, "20%", "p20", "bw2", "dw2"];
  return [50, "50%", "p50", "bdc", "ddc"];
}

/* ─────────────────────────── BUILD ROWS ─────────────────────────────────── */
function buildAllRows(clientsData, tatMode) {
  const clientList = Object.keys(clientsData).filter((k) => k !== MASTER_KEY);
  const rows = [];
  let idx = 0;

  for (const ck of clientList) {
    const list = clientsData[ck] || [];

    for (const row of list) {
      // ── PENDING ONLY FILTER ──
      // TAT tracker only processes Pending cases.
      // All other statuses (Sent, Closed, Insuff, Hold, Stop) are skipped.
      const rowStatusCheck = (
        row.Status       ||
        row.status       ||
        row.STATUS       ||
        row["Case Status"]         ||
        row["BGV Status"]          ||
        row["Verification Status"] ||
        row["Current Status"]      ||
        ""
      ).toString().trim().toLowerCase();

      if (rowStatusCheck !== "pending") continue;
      // ─────────────────────────

      let sentRaw = "";
      let compRaw = "";
      let isInsuffTAT = false;

      if (tatMode === "vendor") {
        /* ── Vendor TAT — unchanged ── */
        sentRaw =
          row["Assigned Date"] ||
          row["Assign Date"] ||
          row.assignDate ||
          row["Sent Date"] ||
          row.vendorSentDate ||
          row["Vendor Sent Date"] ||
          row["Vendor Assign Date"] ||
          row["Vendor Assigned Date"] ||
          row["Vendor Date"] ||
          row["Sent to Vendor"] ||
          "";

        compRaw =
          row.vendorCompleteDate ||
          row["Vendor Complete Date"] ||
          "";

      } else {
        /* ── Client TAT ── */
        // Since we already filtered to Pending-only above,
        // isInsuffTAT will never be true here (Insuff rows are skipped).
        // Keeping the logic intact for safety.
        const rowStatus = rowStatusCheck;

        if (rowStatus === "insuff") {
          isInsuffTAT = true;

          sentRaw =
            row["Insuff Date"]       ||
            row["insuff date"]       ||
            row["InsuffDate"]        ||
            row["Insuff_Date"]       ||
            row.insuffDate           ||
            row["Insufficient Date"] ||
            "";

          compRaw =
            row["Insuff Clear Date"]       ||
            row["insuff clear date"]       ||
            row["InsuffClearDate"]         ||
            row["Insuff_Clear_Date"]       ||
            row.insuffClearDate            ||
            row["Insufficient Clear Date"] ||
            "";

        } else {
          /* Normal client TAT — original logic untouched */
          sentRaw =
            row.clientSentDate         ||
            row["Client Sent Date"]    ||
            row["Sent Date"]           ||
            row["Client Assign Date"]  ||
            row["Assigned Date"]       ||
            row.assignDate             ||
            "";

          compRaw =
            row.clientCompletedDate          ||
            row["Completed Date"]            ||
            row["Client Close Date"]         ||
            row["Client Completed Date"]     ||
            row["Completion Date"]           ||
            "";
        }
      }

      const sd = parseDate(sentRaw);
      const cd = parseDate(compRaw);

      let tatDays = null;
      let isOngoing = false;

      if (sd) {
        if (cd) {
          tatDays = calcTatDays(sd, cd);
        } else {
          tatDays = calcTatDays(sd);
          isOngoing = true;
        }
      }

      const [pct, label, pCls, barCls, dayCls] = penTier(tatDays, isOngoing);

      const amount =
        tatMode === "vendor"
          ? Number(
              row.vendorRate    ||
              row["Vendor Rate"]   ||
              row["Vendor Amount"] ||
              row["Vendor Price"]  ||
              row.rate             ||
              row.Amount           ||
              row["Case Amount"]   ||
              0
            )
          : Number(
              row.clientRate    ||
              row["Client Rate"]   ||
              row["Client Amount"] ||
              row["Client Price"]  ||
              row.rate             ||
              row.Amount           ||
              row["Case Amount"]   ||
              0
            );

      const penAmount = Math.round((amount * pct) / 100);

      rows.push({
        _i: idx++,
        _k: `${ck}|${idx}`,
        ck,
        cand: row["Candidate Name"] || "—",
        phone:
          row["Candidate Phone"] ||
          row["Candidate Phone Number"] ||
          row["Candidate Mobile"] ||
          row["Candidate Mobile Number"] ||
          row["Phone Number"] ||
          row["Mobile Number"] ||
          row["Phone"] ||
          row.phone ||
          "—",
        address:
          row["Address"] ||
          row["Full Address"] ||
          row["Candidate Address"] ||
          row["Current Address"] ||
          row["Permanent Address"] ||
          row.address ||
          "—",
        comp: row["Company Name"] || row["Client Name"] || ck,
        chk:
          tatMode === "vendor"
            ? row["Vendor Name"] || row["Vendor Company"] || row.vendorName || row["Check Name"] || "—"
            : row["Check Name"] || "—",
        // Kept separate (unlike `chk` above, which picks ONE or the other
        // depending on tatMode) so the Out-of-TAT export can show both in
        // their own columns regardless of which TAT view is active.
        checkNameOnly: row["Check Name"] || "—",
        // "Vendor Company" is the field name this app actually stores the
        // vendor under most often (same fallback order MyTable.jsx uses) —
        // it was missing here, so those cases fell through as vendor-less:
        // undercounted or miscategorized under the vendor dropdown/filter.
        vendorNameOnly: row["Vendor Name"] || row["Vendor Company"] || row.vendorName || "—",
        sentStr: fmtDate(sd),
        compStr: fmtDate(cd),
        tatDays,
        isOngoing,
        isDay4: tatDays === 4,
        isInsuffTAT,
        pct,
        label,
        pCls,
        barCls,
        dayCls,
        amount,
        penAmount,
        status: row.Status || row.status || "Pending",
        _search: [
          row["Candidate Name"] || "",
          row["Candidate Phone"] || row["Phone Number"] || row["Mobile Number"] || row["Phone"] || row.phone || "",
          row["Address"] || row["Full Address"] || row["Candidate Address"] || row["Current Address"] || row["Permanent Address"] || row.address || "",
          ck,
          row["Check Name"] || "",
          row["Vendor Name"] || "",
          row.vendorName || "",
          row["Company Name"] || row["Client Name"] || "",
        ]
          .join("|")
          .toLowerCase(),
      });
    }
  }

  return rows;
}

/* ─────────────────────────── WEB WORKER ────────────────────────────────── */
const WORKER_CODE = `
self.onmessage = function(e) {
  const { rows, q, pf, cf, vf, sc, sd } = e.data;
  let out = rows;
  if (cf !== "all") out = out.filter(r => r.ck === cf);
  if (vf !== "all") out = out.filter(r => r.chk === vf);
  if (q) out = out.filter(r => r._search.includes(q));
  if      (pf === "clean") out = out.filter(r => !r.isOngoing && r.pct === 0 && r.tatDays !== null);
  else if (pf === "10")    out = out.filter(r => r.pct === 10);
  else if (pf === "20")    out = out.filter(r => r.pct === 20);
  else if (pf === "50")    out = out.filter(r => r.pct === 50);
  else if (pf === "open")  out = out.filter(r => r.isOngoing);
  else if (pf === "day4")  out = out.filter(r => r.tatDays === 4);

  out = out.slice().sort((a, b) => {
    let av = a[sc], bv = b[sc];
    if (av == null) av = sd === "asc" ? Infinity : -Infinity;
    if (bv == null) bv = sd === "asc" ? Infinity : -Infinity;
    if (typeof av === "string") return sd === "asc" ? av.localeCompare(bv) : bv.localeCompare(av);
    return sd === "asc" ? av - bv : bv - av;
  });

  self.postMessage(out.map(r => r._i));
};
`;

let _worker = null;

function getWorker() {
  if (_worker) return _worker;
  if (typeof Worker === "undefined") return null;

  try {
    const blob = new Blob([WORKER_CODE], { type: "application/javascript" });
    _worker = new Worker(URL.createObjectURL(blob));
    return _worker;
  } catch {
    return null;
  }
}

