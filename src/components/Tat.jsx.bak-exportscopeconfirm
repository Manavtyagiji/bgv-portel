/* ─────────────────────────── CONSTANTS ──────────────────────────────────── */
const MASTER_KEY = "__MASTER_TABLE__";
const ROW_H = 46;
const OVER = 5;

/* ─────────────────────────── DATE HELPERS ───────────────────────────────── */
const D_CACHE = new Map();

function parseDate(str) {
  if (!str) return null;

  // Already a JS Date object — keep row's original value, no overwrite.
  if (str instanceof Date && !Number.isNaN(str.getTime())) return str;

  const s = String(str).trim();
  if (!s) return null;
  if (D_CACHE.has(s)) return D_CACHE.get(s);

  let dt = null;

  // Excel serial number (example: 46148). This keeps every row independent.
  const serial = Number(s);
  if (Number.isFinite(serial) && serial > 1000 && serial < 80000 && s === String(Math.floor(serial))) {
    const excelEpoch = new Date(Date.UTC(1899, 11, 30));
    const candidate = new Date(excelEpoch.getTime() + serial * 86400000);
    if (!Number.isNaN(candidate.getTime()) && candidate.getFullYear() > 1950 && candidate.getFullYear() < 2100) {
      D_CACHE.set(s, candidate);
      return candidate;
    }
  }

  // ISO / DB format: 2026-05-06 or 2026-05-06T...
  const iso = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/);
  if (iso) {
    const y = Number(iso[1]);
    const m = Number(iso[2]);
    const d = Number(iso[3]);
    const candidate = new Date(y, m - 1, d);
    if (!Number.isNaN(candidate.getTime()) && candidate.getFullYear() > 1950 && candidate.getFullYear() < 2100) dt = candidate;
  }

  // Slash / hyphen dates.
  // Important: no static date is used here. Each row is parsed from its own cell value.
  // In your portal, Excel short date like 5/6/26 should display as 06 May 2026.
  if (!dt) {
    const m = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2}|\d{4})$/);
    if (m) {
      const first = Number(m[1]);
      const second = Number(m[2]);
      let year = Number(m[3]);
      const shortYear = m[3].length === 2;
      if (year < 100) year += 2000;

      let day;
      let month;

      if (first > 12) {
        day = first;
        month = second;
      } else if (second > 12) {
        month = first;
        day = second;
      } else if (shortYear) {
        // 5/6/26 => 06 May 2026, 4/29/26 => 29 Apr 2026
        month = first;
        day = second;
      } else {
        // 02/05/2026 => 02 May 2026
        day = first;
        month = second;
      }

      const candidate = new Date(year, month - 1, day);
      if (!Number.isNaN(candidate.getTime()) && candidate.getFullYear() > 1950 && candidate.getFullYear() < 2100) dt = candidate;
    }
  }

  // Text date like 06 May 2026 / 05 Jun 2026.
  if (!dt) {
    const candidate = new Date(s);
    if (!Number.isNaN(candidate.getTime()) && candidate.getFullYear() > 1950 && candidate.getFullYear() < 2100) dt = candidate;
  }

  D_CACHE.set(s, dt);
  return dt;
}

function fmtINR(n) {
  return "₹\u202f" + Number(n || 0).toLocaleString("en-IN");
}

function fmtDate(dt) {
  if (!dt) return null;
  return dt.toLocaleDateString("en-IN", {
    day: "2-digit",
    month: "short",
    year: "numeric",
  });
}

function cleanMailText(value) {
  return String(value ?? "-").replace(/\s+/g, " ").trim() || "-";
}

function limitMailText(value, max = 60) {
  const text = cleanMailText(value);
  return text.length > max ? text.slice(0, max - 3) + "..." : text;
}

function safeFilename(value) {
  return String(value || "vendor")
    .replace(/[\/:*?"<>|]+/g, "")
    .replace(/\s+/g, "_")
    .trim() || "vendor";
}

