export const savePortalState = async (req, res) => {
  try {
    const key = String(req.params.key || "").trim();
    if (!key) return res.status(400).json({ error: "State key required" });

    const value = req.body?.value ?? {};

    const doc = await PortalState.findOneAndUpdate(
      { key },
      {
        $set: {
          value,
          updatedBy: req.user?.email || "unknown",
        },
      },
      { new: true, upsert: true }
    );

    res.json(doc.value);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
};

/* Atomic, additive update — merges only the given top-level keys into the
   stored `value` object instead of replacing the whole document. Used by
   Allocations.jsx so that saving a client/vendor/check allocation for one
   admin can never race with (and silently clobber) another save that landed
   moments earlier — e.g. the previous GET-then-PUT-the-whole-document
   pattern could drop an already-saved checkAllocations_* key if a second
   save's PUT completed after a first one but was based on a snapshot taken
   before the first save's write. $mergeObjects (aggregation-pipeline update)
   merges patch's keys onto the existing value at the DB level, atomically.
   The patch object must be wrapped in $literal — otherwise Mongo's
   aggregation expression parser tries to interpret its own keys as field
   paths, and rejects any key containing a "." (e.g. an email address like
   checkAllocations_superadmin@tervies.com) with "FieldPath field names may
   not contain '.'". $literal tells it to treat the object as opaque data. */
export const patchPortalState = async (req, res) => {
  try {
    const key = String(req.params.key || "").trim();
    if (!key) return res.status(400).json({ error: "State key required" });

    const patch = req.body?.patch;
    if (!patch || typeof patch !== "object" || Array.isArray(patch)) {
      return res.status(400).json({ error: "patch object required" });
    }

    const doc = await PortalState.findOneAndUpdate(
      { key },
      [
        {
          $set: {
            value: { $mergeObjects: [{ $ifNull: ["$value", {}] }, { $literal: patch }] },
            updatedBy: req.user?.email || "unknown",
          },
        },
      ],
      { new: true, upsert: true }
    );

    res.json(doc.value);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
};
