/* ───────── IP BLOCK AFTER 5 WRONG PASSWORD ATTEMPTS ─────────
   NOTE:
   - This is in-memory blocking.
   - It works immediately.
   - If backend restarts, blocked IP list resets.
   - For permanent blocking, use MongoDB model later.
*/
const loginAttemptsByIp = new Map();

const MAX_WRONG_ATTEMPTS = 5;
const BLOCK_TIME_MS = 24 * 60 * 60 * 1000; // 24 hours

function getClientIp(req) {
  const forwarded = req.headers["x-forwarded-for"];

  if (forwarded) {
    return String(forwarded).split(",")[0].trim();
  }

  return (
    req.ip ||
    req.connection?.remoteAddress ||
    req.socket?.remoteAddress ||
    "unknown"
  );
}

function getIpState(ip) {
  const state = loginAttemptsByIp.get(ip);

  if (!state) {
    return {
      count: 0,
      blockedUntil: null,
    };
  }

  return state;
}

function isIpBlocked(ip) {
  const state = getIpState(ip);

  if (!state.blockedUntil) return false;

  if (Date.now() > state.blockedUntil) {
    loginAttemptsByIp.delete(ip);
    return false;
  }

  return true;
}

function registerWrongAttempt(ip) {
  const state = getIpState(ip);

  const newCount = Number(state.count || 0) + 1;

  if (newCount >= MAX_WRONG_ATTEMPTS) {
    loginAttemptsByIp.set(ip, {
      count: newCount,
      blockedUntil: Date.now() + BLOCK_TIME_MS,
    });

    return {
      blocked: true,
      count: newCount,
    };
  }

  loginAttemptsByIp.set(ip, {
    count: newCount,
    blockedUntil: null,
  });

  return {
    blocked: false,
    count: newCount,
  };
}

function clearWrongAttempts(ip) {
  loginAttemptsByIp.delete(ip);
}

const signToken = (id) =>
  jwt.sign({ id }, process.env.JWT_SECRET, { expiresIn: "30d" });

const norm = (v = "") => String(v).toLowerCase().trim();

