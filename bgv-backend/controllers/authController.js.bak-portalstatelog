    if (user.status === "rejected") {
      return res.status(403).json({
        error: "Account rejected",
        status: "rejected",
      });
    }

    const token = signToken(user._id);

    res.json({
      token,
      user,
    });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
};

/* ───────── LOCALSTORAGE SERVER SYNC SUPPORT ─────────
   Keeps old frontend logic working, but stores shared users/tenants/TAC/allocations
   on the server so all laptops see the same data.
*/

function cleanUserForClient(user) {
  if (!user) return user;
  const obj = user.toObject ? user.toObject() : { ...user };
  delete obj.password;
  return obj;
}

export const syncUsers = async (req, res) => {
  try {
    const incoming = Array.isArray(req.body.users) ? req.body.users : [];
    const saved = [];

    for (const item of incoming) {
      if (!item?.email) continue;

      const email = norm(item.email);
      const existing = await User.findOne({ email });

      const update = {
        name: item.name || email.split("@")[0],
        email,
        role: item.role || "team",
        status: item.status || "pending",
        tenantId: item.tenantId || null,
        orgName: item.orgName || "",
        adminAccessCode: item.adminAccessCode || null,
        ownerAdminEmail: item.ownerAdminEmail || null,
        isInternal: item.isInternal || false,
      };

      // Preserve extra frontend fields without breaking existing schema.
      if (item.subTenantId !== undefined) update.subTenantId = item.subTenantId;
      if (item.createdByAdminEmail !== undefined) update.createdByAdminEmail = item.createdByAdminEmail;
      if (item.registeredAt !== undefined) update.registeredAt = item.registeredAt;
      if (item.joinedViaAdminCode !== undefined) update.joinedViaAdminCode = item.joinedViaAdminCode;

      if (existing) {
        Object.assign(existing, update);
        await existing.save();
        saved.push(cleanUserForClient(existing));
      } else {
        const created = await User.create({
          ...update,
          password: item.password || "123456",
        });
        saved.push(cleanUserForClient(created));
      }
    }

    res.json({ message: "Users synced", count: saved.length, users: saved });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
};

