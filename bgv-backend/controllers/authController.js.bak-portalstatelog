    if (!user) {
      user = await User.create({
        name: name || normalEmail.split("@")[0],
        email: normalEmail,
        password,
        role: role || "team",
        status: status || "approved",
        tenantId: tenantId || null,
        orgName: orgName || "",
        adminAccessCode: adminAccessCode || null,
        ownerAdminEmail: ownerAdminEmail || null,
