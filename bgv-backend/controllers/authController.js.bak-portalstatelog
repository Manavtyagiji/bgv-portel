async function notifySuperAdminNewRequest(applicantEmail, applicantName) {
  const mailDoc = await MailConfig.findOne({ isActive: true }).lean();
  if (!mailDoc?.smtpUser || !mailDoc?.smtpPass) return;

  const transporter = nodemailer.createTransport({
    host: mailDoc.smtpHost || "smtp.hostinger.com",
    port: mailDoc.smtpPort || 465,
    secure: true,
    auth: { user: mailDoc.smtpUser, pass: mailDoc.smtpPass },
  });

  await transporter.sendMail({
    from: mailDoc.fromName
      ? `"${mailDoc.fromName}" <${mailDoc.smtpUser}>`
      : mailDoc.smtpUser,
    to: SUPER_ADMIN_EMAIL,
    subject: "New Staff Join Request — Action Required",
    text: `A new team member has requested to join the Tervies BGV portal.\n\nName: ${applicantName}\nEmail: ${applicantEmail}\n\nPlease log in and go to Manage Users to approve or reject this request.\n\nRegards,\nTrue Verification Services`,
  });

  console.log(`[register] SA notified of new pending request from ${applicantEmail}`);
}

export async function register(req, res) {
  try {
    const {
      name,
      email,
      password,
      role: reqRole,
      orgName,
      tenantAccessCode,
      accessCode,
    } = req.body;

    if (!name || !email || !password) {
      return res.status(400).json({
        error: "Name, email, password required",
      });
    }

    const normalEmail = norm(email);

    // ─────────────────────────
    // Existing email check
    // ─────────────────────────

    if (await User.findOne({ email: normalEmail })) {
      return res.status(400).json({
        error: "Email already exists",
      });
    }

    const isSuperAdmin =
      normalEmail === SUPER_ADMIN_EMAIL.toLowerCase();

    let role = isSuperAdmin ? "superadmin" : reqRole || "team";

    let status = isSuperAdmin ? "approved" : "pending";

    let tenantId = null;
    let adminAccessCode = null;
    let ownerAdminEmail = null;

    // ─────────────────────────
    // COMPANY ADMIN REGISTRATION
    // ─────────────────────────

    if (role === "admin") {

      if (!tenantAccessCode) {
        return res.status(400).json({
          error: "Tenant access code required",
        });
      }

      const code = String(tenantAccessCode)
        .trim()
        .toUpperCase();

      // ─────────────────────────
      // FIRST CHECK TAC FROM CLIENT DB
      // ─────────────────────────

      let tac = await Client.findOne({
        type: "tenantCode",
        code,
      });

      // ─────────────────────────
      // IF NOT FOUND → CHECK PORTAL STATE
      // ─────────────────────────

      if (!tac) {

        const state = await PortalState.findOne({
          key: "tenantAccessCodes",
        });

        const codes = state?.value || {};

        const entry = codes[code];

        if (!entry) {
          return res.status(400).json({
            error: "Invalid or used code",
          });
        }

        if (entry.used) {
          return res.status(400).json({
            error: "Code already used",
          });
        }

        // mark used
        entry.used = true;
        entry.usedBy = normalEmail;
        entry.usedAt = new Date().toISOString();

        codes[code] = entry;

        state.value = codes;

        await state.save();

      } else {

        if (tac.used) {
          return res.status(400).json({
            error: "Code already used",
          });
        }

        tac.used = true;
        tac.usedBy = normalEmail;
        tac.usedAt = new Date();

        await tac.save();
      }

      // ─────────────────────────
      // CREATE TENANT
      // ─────────────────────────

      tenantId =
        orgName.toLowerCase().replace(/\s+/g, "_").slice(0, 10) +
        "_" +
        Date.now().toString(36);

      adminAccessCode =
        tenantId.slice(0, 5) +
        "-" +
        Math.random().toString(36).slice(2, 6).toUpperCase();

      ownerAdminEmail = normalEmail;

      // create tenant client entry
      await Client.create({
        type: "tenant",
        tenantId,
        name: orgName,
        adminEmail: normalEmail,
        adminAccessCode,
        accessCodeUsed: code,
      });
    }

    // ─────────────────────────
    // TEAM MEMBER REGISTRATION
    // ─────────────────────────

    if (role === "team" && accessCode) {

      const ownerAdmin = await User.findOne({
        adminAccessCode: accessCode,
        role: "admin",
      });

      if (!ownerAdmin) {
        return res.status(400).json({
          error: "Invalid admin access code",
        });
      }

      tenantId = ownerAdmin.tenantId;
      ownerAdminEmail = ownerAdmin.email;

      // Left as "pending" (the default already set above), not auto-approved —
      // secondary admins review and approve their own team members in Manage
      // Users, and that workflow is already relied on (existing pending team
      // members sit here today). Auto-approving would silently skip that step.
    }

    // ─────────────────────────
    // CREATE USER
    // ─────────────────────────

    const user = await User.create({
      name,
      email: normalEmail,
      password,

      role,
      status,

      tenantId,
      orgName,

      adminAccessCode,
      ownerAdminEmail,
    });

    const token =
      status === "approved"
        ? signToken(user._id)
        : null;

    // Notify super admin when an internal staff request is pending approval
    if (status === "pending" && !tenantId && !ownerAdminEmail) {
      notifySuperAdminNewRequest(normalEmail, name).catch(e =>
        console.warn("[register] SA notify failed:", e.message)
      );
    }

    res.status(201).json({
      message:
        status === "approved"
          ? "Account created"
          : "Waiting for approval",

      token,
      user,
    });

  } catch (err) {

    console.error("REGISTER ERROR:", err);

    res.status(500).json({
      error: err.message,
    });
  }
}
/* ───────── LOGIN ───────── */

export async function login(req, res) {
  try {
    const { email, password } = req.body;

    const ip = getClientIp(req);

    /* 1. If IP already blocked */
    if (isIpBlocked(ip)) {
      const state = getIpState(ip);
      const remainingMs = state.blockedUntil - Date.now();
      const remainingMinutes = Math.ceil(remainingMs / 60000);

      return res.status(429).json({
        error: `Your IP is blocked due to 5 wrong password attempts. Try again after ${remainingMinutes} minutes or contact admin.`,
        blocked: true,
        ip,
      });
    }

    const user = await User.findOne({ email: norm(email) });

    /* 2. Wrong email or password */
    if (!user || !(await user.matchPassword(password))) {
      const attempt = registerWrongAttempt(ip);

      if (attempt.blocked) {
        return res.status(429).json({
          error: "Your IP has been blocked due to 5 wrong password attempts. Contact admin to unblock.",
          blocked: true,
          ip,
        });
      }

      return res.status(401).json({
        error: `Invalid credentials. ${MAX_WRONG_ATTEMPTS - attempt.count} attempts left before IP block.`,
        blocked: false,
        attemptsLeft: MAX_WRONG_ATTEMPTS - attempt.count,
      });
    }

    /* 3. Correct password means clear wrong attempts */
    clearWrongAttempts(ip);

    if (user.status === "pending") {
      return res.status(403).json({
        error: "Waiting for approval",
        status: "pending",
      });
    }

    if (user.status === "rejected") {
      return res.status(403).json({
        error: "Account rejected",
        status: "rejected",
      });
    }

    const token = signToken(user._id);

    res.json({ token, user });
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
}
