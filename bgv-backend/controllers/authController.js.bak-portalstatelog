/* ───────── RESET USER PASSWORD ───────── */
// Uses user.save() (not findByIdAndUpdate) so the User model's pre-save hook
// hashes the new password through bcrypt — same path as registration.
// Route itself is protect+adminOnly (admin or superadmin), so manager/tl
// can never reach this at all, matching "only super admin can reset
// passwords" for those two roles. The check below narrows admin (secondary
// admin) callers further: they may only reset a password for a user in
// their OWN tenant — without this, any secondary admin could reset any
// other tenant's user's password just by knowing/guessing their user id.
// Super admin is unrestricted, same as before.
export const resetUserPassword = async (req, res) => {
  try {
    const { password } = req.body;

    if (!password || String(password).trim().length < 1) {
      return res.status(400).json({ error: "New password is required" });
    }

    const user = await User.findById(req.params.id);

    if (!user) {
      return res.status(404).json({ error: "User not found" });
    }

    if (req.user?.role !== "superadmin") {
      const callerTenantId = req.user?.tenantId || null;
      const targetTenantId = user.tenantId || null;
      if (!callerTenantId || targetTenantId !== callerTenantId) {
        return res.status(403).json({ error: "You can only reset passwords for users in your own team." });
      }
    }

    user.password = password;
    await user.save(); // pre-save hook hashes the password

    const clean = await User.findById(user._id).select("-password").lean();
    res.json(clean);
  } catch (err) {
    res.status(500).json({ error: err.message });
  }
};

