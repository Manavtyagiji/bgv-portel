// bgv-backend/server.js

import express from "express";
import dotenv from "dotenv";
import cors from "cors";
import compression from "compression";
import path from "path";
import { fileURLToPath } from "url";

import connectDB from "./config/db.js";
import { startReportCleanupSchedule } from "./jobs/reportCleanup.js";
import { startAuditCleanupSchedule }  from "./jobs/auditCleanup.js";

import authRoutes from "./routes/authRoutes.js";
import uploadRoutes from "./routes/uploadRoutes.js";
import pricingRoutes from "./routes/pricingRoutes.js";
import clientRoutes from "./routes/clientRoutes.js";
import exportRoutes from "./routes/exportRoutes.js";
import dailyUploadRoutes    from "./routes/dailyUploadRoutes.js";
import auditRoutes          from "./routes/auditRoutes.js";
import vendorContactRoutes  from "./routes/vendorContactRoutes.js";
import clientContactRoutes  from "./routes/clientContactRoutes.js";
import inboxRoutes          from "./routes/inboxRoutes.js";
import dailyFollowUpRoutes  from "./routes/dailyFollowUpRoutes.js";

dotenv.config();

const app = express();
const PORT = process.env.PORT || 5002;

/* ===== GZIP COMPRESSION (shrinks JSON responses ~85-90% in transit) ===== */
app.use(compression());


/* __dirname fix (ESM) */
const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

/* Connect DB */
connectDB();

/* Report file cleanup (preview mode until DRY_RUN is set to false) */
startReportCleanupSchedule();
/* Audit log cleanup — deletes entries older than 3 months */
startAuditCleanupSchedule();

/* ===== CORS (SAFE FOR PROD + LOCAL) ===== */
const allowedOrigins = [
  "http://localhost:5173",
  "http://127.0.0.1:5173",
  "http://72.61.226.214",
  "https://72.61.226.214",
  "https://profeix.info",
  "https://www.profeix.info",
];

app.use(
  cors({
    origin: function (origin, callback) {
      // allow server-to-server / curl / postman
      if (!origin) return callback(null, true);

      if (allowedOrigins.includes(origin)) {
        return callback(null, true);
      }

      console.warn("Blocked by CORS:", origin);
      return callback(new Error("Not allowed by CORS"));
    },
    credentials: true,
  })
);

/* Preflight */
app.options("*", cors());

/* Body parser */
app.use(express.json({ limit: "200mb" }));
app.use(express.urlencoded({ extended: true, limit: "200mb" }));

/* Static uploads */
app.use("/uploads", express.static(path.join(__dirname, "uploads")));

/* Health check */
app.get("/api/health", (req, res) => {
  res.json({
    status: "ok",
    env: process.env.NODE_ENV,
    time: new Date().toISOString(),
  });
});

/* ===== ROUTES ===== */
app.use("/api/auth", authRoutes);
app.use("/api/upload", uploadRoutes); // send-mail route will work from here
app.use("/api/pricing", pricingRoutes);
app.use("/api/clients", clientRoutes);
app.use("/api/export", exportRoutes);
app.use("/api/daily-uploads", dailyUploadRoutes);
app.use("/api/audit", auditRoutes);
app.use("/api/vendor-contacts", vendorContactRoutes);
app.use("/api/client-contacts", clientContactRoutes);
app.use("/api/inbox", inboxRoutes);
app.use("/api/daily-followups", dailyFollowUpRoutes);

/* Root */
app.get("/", (req, res) => {
  res.send("BGV Backend Running 🚀");
});

/* 404 */
app.use((req, res) => {
  res.status(404).json({
    message: `Cannot ${req.method} ${req.originalUrl}`,
  });
});

/* Global Error Handler */
app.use((err, req, res, next) => {
  console.error("Server error:", err.message);

  res.status(err.status || 500).json({
    message: err.message || "Internal Server Error",
  });
});

/* Start server */
app.listen(PORT, () => {
  console.log(`🚀 Server running on port ${PORT}`);
});