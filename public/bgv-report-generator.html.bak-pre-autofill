</div>

<!-- Hidden off-screen measuring container -->
<div id="measureBox" style="position:absolute;left:-9999px;top:0;width:678px;font-family:'DejaVu Sans',Verdana,sans-serif;font-size:11px;line-height:1.45;"></div>

<script>
(function(){

/* ---------------------------------------------------------------------- */
/* State                                                                   */
/* ---------------------------------------------------------------------- */
var state = {
  result: 'red',
  companyName: '',
  companyAddress: '',
  logo: null,
  sigRed: null,
  sigGreen: null,
  signatoryChecked: false,
  caseRefNo: '', verificationDate: '', pName: '', pFatherName: '', pDob: '',
  pAddress: '', pAltAddress: '',
  cases: [ defaultCase() ]
};

function defaultCase(){
  return {
    caseNumber: 'CC/1123/2021', court: 'IX Metropolitan Magistrate Court', state: 'Maharashtra',
    district: 'Mumbai', actSection: 'Negotiable Instruments Act, 1881 - Sec 138',
    caseType: 'Criminal', filingDate: '12-Jun-2021',
    petitioner: 'State Bank of India', respondent: (document.getElementById('pName')||{}).value || '', respondentLine2: '',
    status: 'Pending', natureOfDisposal: 'N/A', disposedOfDate: 'N/A',
    matchSummary: 'Name, Father\'s Name and Address match with the subject provided details.',
    riskSummary: 'Case is registered under Sec 138 of NI Act (cheque bounce) and is currently pending trial.',
    orderSummary: 'No final order passed. Matter listed for next hearing.'
  };
}

var COURT_GROUPS = [
  { name: 'General Courts', rows: [
      {name:'High Courts', jurisdiction:'High Courts of India along with respective District &amp; Sessions Courts', since:'Till Date'},
      {name:'Civil Courts', jurisdiction:'Civil Courts across India', since:'Till Date'},
      {name:'Criminal Courts', jurisdiction:'Criminal Courts across India', since:'Till Date', key:'criminal'},
      {name:'Supreme Court', jurisdiction:'Supreme Court of India', since:'Till Date'},
      {name:'Consumer Courts', jurisdiction:'Consumer Dispute Redressal Forums (District / State / National)', since:'Till Date'}
  ]},
  { name: 'Tribunals', rows: [
      {name:'CEGAT / CESTAT', jurisdiction:'Customs, Excise &amp; Service Tax Appellate Tribunal', since:'Till Date'},
      {name:'DRT', jurisdiction:'Debts Recovery Tribunal', since:'Till Date'},
      {name:'DRAT', jurisdiction:'Debts Recovery Appellate Tribunal', since:'Till Date'},
      {name:'ITAT', jurisdiction:'Income Tax Appellate Tribunal', since:'Till Date'},
      {name:'NCLT', jurisdiction:'National Company Law Tribunal', since:'Till Date'},
      {name:'SAT', jurisdiction:'Securities Appellate Tribunal', since:'Till Date'},
      {name:'NGT', jurisdiction:'National Green Tribunal', since:'Till Date'},
      {name:'NCLAT', jurisdiction:'National Company Law Appellate Tribunal', since:'Till Date'},
      {name:'APTE', jurisdiction:'Appellate Tribunal for Electricity', since:'Till Date'}
  ]},
  { name: 'Defaulter Lists', rows: [
      {name:'CIBIL', jurisdictionRed:'RBI List of Willful Defaulters', jurisdictionGreen:'RBI List of Defaulters', since:'Till Date', key:'cibil'},
      {name:'Crif', jurisdiction:'Crif High Mark Defaulter Database', since:'Till Date'},
      {name:'EPF', jurisdiction:'Employees\' Provident Fund Organisation Defaulters List', since:'Till Date'},
      {name:'Equifax', jurisdiction:'Equifax Defaulter Database', since:'Till Date'},
      {name:'MCA', jurisdiction:'Ministry of Corporate Affairs - Disqualified Directors', since:'Till Date'}
  ]}
];
var OTHERS_GROUP = { name:'Others', rows: [
    {name:'Others', jurisdiction:'Other regulatory tribunals and forums', since:'Till Date'},
    {name:'FIR', jurisdiction:'State Police Department online eFIR records', since:'Till Date'}
]};

/* ---------------------------------------------------------------------- */
/* localStorage helpers                                                    */
/* ---------------------------------------------------------------------- */
function lsGet(key){ try{ return localStorage.getItem(key); }catch(e){ return null; } }
function lsSet(key,val){ try{ localStorage.setItem(key,val); }catch(e){} }
function lsRemove(key){ try{ localStorage.removeItem(key); }catch(e){} }

/* ---------------------------------------------------------------------- */
/* Image trim / scale utility                                              */
/* ---------------------------------------------------------------------- */
function loadImageFile(file){
  return new Promise(function(resolve,reject){
    var reader = new FileReader();
    reader.onload = function(){
      var img = new Image();
      img.onload = function(){ resolve(img); };
      img.onerror = reject;
      img.src = reader.result;
    };
    reader.onerror = reject;
    reader.readAsDataURL(file);
  });
}

function trimAndScale(img, maxW, maxH){
  var c = document.createElement('canvas');
  c.width = img.naturalWidth || img.width;
  c.height = img.naturalHeight || img.height;
  var ctx = c.getContext('2d');
  ctx.drawImage(img,0,0);
  var w = c.width, h = c.height;
  var data;
  try{ data = ctx.getImageData(0,0,w,h).data; }catch(e){ data = null; }

  var minX=0,minY=0,maxX=w-1,maxY=h-1;
  if(data){
    minX=w; minY=h; maxX=0; maxY=0;
    var found=false;
    var threshold = 250; // near-white
    for(var y=0;y<h;y++){
      for(var x=0;x<w;x++){
        var idx=(y*w+x)*4;
        var r=data[idx],g=data[idx+1],b=data[idx+2],a=data[idx+3];
        var isBg = (a===0) || (r>threshold && g>threshold && b>threshold);
        if(!isBg){
          found=true;
          if(x<minX) minX=x;
          if(x>maxX) maxX=x;
          if(y<minY) minY=y;
          if(y>maxY) maxY=y;
        }
      }
    }
    if(!found){ minX=0; minY=0; maxX=w-1; maxY=h-1; }
  }
  var cw = Math.max(1, maxX-minX+1);
  var ch = Math.max(1, maxY-minY+1);

  var trimmed = document.createElement('canvas');
  trimmed.width = cw; trimmed.height = ch;
  trimmed.getContext('2d').drawImage(c, minX, minY, cw, ch, 0, 0, cw, ch);

  var scale = Math.min(1, maxW/cw, maxH/ch);
  var outW = Math.max(1, Math.round(cw*scale));
  var outH = Math.max(1, Math.round(ch*scale));
  var out = document.createElement('canvas');
  out.width = outW; out.height = outH;
  out.getContext('2d').drawImage(trimmed, 0, 0, outW, outH);
  return out.toDataURL('image/png');
}

/* ---------------------------------------------------------------------- */
/* Form wiring                                                             */
/* ---------------------------------------------------------------------- */
var $ = function(id){ return document.getElementById(id); };
var debounceTimer = null;
function scheduleRender(){
  if(debounceTimer) clearTimeout(debounceTimer);
  debounceTimer = setTimeout(renderPreview, 150);
}

function bindText(id, key){
  $(id).addEventListener('input', function(){ state[key] = this.value; scheduleRender(); });
}
bindText('companyName','companyName');
bindText('companyAddress','companyAddress');
bindText('caseRefNo','caseRefNo');
bindText('verificationDate','verificationDate');
bindText('pName','pName');
bindText('pFatherName','pFatherName');
bindText('pDob','pDob');
bindText('pAddress','pAddress');
bindText('pAltAddress','pAltAddress');

state.companyName = $('companyName').value;
state.companyAddress = $('companyAddress').value;
state.caseRefNo = $('caseRefNo').value;
state.verificationDate = $('verificationDate').value;
state.pName = $('pName').value;
state.pFatherName = $('pFatherName').value;
state.pDob = $('pDob').value;
state.pAddress = $('pAddress').value;
state.pAltAddress = $('pAltAddress').value;

$('toggleRed').addEventListener('click', function(){ setResult('red'); });
$('toggleGreen').addEventListener('click', function(){ setResult('green'); });
function setResult(r){
  state.result = r;
  $('toggleRed').classList.toggle('active', r==='red');
  $('toggleGreen').classList.toggle('active', r==='green');
  $('caseDetailsHeading').style.display = r==='red' ? '' : 'none';
  $('casesList').style.display = r==='red' ? '' : 'none';
  $('addCase').style.display = r==='red' ? '' : 'none';
  updateSigUI();
  scheduleRender();
}

/* --- logo --- */
$('logoFile').addEventListener('change', function(e){
  var file = e.target.files[0];
  if(!file) return;
  loadImageFile(file).then(function(img){
    var dataUrl = trimAndScale(img, 900, 400);
    state.logo = dataUrl;
    lsSet('bgv_logo', dataUrl);
    updateLogoUI();
    scheduleRender();
  }).catch(function(){ alert('Could not read logo image.'); });
});
$('removeLogo').addEventListener('click', function(){
  state.logo = null;
  lsRemove('bgv_logo');
  $('logoFile').value = '';
  updateLogoUI();
  scheduleRender();
});
function updateLogoUI(){
  if(state.logo){
    $('logoPreview').src = state.logo;
    $('logoPreviewWrap').style.display = 'flex';
  } else {
    $('logoPreviewWrap').style.display = 'none';
  }
}

/* --- signature (separate slot per result type) --- */
function sigKey(){ return state.result==='red' ? 'bgv_sig_red' : 'bgv_sig_green'; }
function sigStateField(){ return state.result==='red' ? 'sigRed' : 'sigGreen'; }
$('signatoryCheck').addEventListener('change', function(){
  state.signatoryChecked = this.checked;
  $('sigFile').disabled = !this.checked;
  scheduleRender();
});
$('sigFile').addEventListener('change', function(e){
  var file = e.target.files[0];
  if(!file) return;
  loadImageFile(file).then(function(img){
    var dataUrl = trimAndScale(img, 500, 260);
    state[sigStateField()] = dataUrl;
    lsSet(sigKey(), dataUrl);
    updateSigUI();
    scheduleRender();
  }).catch(function(){ alert('Could not read signature image.'); });
});
$('removeSig').addEventListener('click', function(){
  state[sigStateField()] = null;
  lsRemove(sigKey());
  $('sigFile').value = '';
  updateSigUI();
  scheduleRender();
});
function updateSigUI(){
  $('sigTargetLabel').textContent = state.result==='red' ? '(for Red report)' : '(for Green report)';
  var current = state[sigStateField()];
  if(current){
    $('sigPreview').src = current;
    $('sigPreviewWrap').style.display = 'flex';
  } else {
    $('sigPreviewWrap').style.display = 'none';
  }
  $('sigFile').value = '';
}

/* --- load persisted images on open --- */
(function loadPersisted(){
  var logo = lsGet('bgv_logo');
  if(logo){ state.logo = logo; updateLogoUI(); }
  state.sigRed = lsGet('bgv_sig_red');
  state.sigGreen = lsGet('bgv_sig_green');
  updateSigUI();
})();

/* --- cases --- */
function renderCaseForm(){
  var wrap = $('casesList');
  wrap.innerHTML = '';
  state.cases.forEach(function(c, idx){
    var card = document.createElement('div');
    card.className = 'case-card';
    card.innerHTML =
      '<div class="case-head"><strong>Case ' + (idx+1) + '</strong>' +
      (state.cases.length>1 ? '<button type="button" class="remove-case" data-idx="'+idx+'">Remove</button>' : '') +
      '</div>' +
