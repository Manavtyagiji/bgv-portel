<div class="app">

  <!-- ================= FORM PANEL ================= -->
  <div class="form-panel">
    <h1>BGV Report Generator</h1>

    <label>Result</label>
    <div class="toggle">
      <button type="button" id="toggleRed" class="active red">Red · High Risk</button>
