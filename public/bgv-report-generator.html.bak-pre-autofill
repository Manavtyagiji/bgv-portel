/* ---------------------------------------------------------------------- */
var bulkRows = null;

function normalizeHeader(h){
  return String(h==null?'':h).toLowerCase().replace(/[^a-z0-9]/g,'');
}

var FIELD_ALIASES = {
  result: ['result','reporttype','risk','redgreen','reportresult'],
  refno: ['caserefno','refno','caseref','referenceno','reference'],
  date: ['verificationdate','date'],
  name: ['name','candidatename','subjectname'],
  father: ['fathersname','fathername'],
  dob: ['dateofbirth','dob'],
  address: ['address','currentaddress'],
  altaddress: ['alternateaddress','altaddress'],
  caseNumber: ['casenumber','caseno'],
  court: ['court'],
  stateField: ['state'],
  district: ['district'],
  actSection: ['actsection','actandsection','section'],
  caseType: ['casetype','type'],
  filingDate: ['filingdate'],
  petitioner: ['petitioner'],
  respondent: ['respondent'],
  respondentLine2: ['respondentline2'],
  status: ['status'],
  natureOfDisposal: ['natureofdisposal'],
  disposedOfDate: ['disposedofdate'],
  matchSummary: ['matchsummary'],
  riskSummary: ['risksummary'],
  orderSummary: ['ordersummary']
};

function buildHeaderMap(rawHeaders){
  var map = {};
  rawHeaders.forEach(function(h){
    var norm = normalizeHeader(h);
    Object.keys(FIELD_ALIASES).forEach(function(key){
      if(FIELD_ALIASES[key].indexOf(norm)!==-1){ map[key]=h; }
    });
  });
  return map;
}

function rowValue(row, map, key){
  var h = map[key];
  if(!h) return '';
  var v = row[h];
  return v==null ? '' : String(v).trim();
}

$('bulkFile').addEventListener('change', function(e){
  var file = e.target.files[0];
  var statusEl = $('bulkStatus');
  statusEl.classList.remove('err-note');
  if(!file){ bulkRows=null; $('bulkGenerate').disabled=true; return; }
  var reader = new FileReader();
  reader.onload = function(ev){
    try{
      var data = new Uint8Array(ev.target.result);
      var wb = XLSX.read(data, {type:'array'});
      var sheet = wb.Sheets[wb.SheetNames[0]];
      var rows = XLSX.utils.sheet_to_json(sheet, {defval:''});
      if(rows.length===0){ throw new Error('No rows found in the first sheet.'); }
      var headers = Object.keys(rows[0]);
      var map = buildHeaderMap(headers);
      if(!map.name){ throw new Error('Could not find a "Name" column in the sheet.'); }
      bulkRows = { rows: rows, map: map };
      statusEl.textContent = rows.length + ' row(s) loaded.';
      $('bulkGenerate').disabled = false;
    }catch(err){
      bulkRows = null;
      $('bulkGenerate').disabled = true;
      statusEl.classList.add('err-note');
      statusEl.textContent = 'Could not read file: ' + (err && err.message ? err.message : err);
    }
  };
  reader.onerror = function(){
    statusEl.classList.add('err-note');
    statusEl.textContent = 'Could not read file.';
  };
  reader.readAsArrayBuffer(file);
});

function rowToReportState(row, map){
  var resultRaw = rowValue(row, map, 'result').toLowerCase();
  var isGreen = /green|no\s*risk|norisk/.test(resultRaw);
  var result = isGreen ? 'green' : 'red';
  var name = rowValue(row, map, 'name');
  var caseObj = null;
  if(result==='red'){
    caseObj = {
      caseNumber: rowValue(row,map,'caseNumber'),
      court: rowValue(row,map,'court'),
      state: rowValue(row,map,'stateField'),
      district: rowValue(row,map,'district'),
      actSection: rowValue(row,map,'actSection'),
      caseType: rowValue(row,map,'caseType'),
      filingDate: rowValue(row,map,'filingDate'),
      petitioner: rowValue(row,map,'petitioner'),
      respondent: rowValue(row,map,'respondent') || name,
      respondentLine2: rowValue(row,map,'respondentLine2'),
      status: rowValue(row,map,'status'),
      natureOfDisposal: rowValue(row,map,'natureOfDisposal'),
      disposedOfDate: rowValue(row,map,'disposedOfDate'),
      matchSummary: rowValue(row,map,'matchSummary'),
      riskSummary: rowValue(row,map,'riskSummary'),
      orderSummary: rowValue(row,map,'orderSummary')
    };
  }
  return {
    result: result,
    caseRefNo: rowValue(row,map,'refno'),
    verificationDate: rowValue(row,map,'date'),
    pName: name,
    pFatherName: rowValue(row,map,'father'),
    pDob: rowValue(row,map,'dob'),
    pAddress: rowValue(row,map,'address'),
    pAltAddress: rowValue(row,map,'altaddress') || 'Not Provided',
    cases: caseObj ? [caseObj] : []
  };
}

function waitFrame(){
  return new Promise(function(resolve){ setTimeout(resolve, 80); });
}

$('bulkGenerate').addEventListener('click', function(){
  if(!bulkRows) return;
  var btn = this;
  var statusEl = $('bulkStatus');
  statusEl.classList.remove('err-note');
  btn.disabled = true;

  var snapshot = {
    result: state.result, caseRefNo: state.caseRefNo, verificationDate: state.verificationDate,
    pName: state.pName, pFatherName: state.pFatherName, pDob: state.pDob,
    pAddress: state.pAddress, pAltAddress: state.pAltAddress, cases: state.cases
  };

  var rows = bulkRows.rows, map = bulkRows.map;
  var idx = 0, okCount = 0, failCount = 0;

  function next(){
    if(idx >= rows.length){
      Object.assign(state, snapshot);
      renderPreview();
      btn.disabled = false;
      statusEl.textContent = 'Done: ' + okCount + ' generated, ' + failCount + ' failed.';
      if(failCount>0) statusEl.classList.add('err-note');
      return;
    }
    var row = rows[idx];
    var rowData = rowToReportState(row, map);
    Object.assign(state, rowData);
    statusEl.textContent = 'Generating ' + (idx+1) + ' of ' + rows.length + ': ' + (rowData.pName || '(no name)') + '…';
    renderPreview();
    waitFrame().then(function(){
      return exportPagesAsPdf(pdfFilenameFor(rowData.pName, rowData.result, rowData.caseRefNo));
    }).then(function(){
      okCount++;
    }).catch(function(err){
      failCount++;
      console.error('Row '+(idx+1)+' failed:', err);
    }).then(function(){
      idx++;
      setTimeout(next, 400);
    });
  }
  next();
});

})();
</script>
</body>
</html>
