/* ---------------------------------------------------------------------- */
/* Measurement + pagination                                                */
/* ---------------------------------------------------------------------- */
var MAX_CONTENT_HEIGHT = 1123 - 52 - 100;

function measureBlocks(blocks){
  var box = $('measureBox');
  box.innerHTML = '';
  var wrappers = blocks.map(function(b){
    var d = document.createElement('div');
    d.innerHTML = b.html;
    box.appendChild(d.firstChild || d);
    return box.lastChild;
  });
  var heights = wrappers.map(function(w){ return w.getBoundingClientRect().height; });
  box.innerHTML = '';
  return heights;
}

function paginate(blocks){
  var heights = measureBlocks(blocks);
  var pages = [[]];
  var currentHeight = 0;
  blocks.forEach(function(b, i){
    var h = heights[i];
    var needsBreak = b.breakBefore && currentHeight > 0;
    if(!needsBreak && currentHeight > 0 && (currentHeight + h) > MAX_CONTENT_HEIGHT){
      needsBreak = true;
    }
    if(needsBreak){
      pages.push([]);
      currentHeight = 0;
    }
    pages[pages.length-1].push(b.html);
    currentHeight += h;
  });
  return pages;
}

/* ---------------------------------------------------------------------- */
/* Render preview                                                          */
/* ---------------------------------------------------------------------- */
function renderPreview(){
  var blocks = buildBlocks();
  var pages = paginate(blocks);
  var total = pages.length;
  var container = $('preview');
  container.innerHTML = '';
  pages.forEach(function(pageBlocks, i){
    var page = document.createElement('div');
    page.className = 'page';
    var content = document.createElement('div');
    content.className = 'page-content';
    content.innerHTML = pageBlocks.join('');
    page.appendChild(content);
    var footer = document.createElement('div');
    footer.className = 'page-footer';
    footer.innerHTML =
      '<span></span>' +
      '<span>'+(i+1)+'/'+total+'</span>' +
      '<span></span>';
    page.appendChild(footer);
    container.appendChild(page);
  });
}

