/* ---------------------------------------------------------------------- */
/* Escaping helpers                                                        */
/* ---------------------------------------------------------------------- */
function escHtml(s){
  return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function escAttr(s){
  return escHtml(s).replace(/"/g,'&quot;');
}
function nl2br(s){
  return escHtml(s).replace(/\n/g,'<br>');
}
function linkify(s){
  var esc = escHtml(s);
  return esc.replace(/\n/g,'<br>').replace(/((?:https?:\/\/|www\.)[^\s<]+)/gi, function(m){
    var href = m.indexOf('http')===0 ? m : 'http://'+m;
    return '<a href="'+href+'" class="link" target="_blank" rel="noopener">'+m+'</a>';
  });
}

/* ---------------------------------------------------------------------- */
/* Risk-O-Meter gauge SVG                                                  */
/* ---------------------------------------------------------------------- */
function polar(cx,cy,r,angleDeg){
  var a = angleDeg * Math.PI/180;
  return { x: cx + r*Math.cos(a), y: cy - r*Math.sin(a) };
}
function arcPath(cx,cy,r1,r2,startDeg,endDeg){
  var p1 = polar(cx,cy,r2,startDeg);
  var p2 = polar(cx,cy,r2,endDeg);
  var p3 = polar(cx,cy,r1,endDeg);
  var p4 = polar(cx,cy,r1,startDeg);
  var largeArc = Math.abs(startDeg-endDeg) > 180 ? 1 : 0;
  return 'M '+p1.x+' '+p1.y+
    ' A '+r2+' '+r2+' 0 '+largeArc+' 0 '+p2.x+' '+p2.y+
    ' L '+p3.x+' '+p3.y+
    ' A '+r1+' '+r1+' 0 '+largeArc+' 1 '+p4.x+' '+p4.y+' Z';
}
function buildGaugeSvg(level){
  var cx=150,cy=140,R=108,r=58,cols=['#d7192b','#f18a1f','#fbc92d','#8dc63f','#139b48'];
  var s='';
  function pt(a,rad){ return [cx-rad*Math.cos(a), cy-rad*Math.sin(a)]; }
  for(var i=0;i<5;i++){
    var a0=(i*36+1)*Math.PI/180, a1=((i+1)*36-1)*Math.PI/180;
    var p0=pt(a0,R), p1=pt(a1,R), p2=pt(a1,r), p3=pt(a0,r);
    s+='<path d="M'+p0[0]+' '+p0[1]+' A'+R+' '+R+' 0 0 1 '+p1[0]+' '+p1[1]+' L'+p2[0]+' '+p2[1]+' A'+r+' '+r+' 0 0 0 '+p3[0]+' '+p3[1]+' Z" fill="'+cols[i]+'"/>';
  }
  var RO=132, pA=pt(0,RO), pB=pt(Math.PI,RO), pI=pt(Math.PI,R+2), pJ=pt(0,R+2);
  s='<path d="M'+pA[0]+' '+pA[1]+' A'+RO+' '+RO+' 0 0 1 '+pB[0]+' '+pB[1]+' L'+pI[0]+' '+pI[1]+' A'+(R+2)+' '+(R+2)+' 0 0 0 '+pJ[0]+' '+pJ[1]+' Z" fill="#e8e8e8"/>'+s;
  var labs=['Very High Risk','High Risk','Average Risk','Low Risk','No Risk'];
  labs.forEach(function(t,i){
    var a=(i*36+18);
    var p=pt(a*Math.PI/180,120);
    s+='<text x="'+p[0]+'" y="'+p[1]+'" font-family="Times New Roman,serif" font-size="10.5" text-anchor="middle" dominant-baseline="middle" transform="rotate('+(a-90)+' '+p[0]+' '+p[1]+')" fill="#222">'+t+'</text>';
  });
  var na=(level*36+18)*Math.PI/180, nTip=pt(na,96);
  var perp=na+Math.PI/2, w=6;
  var p1n=[cx+w*Math.cos(perp), cy-w*Math.sin(perp)];
  var p2n=[cx-w*Math.cos(perp), cy+w*Math.sin(perp)];
  s+='<path d="M'+p1n[0]+' '+p1n[1]+' L'+nTip[0]+' '+nTip[1]+' L'+p2n[0]+' '+p2n[1]+' Z" fill="#333"/><circle cx="'+cx+'" cy="'+cy+'" r="9" fill="#333"/><circle cx="'+cx+'" cy="'+cy+'" r="4.5" fill="#fff"/>';
  return '<svg width="232" height="129" viewBox="10 0 280 150">'+s+'</svg>';
}

