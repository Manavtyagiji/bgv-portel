function exportPagesAsPdf(filename){
  return new Promise(function(resolve, reject){
    var pageEls = Array.prototype.slice.call(document.querySelectorAll('#preview .page'));
    if(pageEls.length===0){ reject(new Error('Nothing to export.')); return; }
    var jsPDFCtor = (window.jspdf && window.jspdf.jsPDF) ? window.jspdf.jsPDF : window.jsPDF;
    var pdf = new jsPDFCtor({ unit:'pt', format:'a4', orientation:'portrait' });
    var pageW = 595.28, pageH = 841.89;
    function processPage(idx){
      if(idx >= pageEls.length){
        pdf.save(filename);
        resolve();
        return;
      }
      html2canvas(pageEls[idx], { scale:2, useCORS:true, backgroundColor:'#ffffff' }).then(function(canvas){
        var imgData = canvas.toDataURL('image/jpeg', 0.95);
        if(idx>0) pdf.addPage();
        pdf.addImage(imgData, 'JPEG', 0, 0, pageW, pageH);
        processPage(idx+1);
      }).catch(reject);
    }
    processPage(0);
  });
}

function pdfFilenameFor(name, result, suffix){
  var safeName = (name || 'Report').trim().replace(/[^a-z0-9]+/gi,'_');
  var riskSuffix = result==='red' ? 'HighRisk_SAMPLE' : 'NoRisk_SAMPLE';
  return safeName + (suffix ? '_'+suffix : '') + '_' + riskSuffix + '.pdf';
}

