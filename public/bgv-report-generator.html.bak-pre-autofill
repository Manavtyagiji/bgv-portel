<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BGV Report Generator</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<style>
:root{
  --bg:#f2f4f7; --panel:#ffffff; --text:#1b2430; --muted:#5b6675; --border:#dbe1e8;
  --accent:#00a0d2; --accent-dark:#1f6fb2; --danger:#c0392b; --input-bg:#ffffff;
}
@media (prefers-color-scheme: dark){
  :root{
    --bg:#10141a; --panel:#1a2029; --text:#e8edf3; --muted:#93a1b3;
    --border:#2c3542; --input-bg:#131822;
  }
}
*{box-sizing:border-box;}
html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Arial,sans-serif;}
.app{display:flex;align-items:flex-start;gap:22px;padding:22px;max-width:1500px;margin:0 auto;}
.form-panel{width:400px;flex-shrink:0;background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:18px;position:sticky;top:22px;max-height:calc(100vh - 44px);overflow-y:auto;}
.preview{flex:1;display:flex;flex-direction:column;align-items:center;gap:26px;min-width:0;}
@media (max-width:980px){
  .app{flex-direction:column;}
  .form-panel{position:static;width:100%;max-height:none;}
  .preview{width:100%;overflow-x:auto;}
}
h1{font-size:16px;margin:0 0 14px;}
h2{font-size:12.5px;text-transform:uppercase;letter-spacing:.04em;color:var(--muted);margin:20px 0 8px;border-top:1px solid var(--border);padding-top:14px;}
h2:first-of-type{border-top:none;padding-top:0;margin-top:0;}
label{display:block;font-size:12px;color:var(--muted);margin:10px 0 4px;}
input[type=text],input[type=date],textarea,select{
  width:100%;padding:7px 9px;border:1px solid var(--border);border-radius:6px;
  background:var(--input-bg);color:var(--text);font-size:13px;font-family:inherit;
}
textarea{resize:vertical;min-height:56px;}
.row2{display:flex;gap:10px;}
.row2>div{flex:1;}
.toggle{display:flex;border:1px solid var(--border);border-radius:8px;overflow:hidden;}
.toggle button{flex:1;padding:9px 6px;border:none;background:var(--input-bg);color:var(--text);cursor:pointer;font-size:13px;font-weight:600;}
.toggle button.active.red{background:#c0392b;color:#fff;}
.toggle button.active.green{background:#2e7d32;color:#fff;}
.checkbox-row{display:flex;align-items:flex-start;gap:8px;margin:10px 0;}
.checkbox-row input{margin-top:3px;}
.checkbox-row label{margin:0;font-size:12.5px;color:var(--text);}
button.btn{padding:7px 12px;border:1px solid var(--border);border-radius:6px;background:var(--input-bg);color:var(--text);font-size:12.5px;cursor:pointer;}
button.btn:hover{border-color:var(--accent);}
button.btn:disabled{opacity:.45;cursor:not-allowed;}
button.btn-primary{background:var(--accent);border-color:var(--accent);color:#fff;font-weight:600;padding:11px 14px;width:100%;font-size:14px;margin-top:6px;}
button.btn-primary:disabled{opacity:.6;cursor:not-allowed;}
.small-note{font-size:11.5px;color:var(--muted);margin-top:4px;}
.img-preview{display:flex;align-items:center;gap:10px;margin-top:8px;}
.img-preview img{max-height:46px;max-width:140px;background:#fff;border:1px solid var(--border);border-radius:4px;padding:3px;}
.case-card{border:1px solid var(--border);border-radius:8px;padding:12px;margin-top:12px;position:relative;}
.case-card .case-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:4px;}
.case-card .case-head strong{font-size:12.5px;}
.remove-case{background:none;border:none;color:var(--danger);cursor:pointer;font-size:12px;}
.add-case{margin-top:12px;width:100%;}
.err-note{color:var(--danger);font-size:12px;margin-top:8px;white-space:pre-wrap;}
.pdf-status{font-size:12px;margin-top:8px;color:var(--muted);}

/* ===== Report / page styling (always white, fixed px, independent of theme) ===== */
.page{
  width:794px;height:1123px;background:#ffffff;color:#1a1a1a;position:relative;flex-shrink:0;
  box-shadow:0 6px 24px rgba(0,0,0,.28);
  font-family:"DejaVu Sans",Verdana,Geneva,sans-serif;font-size:11.2px;line-height:1.45;
  overflow:hidden;
}
.page-content{position:absolute;left:62px;right:54px;top:52px;width:678px;}
.page-footer{position:absolute;bottom:26px;left:62px;right:34px;display:flex;justify-content:space-between;align-items:center;font-size:9.5px;color:#777;}
.blk{display:flow-root;}
.rpt-divider{border:none;border-top:1px solid #1b9ad6;margin:10px 0;}
.rpt-section-title{color:#1f6fb2;font-size:16.5px;font-weight:700;margin:18px 0 12px;}
.rpt-table{width:678px;border-collapse:collapse;table-layout:fixed;}
.rpt-table th{background:#00a0d2;color:#fff;font-size:10.5px;text-align:left;padding:6px 8px;font-weight:700;}
.rpt-table td{border:1px solid #d7dee3;padding:6px 8px;font-size:10.5px;vertical-align:top;}
.rpt-label-cell{background:#00a0d2;color:#fff;font-weight:700;width:132px;}
.header-block{display:flex;justify-content:space-between;align-items:flex-start;}
.header-left{display:flex;align-items:center;gap:10px;}
.header-left img.logo-img{height:62px;max-width:360px;object-fit:contain;}
.header-left .shield-name{display:flex;align-items:center;gap:10px;}
.header-left .company-name{font-size:17px;font-weight:700;color:#1f6fb2;}
.header-right{text-align:right;font-size:10.5px;color:#333;max-width:320px;}
.header-right a, .header-right .link{color:#1155cc;text-decoration:underline;}
.case-pill{display:inline-block;padding:3px 14px;border-radius:14px;color:#fff;font-size:11px;font-weight:700;vertical-align:middle;background:#f39c12;}
.case-num{font-weight:700;}
.status-cell b{display:block;}

/* ===== Profile Details / Results / Risk-O-Meter (exact spec) ===== */
.r-title{color:#1f6fb2;font-size:16.5px;margin:18px 0 12px;font-weight:400}
.hr{border-bottom:1px solid #1b9ad6}
.prof{display:flex;justify-content:space-between;align-items:flex-start;padding-bottom:18px}
.prof table{border-collapse:collapse}
.prof td{border:1px solid #e3e3e3;padding:8px;vertical-align:top;font-size:11.2px}
.prof td.l{background:#00a0d2;color:#fff;border-color:#fff;font-weight:400}
.prof .t1{width:290px}.prof .t1 td.l{width:132px}
.prof .t2{width:325px}.prof .t2 td.l{width:132px}
.prof .t2 td.v{white-space:pre-line}
.results{padding:0 0 12px}
.pill{display:inline-block;border-radius:9px;color:#fff;font-weight:700;font-size:10.5px;padding:1px 20px;margin-right:2px;vertical-align:middle}
.pill.orange{background:#f39c12}.pill.green{background:#2e7d32}
.res-txt{font-size:13px}
table.meter{width:100%;border-collapse:collapse;margin:14px 0 20px}
table.meter th{background:#00a0d2;color:#fff;font-weight:400;font-size:11px;padding:6px;border:1px solid #fff;text-align:center}
table.meter td{border:1px solid #e6e6e6;padding:9px 8px;font-size:10.5px;vertical-align:middle}
table.meter td.ind{font-weight:700;width:132px;position:relative}
table.meter tr.sel td.ind,table.meter tr.sel td.gd{border-top:1.5px solid #243a5e;border-bottom:1.5px solid #243a5e}
table.meter tr.sel td.gd{border-right:1.5px solid #243a5e}
table.meter tr.sel td.ind{border-left:1.5px solid #243a5e}
.arrow{position:absolute;left:-14px;top:50%;transform:translateY(-50%);width:0;height:0;border-top:7px solid transparent;border-bottom:7px solid transparent;border-left:10px solid #1b8fce}
.sig-area{width:190px;margin-left:auto;text-align:center;margin-top:26px;}
.sig-area img{max-height:92px;max-width:190px;}
.sig-box{border:1.5px dashed #9aa4af;border-radius:6px;height:70px;display:flex;align-items:center;justify-content:center;color:#8a929c;font-size:10.5px;}
.disclaimer{text-align:justify;font-size:10px;color:#333;margin-top:14px;}
.group-row td{background:#dfeef6;font-weight:700;color:#0d4d75;}
.grey-row td{background:#f2f2f2;}
</style>
</head>
